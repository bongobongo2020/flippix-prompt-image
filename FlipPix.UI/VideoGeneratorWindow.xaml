                                                        SmallChange="5" LargeChange="15"
                                                        Foreground="{DynamicResource TabAccentBrush}" Margin="0,0,0,4"
                                                        ToolTip="Length of the finished video, in 5-second steps up to 2 minutes. MiniMax H3 renders at most ~15s per pass, so anything longer is written as a chain of consecutive clips — Analyze writes them all in one reply, Add to Queue enqueues one job per clip against the same character sheets, and they are joined into a single file when the last one lands."/>
                                                <TextBlock Text="{Binding ClipPlanSummary}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                                                <!-- The medium the writer works in. Left on Auto it
                                                     picks, and it used to pick gacha anime almost every
                                                     time whatever the story was. -->
                                                <TextBlock Text="Visual style" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding VisualStyleOptions}"
                                                          DisplayMemberPath="Name"
                                                          SelectedItem="{Binding VisualStyle, Mode=TwoWay}"
                                                          Height="30" FontSize="11" Margin="0,0,0,4"
                                                          ToolTip="The medium every clip is written in. The style words open [Shot 1], which is the only place MiniMax H3 reads the look of the video from &#x2014; so the choice here is handed to the prompt writer as settled fact and copied verbatim into every clip of a chain, exactly the way the wardrobe is.&#x0a;&#x0a;Auto leaves it to the writer, which is what this tab did before: it reads the medium off the scene image where there is one and off the story where there is not."/>
                                                <TextBlock Text="{Binding VisualStyleSummary}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="🔍 Analyze → H3 Prompt"
                                                            Command="{Binding AnalyzeCommand}"
                                                            IsEnabled="{Binding CanAnalyze}"
                                                            Height="32" Padding="14,0" FontSize="11"
                                                            Style="{StaticResource AccentButtonStyle}"
                                                            ToolTip="Sends whatever is loaded — the scene image, the story, or both — to the llama-server with texttovideoH3.md and writes a dense multi-shot H3 prompt in which the cast is named only as &lt;Picture 1&gt; / &lt;Picture 2&gt; and framed so faces stay readable. The locked wardrobe above is handed to it as settled fact, so no clip picks its own outfit."/>
                                                    <TextBlock FontStyle="Italic" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"
                                                               Text="{Binding AnalyzeBusyText}" Foreground="{DynamicResource TabAccentBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAnalyzing}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Prompt -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="H3 PROMPT" Note="  · draft idea, or the full prompt"/>
                                                <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                                                         TextWrapping="Wrap" AcceptsReturn="True"
                                                         Height="240" VerticalScrollBarVisibility="Auto"
                                                         BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                         FontSize="11" Padding="8"/>

                                                <!-- Prompt library: every chain the writer finishes, and
                                                     every chain that reaches the queue, is filed
                                                     automatically; this row is how they come back out —
                                                     re-cast for whoever is loaded then. -->
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0"
                                                            Content="{Binding ChainLibraryLabel}"
                                                            Command="{Binding OpenChainLibraryCommand}"
                                                            Height="28" Padding="10,0" FontSize="11" Margin="0,0,6,0"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            ToolTip="Browse the story chains this tab has saved and put one back in the prompt box, with the story it was written from and the clip plan it was written against.&#x0a;&#x0a;Chains are stored as clip bodies with no cast preamble, so a story written for one cast can be rendered later with another: the reference line and the wardrobe block are written fresh from the characters loaded at the time. The saved take's own cast and wardrobe are NOT restored.&#x0a;&#x0a;Entries can be renamed, edited and deleted in the picker."/>
                                                    <Button Grid.Column="1" Content="&#x1F4BE; Save"
                                                            Command="{Binding SaveChainCommand}"
                                                            Height="28" Width="76" FontSize="11"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            ToolTip="File the chain in the prompt box now. Analyzed and queued chains are saved automatically — this is for one you have edited here and do not intend to queue yet."/>
                                                </Grid>

                                                <!-- What Add to Queue will actually enqueue: the chain is
                                                     split on its headers, so hand-edits here are honoured. -->
                                                <TextBlock Text="{Binding PromptClipSummary}"
                                                           Visibility="{Binding HasPromptSequence, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                           FontSize="10" FontWeight="SemiBold" Margin="0,6,0,0"
                                                           Foreground="{DynamicResource TabAccentBrush}" TextWrapping="Wrap"/>

                                                <TextBlock Text="The sheet reference line is rewritten automatically to match how many characters are loaded, which sex each of them is, and whether their sheets were built in the locked wardrobe — when they were, it tells H3 to copy the clothing out of the references rather than ignore it. The studio background is discarded either way."
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic" Margin="0,6,0,0"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Settings -->
                                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="14">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="SETTINGS" Margin="0,0,0,10"/>

                                                <TextBlock Text="Aspect ratio" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding AspectRatioOptions}"
                                                          SelectedItem="{Binding SelectedAspectRatio}"
                                                          Height="30" FontSize="11" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding ResolvedAspectRatio, StringFormat=→ {0}}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic" Margin="0,0,0,10"/>

                                                <TextBlock Text="Quality (canvas size)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding MegapixelOptions}"
                                                          DisplayMemberPath="Label"
                                                          SelectedValuePath="Value"
                                                          SelectedValue="{Binding Megapixels}"
                                                          Height="30" FontSize="11" Margin="0,0,0,8"/>

                                                <!-- The I2V graph scales references to the DRAFT canvas under
                                                     'match' — a quarter of the area picked. This is the lever
                                                     that stands in for the Cast tab's at-finished-canvas
                                                     panels: without it there is not enough face for identity
                                                     to survive against a competing reference. -->
                                                <CheckBox Content="Max-fidelity references (2048px)" IsChecked="{Binding MaxFidelityReferences}"
                                                          FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"
                                                          Foreground="{StaticResource TextPrimaryBrush}"
                                                          ToolTip="Encodes every cast panel at a 2048px short edge instead of scaling them to the sampled canvas.&#x0a;&#x0a;On this tab's pipeline the sampled canvas is the DRAFT — a quarter of the quality you picked — and the Cast tab's trick of holding its panels at the finished canvas does not exist in this graph. So this is on by default: holding a face is the whole point of a character sheet, and a 2048px reference is more face than even the finished canvas would carry.&#x0a;&#x0a;Reference tokens ride through every sampling step, so this is several times slower than 'match' — it buys identity fidelity, nothing else. Turn it off for speed when the cast is distinctive enough to survive."/>

                                                <CheckBox Content="Latent upscale (draft → 2× finish)" IsChecked="{Binding UseLatentUpscale}"
                                                          FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"
                                                          Foreground="{StaticResource TextPrimaryBrush}"
                                                          ToolTip="Renders each clip in three moves instead of one: four sampler steps at half the width and half the height to settle the composition, a 2× pass through the MiniMax H3 3D latent upscaler, then three fixed-sigma steps at the finished size to put the detail on. Only those last three ever see the full canvas, which is why this is both quicker and sharper than denoising the whole clip over eight steps. This is the MiniMax I2V tab's recipe, and the reason this tab exists.&#x0a;&#x0a;Needs the MinimaxH3LatentUpscaler3D node pack on the server. Unchecked, the clip falls back to exactly that — one 8-step sampling at the full size, no upscaler involved."/>

                                                <CheckBox Content="SLA block-sparse attention" IsChecked="{Binding UseSla}"
                                                          FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"
                                                          Foreground="{StaticResource TextPrimaryBrush}"
                                                          ToolTip="Block-sparse attention for MiniMax H3: each query block is scored against every key block with one pooled matmul, and only the top slice is actually attended. Nothing is loaded and nothing is trained — the sparsity is decided at runtime from q and k. Measured 1.4–1.6× on this pipeline.&#x0a;&#x0a;It patches this tab's one H3 pass, the base render. Attention cost grows with the square of frames × canvas area, so long or large clips gain most; anything under the kernel&apos;s minimum sequence length falls back to dense on its own, which is why a short clip at 0.4 MP may show no change at all.&#x0a;&#x0a;Needs the H3-SLA-Attention node pack on the server. Unchecked, the patch is disabled and the graph runs dense attention."/>
                                                <ComboBox ItemsSource="{Binding SlaSparsityOptions}"
                                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                                          SelectedValue="{Binding SlaSparsity}"
                                                          IsEnabled="{Binding UseSla}"
                                                          Height="28" FontSize="11" Margin="18,0,0,6"
                                                          ToolTip="Fraction of key blocks skipped. Break-even is around 0.60 — below that the kernel is SLOWER than dense attention, so a low value is a loss, not a safe fallback.&#x0a;&#x0a;0.85 is lightx2v&apos;s shipped value and what the turbo LoRA was distilled against. 0.90 is roughly 13% quicker, and measured hotter and flatter in the speech band — which matters here because every clip this tab renders carries a soundtrack."/>
                                                <CheckBox Content="Sol-Attn (legacy sparse attention)" IsChecked="{Binding UseSparseAttention}"
                                                          FontSize="11" Margin="0,0,0,10"
                                                          ToolTip="Sol-Attn — the same author&apos;s earlier, general-purpose sparse attention, which this workflow ships with wired in and off.&#x0a;&#x0a;SLA supersedes it for H3 and stacking the two has not measured faster than SLA alone, so leaving both on is two approximations bought for one speedup. Turn it on only to compare against SLA, or if the SLA pack is missing from the server."/>

                                                <CheckBox Content="RTX ×2 super-resolution" IsChecked="{Binding RtxUpscale}"
                                                          FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"
                                                          Foreground="{StaticResource TextPrimaryBrush}"
                                                          ToolTip="Doubles the frames on the way to the file — driver-side, not a sampling pass, so it costs seconds rather than a second render. It is also the graph's largest single allocation: the whole doubled clip is held in one piece at the very end of the run, which is what takes ComfyUI down on a long job.&#x0a;&#x0a;Off by default for that reason. The video is then muxed at the H3 canvas and can be upscaled afterwards in ✨ Enhance Video, where nothing else is holding memory. Worth turning on for a short clip; watch the frame-stack line below."/>
                                                <TextBlock Text="{Binding UpscaleSummary}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap" Margin="0,0,0,4"/>
                                                <!-- Turns red once the frame stack reaches the size that kills the server. -->
                                                <TextBlock Text="{Binding LoadSummary}"
                                                           FontSize="10" FontStyle="Italic"
                                                           TextWrapping="Wrap" Margin="0,0,0,10">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasLoadWarning}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <CheckBox Content="Audio enhancement on the saved clip" IsChecked="{Binding UseAudioEnhancement}"
                                                          FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10"
                                                          Foreground="{StaticResource TextPrimaryBrush}"
                                                          ToolTip="Runs the finished clip's soundtrack through the audio-enhancement pass (DSRE) on the way to the file: noise reduction, presence and stereo width. On by default — the same switch the 🌀 MiniMax I2V tab ships on. Costs seconds; it does not touch the render."/>

                                                <TextBlock Text="Clip length (seconds · 4–15)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <Slider Value="{Binding LengthSeconds}"
                                                        Minimum="4" Maximum="15"
                                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                                        Foreground="{DynamicResource TabAccentBrush}" Margin="0,0,0,2"
                                                        ToolTip="How long a single H3 pass is — the model's own limit. The Video length slider divides by this to decide how many clips the story is split into, and it is also what decides the peak frame stack above."/>
                                                <TextBlock Text="{Binding LengthSummary}"
                                                           FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,0,0,2"/>
                                                <TextBlock Text="{Binding ClipPlanSummary}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                                                <TextBlock Text="Seed (-1 = random)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0"
                                                             Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}"
                                                             Height="30" Padding="6,0" VerticalContentAlignment="Center"
                                                             BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                             FontSize="12" FontFamily="Consolas" Margin="0,0,6,0"/>
                                                    <Button Grid.Column="1" Content="🎲"
                                                            Command="{Binding RandomSeedCommand}"
                                                            Height="30" Width="36" FontSize="14"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- ═══ RIGHT PANEL ══════════════════════════════════════════════ -->
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="240"/>  <!-- Sheet strip -->
                                    <RowDefinition Height="3"/>    <!-- Progress bar -->
                                    <RowDefinition Height="Auto"/> <!-- Status row -->
                                    <RowDefinition Height="Auto"/> <!-- Action buttons -->
                                    <RowDefinition Height="Auto"/> <!-- Queue -->
                                    <RowDefinition Height="Auto"/> <!-- Result output -->
                                    <RowDefinition Height="Auto"/> <!-- Log -->
                                </Grid.RowDefinitions>

                                <!-- ─── Sheet strip: what H3 will actually see ───────────────── -->
                                <Border Grid.Row="0" Background="{StaticResource PlayerSurfaceBrush}">
                                    <Grid>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasCharacter1}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Border Width="64" Height="64" CornerRadius="14" Background="{StaticResource PlayerSurfaceRaisedBrush}"
                                                    BorderBrush="{StaticResource TextSecondaryBrush}" BorderThickness="1"
                                                    HorizontalAlignment="Center" Margin="0,0,0,10">
                                                <TextBlock Text="🪪" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="MiniMax H3 · Duo — sheets in, I2V turbo out" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PlayerTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="Photo per character → Build Sheets → scene image and/or story → Analyze → Generate"
                                                       FontSize="11" Foreground="{StaticResource PlayerTextBrush}" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <Grid Visibility="{Binding HasCharacter1, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              Margin="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Image Grid.Row="0" Grid.Column="0" Margin="0,0,6,0" Stretch="Uniform"
                                                   Source="{Binding Character1.SheetPreview}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Sheet 1 · &lt;Picture 1&gt;"
                                                       HorizontalAlignment="Center" Margin="0,6,0,0"
                                                       FontSize="10" Foreground="{StaticResource PlayerTextBrush}"/>

                                            <Image Grid.Row="0" Grid.Column="1" Margin="6,0" Stretch="Uniform"
                                                   Source="{Binding Character2.SheetPreview}"
                                                   Visibility="{Binding HasCharacter2, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Sheet 2 · &lt;Picture 2&gt;"
                                                       HorizontalAlignment="Center" Margin="0,6,0,0"
                                                       FontSize="10" Foreground="{StaticResource PlayerTextBrush}"
                                                       Visibility="{Binding HasCharacter2, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                            <Image Grid.Row="0" Grid.Column="2" Margin="6,0,0,0" Stretch="Uniform"
                                                   Source="{Binding SceneImagePreview}"
                                                   Visibility="{Binding HasSceneImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Scene · prompt only"
                                                       HorizontalAlignment="Center" Margin="0,6,0,0"
                                                       FontSize="10" Foreground="{StaticResource PlayerTextBrush}"
                                                       Visibility="{Binding HasSceneImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- ─── Progress bar ──────────────────────────────────────── -->
                                <ProgressBar Grid.Row="1"
                                             Value="{Binding ProcessingProgress, Mode=OneWay}"
                                             Foreground="{DynamicResource TabAccentBrush}" BorderThickness="0"
                                             Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <!-- ─── Status row ────────────────────────────────────────── -->
                                <Border Grid.Row="2" Style="{StaticResource ToolStripStyle}"
                                        BorderThickness="0,1,0,0" Padding="12,5">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,7,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource TextPrimaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource TabAccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding ProcessingStatus}"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Text="{Binding ProgressPercentage, Mode=OneWay}"
                                                   FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TabAccentBrush}"
                                                   FontFamily="Consolas"
                                                   Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>

                                <!-- ─── Action Buttons ────────────────────────────────────── -->
                                <Border Grid.Row="3" Style="{StaticResource ToolStripStyle}"
                                        BorderThickness="0,1,0,0" Padding="10,8">
                                    <StackPanel>
                                      <!-- Why Add to Queue is on or off, on a line of its own: the status row above
                                           belongs to whatever is rendering, so during a queue run it cannot say this —
                                           which is exactly when it needs saying. -->
                                      <TextBlock Text="{Binding QueueReadiness}" Margin="2,0,2,6"
                                                 FontSize="10" TextWrapping="Wrap"
                                                 Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Margin="0,0,8,0" Height="40"
                                                Command="{Binding GenerateCommand}"
                                                IsEnabled="{Binding CanGenerate}"
                                                Style="{StaticResource AccentOutlineButtonStyle}"
                                                FontSize="12" FontWeight="Bold"
                                                ToolTip="Snapshots the sheets, the prompt and the settings into the queue. Nothing renders until ▶ Generate is pressed. The render itself is the MiniMax I2V turbo pipeline. The sheets are already built, so nothing here waits on the GPU — load the next scene image and Analyze it while this one runs.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚡ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Add to Queue" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="1" Height="40" Width="118" Margin="0,0,8,0"
                                                Command="{Binding StartQueueCommand}"
                                                Style="{StaticResource AccentButtonStyle}"
                                                FontSize="12" FontWeight="Bold"
                                                ToolTip="Starts rendering everything pending in the queue. Add to Queue only stages a job — nothing reaches the GPU until this is pressed, so several prompts can be queued and then rendered in one run. Greyed out while the queue is already running, and when nothing is pending.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="▶ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Generate" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="2" Height="40" Width="82"
                                                Command="{Binding CancelCommand}"
                                                Style="{StaticResource DangerButtonStyle}"
                                                FontSize="11"
                                                ToolTip="Stops whatever is on the GPU — the sheet builder or the queue. Pending items stay queued.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✕ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- ─── Queue ─────────────────────────────────────────────── -->
                                <Border Grid.Row="4" Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8"
                                        Visibility="{Binding HasQueueItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="🪪 Duo Queue"
                                                       FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TabAccentBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding QueueStatus}"
                                                       FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="2" Content="▶ Generate"
                                                    Command="{Binding StartQueueCommand}"
                                                    Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    ToolTip="Starts rendering the pending items — the same command as the ▶ Generate button above."/>
                                            <Button Grid.Column="3" Content="🔄 Retry"
                                                    Command="{Binding ReprocessAllFailedCommand}"
                                                    Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    ToolTip="Put every failed item back to Pending and run them again."/>
                                            <Button Grid.Column="4" Content="⏹ Stop"
                                                    Command="{Binding StopQueueCommand}"
                                                    Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                                    Style="{StaticResource AccentButtonStyle}"/>
                                            <Button Grid.Column="5" Content="🗑️ Clear"
                                                    Command="{Binding ClearQueueCommand}"
                                                    Height="26" Padding="8,0" FontSize="11"
                                                    Style="{StaticResource AccentButtonStyle}"/>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Queue}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                                            Padding="8,5" Margin="0,0,0,3" Background="White">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" CornerRadius="3" Padding="6,2" Margin="0,0,8,0"
                                                                    VerticalAlignment="Center"
                                                                    Background="{Binding StatusColor}">
                                                                <TextBlock Text="{Binding StatusDisplay}" FontSize="10"
                                                                           FontWeight="SemiBold" Foreground="White"/>
                                                            </Border>
                                                            <Image Grid.Column="1" Source="{Binding QueueThumbnail}"
                                                                   Height="34" Stretch="Uniform" Margin="0,0,8,0"/>
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold" FontSize="11"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Prompt}" FontSize="10"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding ErrorMessage}" FontSize="10"
                                                                           Foreground="{StaticResource DangerBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="3" Content="✕"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Command="{Binding DataContext.RemoveQueueItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    VerticalAlignment="Center"
                                                                    Width="26" Height="26" Padding="0" FontSize="10"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- ─── Result Output ──────────────────────────────────────── -->
                                <Border Grid.Row="5" Background="White" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,1,0,0" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="🎥 Result Video" FontWeight="Bold" FontSize="13"
                                                   Foreground="{DynamicResource TabAccentBrush}" Margin="0,0,0,8"/>

                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource PlayerSurfaceBrush}"
                                                Height="200" CornerRadius="6" Margin="0,0,0,8">
                                            <Grid>
                                                <TextBlock Text="Video will appear here after generation"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{StaticResource PlayerTextBrush}" FontStyle="Italic">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasResult}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <MediaElement x:Name="H3ExperimentalVideoPlayer"
                                                              Source="{Binding ResultVideoPath}"
                                                              LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                              Stretch="Uniform"
                                                              Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Button Content="▶ Play" Style="{StaticResource PrimaryButtonStyle}"
                                                    Command="{Binding PlayVideoCommand}"
                                                    IsEnabled="{Binding HasResult}" Margin="0,0,8,0"/>
                                            <Button Content="📁 Open Folder" Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding OpenResultFolderCommand}"
                                                    IsEnabled="{Binding HasResult}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ResultVideoInfo}"
                                                   FontStyle="Italic" Foreground="#666" FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <!-- ─── Log ───────────────────────────────────────────────── -->
                                <ctrl:ProcessingLogPanel Grid.Row="6" LogText="{Binding LogOutput}" MaxLogHeight="130"/>

                            </Grid>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

<!-- ═══════════════════════════════════════════════════════════════════════
                         H3 MULTI — the H3 Ensemble machinery on the
                         MiniMax I2V turbo pipeline. Everything the
                         🎬🎭 H3 Ensemble tab does — five cast slots,
                         wardrobe lock, the location as prompt input AND
                         reference, chained clip prompts that cast only
                         the characters each beat names, the storyboard,
                         the queue and the FFmpeg join — but each clip
                         renders through the graph the 🪪🌀 H3 Duo tab
                         runs: a 4-step draft at a quarter of the canvas,
                         a 2× pass through the MiniMax H3 3D latent
                         upscaler, then 3 fixed-sigma steps at the
                         finished size.

                         Quicker and sharper than the Ensemble tab’s own
                         hybrid graph; the trade is there is no
                         face-refine pass and no FILM interpolation here —
                         identity is held by the references themselves,
                         encoded at a 2048px short edge by default (the
                         checkbox in Settings).
                         ═══════════════════════════════════════════════════════════════════════ -->
                    <TabItem Header="🪪🎬 H3 Multi">
                        <!-- Named so the per-character cards, whose DataContext is a CharacterSlot, can
                             still reach the tab's own commands. -->
                        <Grid x:Name="H3MultiRoot" DataContext="{Binding H3MultiVM}" Style="{StaticResource TabPageStyle}">
                            <Grid.Resources>
                                <SolidColorBrush x:Key="TabAccentBrush" Color="{StaticResource AccentVioletColor}"/>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ═══ LEFT PANEL ═══════════════════════════════════════════════ -->
                            <Border Grid.Column="0" Style="{StaticResource TabSideRailStyle}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="12">

                                        <!-- ─── Location & story ──────────────────────────────
                                             The location does two jobs: the llama-server reads
                                             the setting off it, and (ticked) it is also the last
                                             reference picture the generator receives. -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="LOCATION &amp; STORY" Note="  · either one is enough — and the wardrobe comes from it" Margin="0,0,0,10"/>

                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="134"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Location image" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                                                Background="{StaticResource SurfaceAltBrush}" Height="126" Margin="0,0,0,6">
                                                            <Grid>
                                                                <TextBlock Text="Optional"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextMutedBrush}" FontSize="10">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding EnvironmentPreview}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <Image Source="{Binding EnvironmentPreview}" Stretch="Uniform"/>
                                                            </Grid>
                                                        </Border>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button Grid.Column="0" Content="Browse…"
                                                                    Command="{Binding SelectEnvironmentCommand}"
                                                                    Height="26" Padding="6,0" FontSize="11" Margin="0,0,4,0"
                                                                    Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                                    ToolTip="A photograph of the place the story happens — the set, not a shot. The llama-server reads the setting, lighting, art style and wardrobe off it, and with the box below ticked the generator is shown it too.&#x0a;&#x0a;Anybody visible in it is scenery. The prompt says so in three places, because a location photograph with people in it is otherwise an invitation to cast them."/>
                                                            <Button Grid.Column="1" Content="✕"
                                                                    Command="{Binding ClearEnvironmentCommand}"
                                                                    IsEnabled="{Binding HasEnvironment}"
                                                                    Height="26" Width="26" FontSize="11"
                                                                    Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding EnvironmentInfo}" FontSize="9" Margin="0,4,0,0"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Story" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                        <TextBox Text="{Binding StoryText, UpdateSourceTrigger=PropertyChanged}"
                                                                 TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="False"
                                                                 Height="126" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6"
                                                                 BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                                 FontSize="11" Padding="6"
                                                                 ToolTip="What happens, and who it happens to. Name your characters however you like — the analysis casts the loaded subjects into those roles, using the Part field on each card to decide who is who."/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button Grid.Column="0" Content="📄 Load .txt"
                                                                    Command="{Binding LoadStoryCommand}"
                                                                    Height="26" Padding="6,0" FontSize="11" Margin="0,0,4,0"
                                                                    Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                            <Button Grid.Column="1" Content="✕"
                                                                    Command="{Binding ClearStoryCommand}"
                                                                    Height="26" Width="26" FontSize="11"
                                                                    Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>

                                                <CheckBox Content="Also send the location to the generator (costs 1 reference slot)"
                                                          IsChecked="{Binding WireEnvironment}"
                                                          IsEnabled="{Binding HasEnvironment}"
                                                          FontSize="10" Margin="0,0,0,4"
                                                          Foreground="{StaticResource TextSecondaryBrush}"
                                                          ToolTip="Ticked, the location photograph is uploaded and wired as the LAST reference picture, so H3 is shown the place rather than only told about it — the strongest way to keep a long chain in one room.&#x0a;&#x0a;Unticked, it stays what the 🪪👥⚡ Hybrid tab's scene image is: read by the language model, never uploaded. That buys back a slot for another character's panel."/>
                                                <TextBlock Text="{Binding EnvironmentSummary}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                                                <TextBlock Text="{Binding StorySourceSummary}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                                                <!-- Wardrobe. Decided once for the whole cast and written into
                                                     every clip's prompt verbatim — each clip keeps only the
                                                     lines for the characters it casts. -->
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Wardrobe — one line per character"
                                                               FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <Button Grid.Column="1" Content="{Binding WardrobeLockButtonText}"
                                                            Command="{Binding ToggleWardrobeLockCommand}"
                                                            Height="24" Padding="8,0" FontSize="10" Margin="0,0,4,0"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            ToolTip="Locked, the wardrobe is the story's: it is rewritten whenever the story, the location or the cast changes, and cannot be typed over. Characters added later are topped up without re-rolling anybody already dressed.&#x0a;&#x0a;Unlock to dress the cast yourself — your text then stands. Press ✎ Re-stamp afterwards to write it into the prompt already in the box."/>
                                                    <Button Grid.Column="2" Content="🎽 Derive"
                                                            Command="{Binding DeriveWardrobeCommand}"
                                                            Height="24" Padding="8,0" FontSize="10" Margin="0,0,4,0"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            ToolTip="Re-rolls the outfits now — off the location image if there is one, otherwise out of the story. With three or more characters it is told to give them silhouettes and colours that tell apart at a glance. The sheets are built from whatever is in this box, so derive before you build them."/>
                                                    <Button Grid.Column="3" Content="✕"
                                                            Command="{Binding ClearWardrobeCommand}"
                                                            Height="24" Width="24" FontSize="10"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                </Grid>
                                                <TextBox Text="{Binding CastWardrobe, UpdateSourceTrigger=PropertyChanged}"
                                                         IsReadOnly="{Binding IsWardrobeLocked}"
                                                         TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="False"
                                                         Height="82" VerticalScrollBarVisibility="Auto" Margin="0,0,0,4"
                                                         BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                         FontSize="11" Padding="6"
                                                         ToolTip="One line per character, naming every garment. It is what the character sheets are generated in AND what every clip's prompt quotes — picture and words then agree, which is what stops the cast changing outfits between clips.&#x0a;&#x0a;Read-only while locked; press 🔒 to take it over."/>
                                                <TextBlock Text="{Binding WardrobeSummary}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                                                <!-- Total video length. Each clip is one H3 pass, and each
                                                     casts only the characters its own beat needs. -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Video length" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            CornerRadius="4" Padding="10,2">
                                                        <TextBlock Text="{Binding StoryDurationSeconds, StringFormat={}{0:0} s}"
                                                                   FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TabAccentBrush}"/>
                                                    </Border>
                                                </Grid>
                                                <Slider Value="{Binding StoryDurationSeconds}"
                                                        Minimum="5" Maximum="180"
                                                        TickFrequency="5" IsSnapToTickEnabled="True"
                                                        SmallChange="5" LargeChange="15"
                                                        Foreground="{DynamicResource TabAccentBrush}" Margin="0,0,0,4"
                                                        ToolTip="Length of the finished video. MiniMax H3 renders at most ~15s per pass, so anything longer is written as a chain of consecutive clips — each casting only the characters its own beat needs."/>
                                                <TextBlock Text="{Binding ClipPlanSummary}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- ─── Cast: five interchangeable slots ─────────────── -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="CAST" Note="  · up to 5 — fill any of them, leave the rest empty" Margin="0,0,0,10"/>

                                                <ItemsControl ItemsSource="{Binding Cast}" Margin="0,0,0,4">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                                    CornerRadius="6" Padding="8" Margin="0,0,0,8"
                                                                    Background="{StaticResource SurfaceAltBrush}">
                                                                <StackPanel>
                                                                    <Grid Margin="0,0,0,4">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" FontSize="11" FontWeight="Bold"
                                                                                   VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Text="{Binding Label}"
                                                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                        <ComboBox Grid.Column="1" ItemsSource="{Binding KindOptions}"
                                                                                  SelectedItem="{Binding Kind, Mode=TwoWay}"
                                                                                  Width="152" Height="24" FontSize="10"
                                                                                  ToolTip="What this character IS — and not everything in a story is a person.&#x0a;&#x0a;Male / Female / Boy / Girl are people: the wardrobe pass dresses them, the sheet is built as a front view, a back view and a face close-up, the prompt uses he or she, and the face-refine pass tracks and re-generates their face.&#x0a;&#x0a;Creature, Character (not a person) and Group are not. A cloud, a mountain, a herd of goats — for these the sheet is built as three views of the thing rather than of a person, the designer describes its form, colours and materials instead of an outfit, the prompt says in as many words that it must never be given a human face or turned into someone in a costume, its pronoun is taken from your story, and face refine is skipped: that pass tracks human faces, so aimed at a mountain it either finds nothing or finds somebody else and redraws them.&#x0a;&#x0a;For those three, fill in Part below — it is the only place anything knows this slot is a cloud and not a mountain."/>
                                                                    </Grid>

                                                                    <Grid Margin="0,0,0,6">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="Part" FontSize="10" VerticalAlignment="Center"
                                                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                                                                        <TextBox Grid.Column="1"
                                                                                 Text="{Binding Role, UpdateSourceTrigger=LostFocus}"
                                                                                 Height="24" FontSize="10" Padding="5,0"
                                                                                 VerticalContentAlignment="Center"
                                                                                 BorderBrush="{StaticResource BorderBrush}" Background="White"
                                                                                 ToolTip="Who or what this character is in the story — &quot;the detective&quot;, &quot;her younger brother&quot;, &quot;Nimbus, a fluffy little cloud&quot;.&#x0a;&#x0a;For a person it is optional, but with more than two of them it is the one thing that stops the model casting them by order of appearance and then losing track. It also reaches the costume supervisor, which is what makes a chauffeur dress differently from a guest.&#x0a;&#x0a;For a Creature, Character or Group it is NOT optional: it is the description. Nothing else in the app knows that this slot is a cloud rather than a mountain, and with it empty the prompt can only call it &quot;a character that is not a person&quot;.&#x0a;&#x0a;It is never written into the video as identity — the reference sheet carries that."/>
                                                                    </Grid>

                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="96"/>
                                                                            <ColumnDefinition Width="6"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                                                CornerRadius="6" Background="White" Height="80"
                                                                                Style="{StaticResource CastThumbnailStyle}" Tag="{Binding SourcePath}">
                                                                            <Grid>
                                                                                <TextBlock Text="Photo"
                                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                           Foreground="{StaticResource TextMutedBrush}" FontSize="10">
                                                                                    <TextBlock.Style>
                                                                                        <Style TargetType="TextBlock">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding SourcePreview}" Value="{x:Null}">
                                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </TextBlock.Style>
                                                                                </TextBlock>
                                                                                <Image Source="{Binding SourcePreview}" Stretch="Uniform"/>
                                                                            </Grid>
                                                                        </Border>

                                                                        <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                                                CornerRadius="6" Background="White" Height="80"
                                                                                Style="{StaticResource CastThumbnailStyle}" Tag="{Binding SheetPath}">
                                                                            <Grid>
                                                                                <TextBlock Text="Sheet → H3"
                                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                           Foreground="{StaticResource TextMutedBrush}" FontSize="10">
                                                                                    <TextBlock.Style>
                                                                                        <Style TargetType="TextBlock">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding SheetPreview}" Value="{x:Null}">
                                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </TextBlock.Style>
                                                                                </TextBlock>
                                                                                <Image Source="{Binding SheetPreview}" Stretch="Uniform"/>
                                                                            </Grid>
                                                                        </Border>
                                                                    </Grid>

                                                                    <Grid Margin="0,6,0,0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Button Grid.Column="0" Content="Browse…"
                                                                                Command="{Binding DataContext.SelectCharacterCommand, ElementName=H3MultiRoot}"
                                                                                CommandParameter="{Binding}"
                                                                                Height="26" Padding="8,0" FontSize="11" Margin="0,0,4,0"
                                                                                Background="White" Foreground="{DynamicResource TabAccentBrush}"
                                                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                                        <Button Grid.Column="1" Content="✕"
                                                                                Command="{Binding DataContext.ClearCharacterCommand, ElementName=H3MultiRoot}"
                                                                                CommandParameter="{Binding}"
                                                                                IsEnabled="{Binding HasSource}"
                                                                                Height="26" Width="26" FontSize="11"
                                                                                Background="White" Foreground="{StaticResource TextSecondaryBrush}"
                                                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                                                ToolTip="Takes this character out of the film — photo, sheet and part."/>
                                                                    </Grid>

                                                                    <!-- ✨ Generate — the character's photo, rendered by one of the Image
                                                                         Generator's base workflows instead of browsed for. The dropdown picks
                                                                         the engine; see H3EnsembleViewModel.Cast.cs. -->
                                                                    <Button x:Name="CastPhotoGenerateButton" Content="✨ Generate photo ▾" Margin="0,4,0,0"
                                                                            Click="CastGenerateButton_Click"
                                                                            Tag="{Binding DataContext, ElementName=H3MultiRoot}"
                                                                            IsEnabled="{Binding CanGeneratePhoto}"
                                                                            Height="26" Padding="8,0" FontSize="11"
                                                                            Background="White" Foreground="{DynamicResource TabAccentBrush}"
                                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                                            ToolTip="Generates this character's photo instead of browsing for one — their Part and the locked wardrobe become the prompt, and the result lands in this card as if it had been browsed. Z-Image, Z-Famegrid and Krea2 open into a LoRA list (the same folders the Image Generator reads); Krea2-Spicy's and Qwen 2.5.1.2's LoRAs are baked into their workflows.&#x0a;&#x0a;Needs the character to be described first: a Part on the card, a non-person Kind, or the story's automatic cast. The character sheet is not built until you press 🪪 Build Character Sheet, so you can re-generate or swap photos first.">
                                                                        <!-- Tag carries the tab's ViewModel across the ContextMenu boundary;
                                                                             the card's DataContext is the CharacterSlot each command takes. -->
                                                                        <Button.ContextMenu>
                                                                            <!-- Z-Image, Z-Famegrid and Krea2 open into a LoRA list — the same folders the Image
                                                                                 Generator tab reads. Krea2-Spicy's and Qwen's LoRAs are baked into their workflows,
                                                                                 so they have no list. The menu remembers whose card it opened on: the
                                                                                 window sets CastPhotoMenuSlot as it opens. -->
                                                                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                                                                                         Opened="CastPhotoMenu_Opened">
                                                                                <MenuItem Header="Z-Image ▸ pick the LoRA" ItemsSource="{Binding CastZimageLoraMenu}">
                                                                                    <MenuItem.ItemContainerStyle>
                                                                                        <Style TargetType="MenuItem">
                                                                                            <Setter Property="Header" Value="{Binding Name}"/>
                                                                                            <Setter Property="Command"
                                                                                                    Value="{Binding DataContext.GenerateCastZimageLoraCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                                                            <Setter Property="CommandParameter" Value="{Binding}"/>
                                                                                        </Style>
                                                                                    </MenuItem.ItemContainerStyle>
                                                                                </MenuItem>
                                                                                <MenuItem Header="Z-Famegrid ▸ pick the LoRA" ItemsSource="{Binding CastFamegridLoraMenu}">
                                                                                    <MenuItem.ItemContainerStyle>
                                                                                        <Style TargetType="MenuItem">
                                                                                            <Setter Property="Header" Value="{Binding Name}"/>
                                                                                            <Setter Property="Command"
                                                                                                    Value="{Binding DataContext.GenerateCastFamegridLoraCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                                                            <Setter Property="CommandParameter" Value="{Binding}"/>
                                                                                        </Style>
                                                                                    </MenuItem.ItemContainerStyle>
                                                                                </MenuItem>
                                                                                <MenuItem Header="Krea2 ▸ pick the LoRA" ItemsSource="{Binding CastKrea2LoraMenu}">
                                                                                    <MenuItem.ItemContainerStyle>
                                                                                        <Style TargetType="MenuItem">
                                                                                            <Setter Property="Header" Value="{Binding Name}"/>
                                                                                            <Setter Property="Command"
                                                                                                    Value="{Binding DataContext.GenerateCastKrea2LoraCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                                                            <Setter Property="CommandParameter" Value="{Binding}"/>
                                                                                        </Style>
                                                                                    </MenuItem.ItemContainerStyle>
                                                                                </MenuItem>
                                                                                <MenuItem Header="Krea2-Spicy — spicy mirror-selfie look"
                                                                                          Command="{Binding GenerateCastKrea2SpicyCommand}"
                                                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                                                <MenuItem Header="Qwen 2.5.1.2 — detailed illustration"
                                                                                          Command="{Binding GenerateCastQwenCommand}"
                                                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                                            </ContextMenu>
                                                                        </Button.ContextMenu>
                                                                    </Button>
                                                                    <TextBlock Text="{Binding PhotoPhase}" FontSize="9" Margin="0,3,0,0"
                                                                               Foreground="{DynamicResource TabAccentBrush}" FontStyle="Italic"
                                                                               TextTrimming="CharacterEllipsis"/>

                                                                    <CheckBox Content="This image is already a character sheet"
                                                                              IsChecked="{Binding UseSourceAsSheet}"
                                                                              IsEnabled="{Binding HasSource}"
                                                                              FontSize="10" Margin="0,6,0,0"
                                                                              Foreground="{StaticResource TextSecondaryBrush}"
                                                                              ToolTip="Skip the Qwen pass and send the loaded image to H3 as it is."/>

                                                                    <Grid Margin="0,6,0,0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="Panels" FontSize="10" VerticalAlignment="Center"
                                                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                                                                        <ComboBox Grid.Column="1" ItemsSource="{Binding PanelSplitOptions}"
                                                                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                                                                  SelectedValue="{Binding SelectedPanelSplit, Mode=TwoWay}"
                                                                                  IsEnabled="{Binding HasSheet}" Height="24" FontSize="10"
                                                                                  ToolTip="H3 conditions on each reference image as ONE subject, so a three-panel sheet handed over whole is a three-panel grid it will happily render into the video. The sheet is therefore cut back into its separate views before it is sent, one reference per view.&#x0a;&#x0a;How many of those views are actually sent is the References setting below."/>
                                                                    </Grid>
                                                                    <TextBlock Text="{Binding SheetStatus}" FontSize="9" Margin="0,4,0,0"
                                                                               Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding PanelStatus}" FontSize="9" Margin="0,2,0,0"
                                                                               Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                                               TextWrapping="Wrap"/>
                                                                    <TextBlock Text="{Binding ExpectedWardrobe, StringFormat=👗 {0}}"
                                                                               Visibility="{Binding ExpectedWardrobe, Converter={StaticResource StringToVisibilityConverter}}"
                                                                               FontSize="9" Margin="0,2,0,0"
                                                                               Foreground="{DynamicResource TabAccentBrush}" FontStyle="Italic"
                                                                               TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Button Content="{Binding BuildSheetsButtonText}"
                                                        Command="{Binding BuildSheetsCommand}"
                                                        IsEnabled="{Binding CanBuildSheets}"
                                                        Height="32" FontSize="11" Margin="0,0,0,6"
                                                        Style="{StaticResource AccentButtonStyle}"
                                                        ToolTip="Runs Qwen-Image-Edit-2511 once per loaded character and turns each photo into a three-panel reference sheet on a plain studio background: full-body front, full-body back, face close-up — wearing that character's locked wardrobe.&#x0a;&#x0a;Safe to press while a video is rendering: it waits for the GPU and starts as soon as that job lets go."/>

                                                <TextBlock Text="{Binding SheetPhase}"
                                                           Visibility="{Binding IsBuildingSheets, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                           FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"
                                                           Foreground="{DynamicResource TabAccentBrush}"
                                                           TextWrapping="Wrap"/>

                                                <!-- The medium the writer works in. Left on Auto it picks, and it
                                                     used to pick gacha anime almost every time whatever the story was. -->
                                                <TextBlock Text="Visual style" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding VisualStyleOptions}"
                                                          DisplayMemberPath="Name"
                                                          SelectedItem="{Binding VisualStyle, Mode=TwoWay}"
                                                          Height="30" FontSize="11" Margin="0,0,0,4"
                                                          ToolTip="The medium every clip is written in. The style words open [Shot 1], which is the only place MiniMax H3 reads the look of the video from &#x2014; so the choice here is handed to the prompt writer as settled fact and copied verbatim into every clip of a chain, exactly the way the wardrobe is.&#x0a;&#x0a;Auto leaves it to the writer, which is what this tab did before: it reads the medium off the location image where there is one and off the story where there is not.&#x0a;&#x0a;Keyframe stills outrank the style at their own timestamps &#x2014; a frame lock reproduces the picture you supplied whatever this says."/>
                                                <TextBlock Text="{Binding VisualStyleSummary}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                                                <!-- Analyze runs on the llama-server: one turn, no progress of its own, and minutes
                                                     of it for a chain. The bar and the clock below are the only sign it is alive. -->
                                                <StackPanel Margin="0,0,0,6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="{Binding AnalyzeButtonText}"
                                                                Command="{Binding AnalyzeCommand}"
                                                                IsEnabled="{Binding CanAnalyze}"
                                                                Height="32" Padding="14,0" FontSize="11" Margin="0,0,6,0"
                                                                Style="{StaticResource AccentButtonStyle}"
                                                                ToolTip="Asks the llama-server for the four sections it is good at — summary, the shot list, the soundscape and the score — telling it which subjects exist, what part each plays, and that a clip should name only the two or three characters really in it. The other two sections, the alignment paragraph and the global negatives are written here in code from the reference list itself, so they cannot drift."/>
                                                        <Button Content="✎ Re-stamp"
                                                                Command="{Binding RestampCommand}"
                                                                Height="32" Padding="10,0" FontSize="11"
                                                                Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                                ToolTip="Rebuilds the code-written half of the prompt already in the box against the cast, keyframes, location and wardrobe as they stand now — no llama-server round trip. Press it after adding a character, changing a part, editing the wardrobe or switching the reference budget."/>
                                                    </StackPanel>

                                                    <StackPanel Margin="0,6,0,0"
                                                                Visibility="{Binding IsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <ProgressBar IsIndeterminate="True" Height="6" Margin="0,0,0,3"
                                                                     Background="{StaticResource SurfaceAltBrush}"
                                                                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                                     Foreground="{DynamicResource TabAccentBrush}"/>
                                                        <TextBlock Text="{Binding AnalyzeBusyText}"
                                                                   FontSize="10" FontStyle="Italic" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TabAccentBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <TextBlock Text="{Binding CastSummary}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap"/>

                                                <!-- How much of each sheet H3 is given. With five characters
                                                     this stops being a preference and becomes arithmetic. -->
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="References" FontSize="10" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ReferenceBudgetOptions}"
                                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                                              SelectedValue="{Binding ReferenceBudget, Mode=TwoWay}"
                                                              Height="24" FontSize="10"
                                                              ToolTip="How many of each character's sheet panels are handed to H3.&#x0a;&#x0a;All references share ONE nine-slot input and each is encoded at the generation's full pixel area. Five characters at three panels each is fifteen pictures, so this is arithmetic rather than taste.&#x0a;&#x0a;Auto divides what is left after the location and the clip's opening keyframe between however many characters are loaded — two characters get three panels each, five get one. The one it keeps is the face close-up, because a full-body back view costs exactly as much as the face while carrying almost none of the likeness.&#x0a;&#x0a;Only a three-panel sheet built here can be trimmed — any other split is sent whole."/>
                                                </Grid>
                                                <TextBlock Text="{Binding ReferenceBudgetSummary}"
                                                           FontSize="9" Margin="0,2,0,0"
                                                           Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap"/>

                                                <!-- The whole picture plan: which numbers are locks, which are
                                                     the cast, and which is the set. -->
                                                <TextBlock Text="{Binding PicturePlanSummary}"
                                                           FontSize="10" Margin="0,6,0,0"
                                                           Foreground="{DynamicResource TabAccentBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Prompt -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="H3 MULTI PROMPT" Note="  · six sections; four of them written here"/>
                                                <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                                                         TextWrapping="Wrap" AcceptsReturn="True"
                                                         Height="240" VerticalScrollBarVisibility="Auto"
                                                         BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                         FontSize="11" Padding="8"/>

                                                <TextBlock Text="{Binding PromptClipSummary}"
                                                           Visibility="{Binding HasPromptSequence, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                           FontSize="10" FontWeight="SemiBold" Margin="0,6,0,0"
                                                           Foreground="{DynamicResource TabAccentBrush}" TextWrapping="Wrap"/>

                                                <!-- Who the chain actually casts, per character. A character
                                                     no clip names is a sheet built for nothing, and that is
                                                     invisible in the box above. -->
                                                <TextBlock Text="{Binding CastCoverageSummary}"
                                                           FontSize="10" Margin="0,6,0,0" FontStyle="Italic"
                                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>

                                                <!-- Turns red when the prompt's picture numbers no longer match
                                                     the keyframe list. -->
                                                <TextBlock Text="{Binding PromptHealthSummary}"
                                                           FontSize="10" FontWeight="SemiBold" Margin="0,6,0,0"
                                                           Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>

                                                <TextBlock Text="subject_definitions, retention_analysis, the alignment paragraph and the global negatives are rebuilt from the reference list every time this prompt is stamped — edit them here and ✎ Re-stamp (or Add to Queue) will overwrite them. The summary paragraph, the shot list, the soundscape and the score are yours and survive."
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic" Margin="0,6,0,0"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- ─── Storyboard: H3 renders each clip's opening frame first ─── -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="STORYBOARD" Note="  · the opening frame of every clip, rendered before the clips are" Margin="0,0,0,10"/>

                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Preview length" FontSize="10" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding StoryboardFrameOptions}"
                                                              DisplayMemberPath="Label" SelectedValuePath="Frames"
                                                              SelectedValue="{Binding StoryboardFrames, Mode=TwoWay}"
                                                              Height="24" FontSize="10"
                                                              ToolTip="How many frames each preview render asks H3 for. Only the frame you pick is kept — the rest exist because H3 is a video model and a lone frame is not what it was trained to make.&#x0a;&#x0a;The node's own tooltip puts the trained range at 124–362 frames, so a short preview is out of distribution and can come back softer than the clip it stands for. It is also what makes this cheap: a shot costs roughly frames ÷ 124 of the clip it previews, with face refine, interpolation, RTX and the audio branch all pruned out.&#x0a;&#x0a;The canvas is NOT reduced — the still is about to be frame 0 of a render at exactly this size."/>
                                                </Grid>

                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="{Binding PreviewKeyframesButtonText}"
                                                            Command="{Binding PreviewKeyframesCommand}"
                                                            IsEnabled="{Binding CanPreviewKeyframes}"
                                                            Height="32" Padding="14,0" FontSize="11" Margin="0,0,6,0"
                                                            Style="{StaticResource AccentButtonStyle}"
                                                            ToolTip="Renders one still per clip in the prompt box, on this graph, this canvas and that clip's own cast, from its own prompt with the picture locks dropped — then shows them before anything is queued.&#x0a;&#x0a;On an ensemble it is also the cheapest way to see WHICH PEOPLE H3 has actually put in a beat, before spending twenty minutes finding out.&#x0a;&#x0a;Tick a still and it becomes that clip's opening frame at 0.00s: &lt;Picture 1&gt;, fully preserved, with the cast pushed to &lt;Picture 2&gt; onwards. Untick it and the clip renders as a reference-driven take with no lock.&#x0a;&#x0a;Nothing is enqueued by this. It runs on the same GPU lease as everything else, so pressing it mid-render simply waits."/>
                                                    <Button Content="🗑 Clear"
                                                            Command="{Binding ClearStoryboardCommand}"
                                                            Height="32" Padding="10,0" FontSize="11"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            ToolTip="Throws every storyboard still away and re-stamps the prompt without them. The files stay on disk in the storyboard folder."/>
                                                </StackPanel>

                                                <StackPanel Margin="0,6,0,0"
                                                            Visibility="{Binding IsStoryboarding, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <ProgressBar IsIndeterminate="True" Height="6" Margin="0,0,0,3"
                                                                 Background="{StaticResource SurfaceAltBrush}"
                                                                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                                 Foreground="{DynamicResource TabAccentBrush}"/>
                                                </StackPanel>

                                                <TextBlock Text="{Binding StoryboardPhase}"
                                                           FontSize="10" FontWeight="SemiBold" Margin="0,4,0,0"
                                                           Foreground="{DynamicResource TabAccentBrush}" TextWrapping="Wrap"/>

                                                <TextBlock Text="{Binding StoryboardSummary}"
                                                           FontSize="10" Margin="0,6,0,0" FontStyle="Italic"
                                                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- ─── Keyframes: hand-placed timeline locks, clip 1 only ─── -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="KEYFRAMES" Note="  · optional · stills clip 1 must land on exactly" Margin="0,0,0,10"/>

                                                <ItemsControl ItemsSource="{Binding Keyframes}" Margin="0,0,0,8">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                                    CornerRadius="4" Padding="6" Margin="0,0,0,4"
                                                                    Background="{StaticResource SurfaceAltBrush}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Image Grid.Column="0" Source="{Binding Preview}"
                                                                           Height="46" Width="60" Stretch="Uniform" Margin="0,0,8,0"/>
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding FileName}" FontSize="10" FontWeight="SemiBold"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                        <TextBlock Text="{Binding Info}" FontSize="9" FontStyle="Italic"
                                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>
                                                                    <TextBox Grid.Column="2" Width="52" Height="24" FontSize="11"
                                                                             VerticalContentAlignment="Center" Margin="0,0,4,0"
                                                                             FontFamily="Consolas"
                                                                             Text="{Binding Seconds, StringFormat={}{0:0.00}, UpdateSourceTrigger=LostFocus}"
                                                                             BorderBrush="{StaticResource BorderBrush}" Background="White"
                                                                             ToolTip="The second this still is locked at. The first keyframe should be 0.00 — that is the exact opening frame. A lock at the very end is deliberately not supported: the clip runs on from the last keyframe with no end-frame lock."/>
                                                                    <Button Grid.Column="3" Content="✕"
                                                                            Command="{Binding DataContext.RemoveKeyframeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            Width="24" Height="24" FontSize="10" Padding="0"
                                                                            VerticalAlignment="Center"
                                                                            Background="White" Foreground="{StaticResource TextSecondaryBrush}"
                                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Content="➕ Add keyframe"
                                                            Command="{Binding AddKeyframeCommand}"
                                                            IsEnabled="{Binding CanAddKeyframe}"
                                                            Height="26" Padding="8,0" FontSize="11" Margin="0,0,4,0"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            ToolTip="Adds a still clip 1 must land on exactly. The first one becomes the opening frame at 0.00s; every later one is a hard cut that replaces pose, outfit and background together at its timestamp.&#x0a;&#x0a;A timeline lives inside a single 15-second pass, so these belong to clip 1 alone — the other clips get their opening frame from the storyboard above.&#x0a;&#x0a;Keyframes, the cast's panels and the location share the reference node's nine slots, so this greys out once they are all spoken for."/>
                                                    <Button Grid.Column="1" Content="⇔ Spread"
                                                            Command="{Binding SpreadKeyframesCommand}"
                                                            Height="26" Padding="8,0" FontSize="11" Margin="0,0,4,0"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            ToolTip="Re-spaces every keyframe evenly, the first at 0.00s and the last about two-thirds of the way in, so the final beat has room to play out rather than the clip ending on a cut."/>
                                                    <Button Grid.Column="2" Content="✕"
                                                            Command="{Binding ClearKeyframesCommand}"
                                                            Height="26" Width="26" FontSize="11"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            ToolTip="Remove every hand-placed keyframe."/>
                                                </Grid>

                                                <TextBlock Text="{Binding KeyframeSummary}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Settings -->
                                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="14">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="SETTINGS" Margin="0,0,0,10"/>

                                                <TextBlock Text="Aspect ratio" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding AspectRatioOptions}"
                                                          SelectedItem="{Binding SelectedAspectRatio}"
                                                          Height="30" FontSize="11" Margin="0,0,0,4"
                                                          ToolTip="Auto follows the opening keyframe's own aspect — it is literally frame 0, so rendering at a different shape is a crop of the picture you asked to lock. With no keyframe it follows the location image."/>
                                                <TextBlock Text="{Binding ResolvedAspectRatio, StringFormat=→ {0}}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic" Margin="0,0,0,10"/>

                                                <TextBlock Text="Medium" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding MediumOptions}"
                                                          SelectedItem="{Binding SelectedMedium}"
                                                          Height="30" FontSize="11" Margin="0,0,0,10"
                                                          ToolTip="How the prompt's global-rules paragraph opens. It is stated in code rather than left to the writer because a chain's clips are written independently, and a style word that drifts is a style that changes mid-story."/>

                                                <TextBlock Text="Quality (canvas size)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding MegapixelOptions}"
                                                          DisplayMemberPath="Label"
                                                          SelectedValuePath="Value"
                                                          SelectedValue="{Binding Megapixels}"
                                                          Height="30" FontSize="11" Margin="0,0,0,8"/>

                                                <CheckBox Content="Max-fidelity references (2048px)" IsChecked="{Binding MaxFidelityReferences}"
                                                          FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"
                                                          Foreground="{StaticResource TextPrimaryBrush}"
                                                          ToolTip="Encodes every reference picture at a 2048px short edge instead of scaling them to the sampled canvas.&#x0a;&#x0a;On this tab&#x2019;s pipeline the sampled canvas is the DRAFT — a quarter of the quality you picked — and the Ensemble tab&#x2019;s trick of holding its panels at the finished canvas does not exist in this graph. There is also no face-refine pass here to fall back on, so this is on by default: holding a face is the whole point of a character sheet, and a 2048px reference is more face than even the finished canvas would carry.&#x0a;&#x0a;Reference tokens ride through every sampling step, so this is several times slower than &#x2018;match&#x2019; — it buys identity fidelity, nothing else. Turn it off for speed when the cast is distinctive enough to survive."/>

                                                <CheckBox Content="Latent upscale (draft → 2× finish)" IsChecked="{Binding UseLatentUpscale}"
                                                          FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"
                                                          Foreground="{StaticResource TextPrimaryBrush}"
                                                          ToolTip="Renders each clip in three moves instead of one: four sampler steps at half the width and half the height to settle the composition, a 2× pass through the MiniMax H3 3D latent upscaler, then three fixed-sigma steps at the finished size to put the detail on. Only those last three ever see the full canvas, which is why this is both quicker and sharper than denoising the whole clip over eight steps. This is the MiniMax I2V tab&#x2019;s recipe, and the reason this tab exists.&#x0a;&#x0a;Needs the MinimaxH3LatentUpscaler3D node pack on the server. Unchecked, the clip falls back to exactly that — one 8-step sampling at the full size, no upscaler involved."/>

                                                <CheckBox Content="SLA block-sparse attention" IsChecked="{Binding UseSla}"
                                                          FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"
                                                          Foreground="{StaticResource TextPrimaryBrush}"
                                                          ToolTip="Block-sparse attention for MiniMax H3: each query block is scored against every key block with one pooled matmul, and only the top slice is actually attended. Nothing is loaded and nothing is trained — the sparsity is decided at runtime from q and k. Measured 1.4–1.6× on this pipeline.&#x0a;&#x0a;It patches this tab&#x2019;s one H3 pass, the base render. Attention cost grows with the square of frames × canvas area, so long or large clips gain most; anything under the kernel&#x2019;s minimum sequence length falls back to dense on its own, which is why a short clip at 0.4 MP may show no change at all.&#x0a;&#x0a;Needs the H3-SLA-Attention node pack on the server. Unchecked, the patch is disabled and the graph runs dense attention."/>
                                                <ComboBox ItemsSource="{Binding SlaSparsityOptions}"
                                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                                          SelectedValue="{Binding SlaSparsity}"
                                                          IsEnabled="{Binding UseSla}"
                                                          Height="28" FontSize="11" Margin="18,0,0,6"
                                                          ToolTip="Fraction of key blocks skipped. Break-even is around 0.60 — below that the kernel is SLOWER than dense attention, so a low value is a loss, not a safe fallback.&#x0a;&#x0a;0.85 is lightx2v&#x2019;s shipped value and what the turbo LoRA was distilled against. 0.90 is roughly 13% quicker, and measured hotter and flatter in the speech band — which matters here because every clip this tab renders carries a soundtrack."/>
                                                <CheckBox Content="Sol-Attn (legacy sparse attention)" IsChecked="{Binding UseSparseAttention}"
                                                          FontSize="11" Margin="0,0,0,10"
                                                          ToolTip="Sol-Attn — the same author&#x2019;s earlier, general-purpose sparse attention, which this workflow ships with wired in and off.&#x0a;&#x0a;SLA supersedes it for H3 and stacking the two has not measured faster than SLA alone, so leaving both on is two approximations bought for one speedup. Turn it on only to compare against SLA, or if the SLA pack is missing from the server."/>

                                                <CheckBox Content="RTX ×2 super-resolution" IsChecked="{Binding RtxUpscale}"
                                                          FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"
                                                          Foreground="{StaticResource TextPrimaryBrush}"
                                                          ToolTip="Doubles the frames on the way to the file — driver-side, not a sampling pass, so it costs seconds rather than a second render. It is also the graph&#x2019;s largest single allocation: the whole doubled clip is held in one piece at the very end of the run, which is what takes ComfyUI down on a long job.&#x0a;&#x0a;Off by default for that reason. The video is then muxed at the H3 canvas and can be upscaled afterwards in ✨ Enhance Video, where nothing else is holding memory. Worth turning on for a short clip; watch the frame-stack line below."/>
                                                <TextBlock Text="{Binding UpscaleSummary}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap" Margin="0,0,0,4"/>
                                                <!-- Turns red once the frame stack reaches the size that kills the server. -->
                                                <TextBlock Text="{Binding LoadSummary}"
                                                           FontSize="10" FontStyle="Italic"
                                                           TextWrapping="Wrap" Margin="0,0,0,10">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasLoadWarning}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <CheckBox Content="Audio enhancement on the saved clip" IsChecked="{Binding UseAudioEnhancement}"
                                                          FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10"
                                                          Foreground="{StaticResource TextPrimaryBrush}"
                                                          ToolTip="Runs the finished clip&#x2019;s soundtrack through the audio-enhancement pass (DSRE) on the way to the file: noise reduction, presence and stereo width. On by default — the same switch the 🌀 MiniMax I2V tab ships on. Costs seconds; it does not touch the render."/>

                                                <TextBlock Text="Clip length (seconds · 4–15)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <Slider Value="{Binding LengthSeconds}"
                                                        Minimum="4" Maximum="15"
                                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                                        Foreground="{DynamicResource TabAccentBrush}" Margin="0,0,0,2"
                                                        ToolTip="How long a single H3 pass is — the model's own limit, and the window every keyframe timestamp has to fit inside. Shrinking it pulls any lock that no longer fits back in; the rest keep the timing you gave them."/>
                                                <TextBlock Text="{Binding LengthSummary}"
                                                           FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,0,0,10"/>

                                                <TextBlock Text="Seed (-1 = random)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0"
                                                             Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}"
                                                             Height="30" Padding="6,0" VerticalContentAlignment="Center"
                                                             BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                             FontSize="12" FontFamily="Consolas" Margin="0,0,6,0"/>
                                                    <Button Grid.Column="1" Content="🎲"
                                                            Command="{Binding RandomSeedCommand}"
                                                            Height="30" Width="36" FontSize="14"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- ═══ RIGHT PANEL ══════════════════════════════════════════════ -->
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="280"/>  <!-- Picture strip -->
                                    <RowDefinition Height="3"/>    <!-- Progress bar -->
                                    <RowDefinition Height="Auto"/> <!-- Status row -->
                                    <RowDefinition Height="Auto"/> <!-- Action buttons -->
                                    <RowDefinition Height="Auto"/> <!-- Queue -->
                                    <RowDefinition Height="Auto"/> <!-- Result output -->
                                    <RowDefinition Height="Auto"/> <!-- Log -->
                                </Grid.RowDefinitions>

                                <!-- ─── Picture strip: the locks, the storyboard, then the cast ─── -->
                                <Border Grid.Row="0" Background="{StaticResource PlayerSurfaceBrush}">
                                    <Grid>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasAnyCharacter}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Border Width="64" Height="64" CornerRadius="14" Background="{StaticResource PlayerSurfaceRaisedBrush}"
                                                    BorderBrush="{StaticResource TextSecondaryBrush}" BorderThickness="1"
                                                    HorizontalAlignment="Center" Margin="0,0,0,10">
                                                <TextBlock Text="🎭" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="MiniMax H3 · an ensemble of up to five, on the I2V turbo pipeline" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PlayerTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="Location + story → a photo and a part per character → Build Sheets → Analyze → Preview Keyframes → Generate — each clip a draft → 2× → finish turbo render"
                                                       FontSize="11" Foreground="{StaticResource PlayerTextBrush}" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <Grid Visibility="{Binding HasAnyCharacter, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              Margin="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>  <!-- keyframe locks -->
                                                <RowDefinition Height="Auto"/>  <!-- storyboard stills -->
                                                <RowDefinition Height="*"/>     <!-- the cast's sheets + the set -->
                                            </Grid.RowDefinitions>

                                            <!-- The hand-placed locks, in timestamp order — the strip reads
                                                 left to right the way clip 1 plays. -->
                                            <ItemsControl Grid.Row="0" ItemsSource="{Binding Keyframes}"
                                                          Visibility="{Binding HasKeyframes, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                          Margin="0,0,0,8">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,8,0">
                                                            <Image Source="{Binding Preview}" Height="76" Stretch="Uniform"/>
                                                            <TextBlock Text="{Binding Seconds, StringFormat=🔒 {0:0.00}s}"
                                                                       HorizontalAlignment="Center" Margin="0,4,0,0"
                                                                       FontSize="10" FontFamily="Consolas"
                                                                       Foreground="{StaticResource PlayerTextBrush}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- The storyboard: one still per clip, in clip order, each of
                                                 them about to be that clip's frame 0. -->
                                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                                                          VerticalScrollBarVisibility="Disabled"
                                                          Visibility="{Binding HasStoryboard, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                          Margin="0,0,0,8">
                                                <ItemsControl ItemsSource="{Binding Storyboard}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,8,0" Padding="6" CornerRadius="4"
                                                                    Background="{StaticResource PlayerSurfaceRaisedBrush}"
                                                                    BorderThickness="1">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource TabAccentBrush}"/>
                                                                        <Setter Property="Opacity" Value="1"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Use}" Value="False">
                                                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                                                <Setter Property="Opacity" Value="0.45"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel Width="150">
                                                                    <Image Source="{Binding Preview}" Height="90" Stretch="Uniform"
                                                                           ToolTip="{Binding Beat}"/>
                                                                    <TextBlock Text="{Binding Caption}"
                                                                               HorizontalAlignment="Center" Margin="0,4,0,0"
                                                                               FontSize="10" FontFamily="Consolas"
                                                                               Foreground="{StaticResource PlayerTextBrush}"/>
                                                                    <TextBlock Text="{Binding Beat}" MaxHeight="28"
                                                                               FontSize="9" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                                               Foreground="{StaticResource PlayerTextBrush}" Opacity="0.75"/>
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                                                        <Button Content="‹" Width="22" Height="20" FontSize="11" Padding="0"
                                                                                Visibility="{Binding HasChoice, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                Command="{Binding DataContext.PrevCandidateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                CommandParameter="{Binding}"
                                                                                ToolTip="The frame before this one out of the same preview render — a later frame simply starts the clip further into the move."/>
                                                                        <Button Content="🎲" Width="26" Height="20" FontSize="10" Padding="0" Margin="3,0"
                                                                                Command="{Binding DataContext.RerollShotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                CommandParameter="{Binding}"
                                                                                ToolTip="Re-renders this clip's still on a fresh seed. Nothing else in the chain moves."/>
                                                                        <Button Content="›" Width="22" Height="20" FontSize="11" Padding="0"
                                                                                Visibility="{Binding HasChoice, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                Command="{Binding DataContext.NextCandidateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                CommandParameter="{Binding}"
                                                                                ToolTip="The next frame out of the same preview render."/>
                                                                        <CheckBox IsChecked="{Binding Use, Mode=TwoWay}" VerticalAlignment="Center" Margin="6,0,0,0"
                                                                                  Foreground="{StaticResource PlayerTextBrush}"
                                                                                  ToolTip="Locked in as this clip's opening frame. Unticked, the clip renders as a reference-driven take with no frame lock."/>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>

                                            <!-- The sheets, one per loaded character, then the set. Scrolls
                                                 sideways because five sheets do not fit across a panel. -->
                                            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto"
                                                          VerticalScrollBarVisibility="Disabled">
                                                <StackPanel Orientation="Horizontal">
                                                    <ItemsControl ItemsSource="{Binding Cast}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Margin="0,0,10,0"
                                                                            Visibility="{Binding HasSource, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <Image Height="110" Stretch="Uniform" MinWidth="80"
                                                                           Source="{Binding SheetPreview}"/>
                                                                    <TextBlock HorizontalAlignment="Center" Margin="0,6,0,0"
                                                                               FontSize="10" MaxWidth="200"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Text="{Binding Label}"
                                                                               Foreground="{StaticResource PlayerTextBrush}"/>
                                                                    <TextBlock HorizontalAlignment="Center"
                                                                               FontSize="9" Opacity="0.75"
                                                                               Text="{Binding Index, StringFormat=&lt;Subject {0}&gt;}"
                                                                               Foreground="{StaticResource PlayerTextBrush}"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <StackPanel Visibility="{Binding HasEnvironment, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Image Height="110" Stretch="Uniform" MinWidth="80"
                                                               Source="{Binding EnvironmentPreview}"/>
                                                        <TextBlock Text="Location" HorizontalAlignment="Center" Margin="0,6,0,0"
                                                                   FontSize="10" Foreground="{StaticResource PlayerTextBrush}"/>
                                                        <TextBlock HorizontalAlignment="Center" FontSize="9" Opacity="0.75"
                                                                   Foreground="{StaticResource PlayerTextBrush}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="prompt only"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding WiresEnvironment}" Value="True">
                                                                            <Setter Property="Text" Value="last reference picture"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- ─── Progress bar ──────────────────────────────────────── -->
                                <ProgressBar Grid.Row="1"
                                             Value="{Binding ProcessingProgress, Mode=OneWay}"
                                             Foreground="{DynamicResource TabAccentBrush}" BorderThickness="0"
                                             Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <!-- ─── Status row ────────────────────────────────────────── -->
                                <Border Grid.Row="2" Style="{StaticResource ToolStripStyle}"
                                        BorderThickness="0,1,0,0" Padding="12,5">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,7,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource TextPrimaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource TabAccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding ProcessingStatus}"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Text="{Binding ProgressPercentage, Mode=OneWay}"
                                                   FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TabAccentBrush}"
                                                   FontFamily="Consolas"
                                                   Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>

                                <!-- ─── Action Buttons ────────────────────────────────────── -->
                                <Border Grid.Row="3" Style="{StaticResource ToolStripStyle}"
                                        BorderThickness="0,1,0,0" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Margin="0,0,8,0" Height="40"
                                                Command="{Binding GenerateCommand}"
                                                IsEnabled="{Binding CanGenerate}"
                                                Style="{StaticResource AccentOutlineButtonStyle}"
                                                FontSize="12" FontWeight="Bold"
                                                ToolTip="Re-stamps the prompt against the cast, keyframes, location and wardrobe as they stand, snapshots everything into the queue. Nothing renders until ▶ Generate is pressed. Each clip is queued with only the characters its own text names.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🎬 " VerticalAlignment="Center"/>
                                                <TextBlock Text="Add to Queue" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="1" Height="40" Width="118" Margin="0,0,8,0"
                                                Command="{Binding StartQueueCommand}"
                                                Style="{StaticResource AccentButtonStyle}"
                                                FontSize="12" FontWeight="Bold"
                                                ToolTip="Starts rendering everything pending in the queue. Add to Queue only stages a job — nothing reaches the GPU until this is pressed, so several prompts can be queued and then rendered in one run. Greyed out while the queue is already running, and when nothing is pending.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="▶ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Generate" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="2" Height="40" Width="82"
                                                Command="{Binding CancelCommand}"
                                                Style="{StaticResource DangerButtonStyle}"
                                                FontSize="11"
                                                ToolTip="Stops whatever is on the GPU — the sheet builder, the storyboard or the queue. Pending items stay queued.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✕ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- ─── Queue ─────────────────────────────────────────────── -->
                                <Border Grid.Row="4" Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8"
                                        Visibility="{Binding HasQueueItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="🎭 Multi Queue"
                                                       FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TabAccentBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding QueueStatus}"
                                                       FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="2" Content="▶ Generate"
                                                    Command="{Binding StartQueueCommand}"
                                                    Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    ToolTip="Starts rendering the pending items — the same command as the ▶ Generate button above."/>
                                            <Button Grid.Column="3" Content="🔄 Retry"
                                                    Command="{Binding ReprocessAllFailedCommand}"
                                                    Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    ToolTip="Put every failed item back to Pending and run them again."/>
                                            <Button Grid.Column="4" Content="⏹ Stop"
                                                    Command="{Binding StopQueueCommand}"
                                                    Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                                    Style="{StaticResource AccentButtonStyle}"/>
                                            <Button Grid.Column="5" Content="🗑️ Clear"
                                                    Command="{Binding ClearQueueCommand}"
                                                    Height="26" Padding="8,0" FontSize="11"
                                                    Style="{StaticResource AccentButtonStyle}"/>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Queue}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                                            Padding="8,5" Margin="0,0,0,3" Background="White">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" CornerRadius="3" Padding="6,2" Margin="0,0,8,0"
                                                                    VerticalAlignment="Center"
                                                                    Background="{Binding StatusColor}">
                                                                <TextBlock Text="{Binding StatusDisplay}" FontSize="10"
                                                                           FontWeight="SemiBold" Foreground="White"/>
                                                            </Border>
                                                            <Image Grid.Column="1" Source="{Binding QueueThumbnail}"
                                                                   Height="34" Stretch="Uniform" Margin="0,0,8,0"/>
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold" FontSize="11"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <!-- The beat in one line, not the whole
                                                                     six-section prompt: on a chain, most of
                                                                     that prompt is identical in every row. -->
                                                                <TextBlock Text="{Binding PromptPreview}" FontSize="10"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           ToolTipService.ShowDuration="60000"
                                                                           TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis">
                                                                    <TextBlock.ToolTip>
                                                                        <ToolTip MaxWidth="700">
                                                                            <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" FontSize="11"/>
                                                                        </ToolTip>
                                                                    </TextBlock.ToolTip>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding ErrorMessage}" FontSize="10"
                                                                           Foreground="{StaticResource DangerBrush}"
                                                                           TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="3" Content="✕"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Command="{Binding DataContext.RemoveQueueItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    VerticalAlignment="Center"
                                                                    Width="26" Height="26" Padding="0" FontSize="10"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- ─── Result Output ──────────────────────────────────────── -->
                                <Border Grid.Row="5" Background="White" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,1,0,0" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="🎥 Result Video" FontWeight="Bold" FontSize="13"
                                                   Foreground="{DynamicResource TabAccentBrush}" Margin="0,0,0,8"/>

                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource PlayerSurfaceBrush}"
                                                Height="200" CornerRadius="6" Margin="0,0,0,8">
                                            <Grid>
                                                <TextBlock Text="Video will appear here after generation"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{StaticResource PlayerTextBrush}" FontStyle="Italic">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasResult}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <MediaElement x:Name="H3MultiVideoPlayer"
                                                              Source="{Binding ResultVideoPath}"
                                                              LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                              Stretch="Uniform"
                                                              Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Button Content="▶ Play" Style="{StaticResource PrimaryButtonStyle}"
                                                    Command="{Binding PlayVideoCommand}"
                                                    IsEnabled="{Binding HasResult}" Margin="0,0,8,0"/>
                                            <Button Content="📁 Open Folder" Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding OpenResultFolderCommand}"
                                                    IsEnabled="{Binding HasResult}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ResultVideoInfo}"
                                                   FontStyle="Italic" Foreground="#666" FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <!-- ─── Log ───────────────────────────────────────────────── -->
                                <ctrl:ProcessingLogPanel Grid.Row="6" LogText="{Binding LogOutput}" MaxLogHeight="130"/>

                            </Grid>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- ═══════════════════════════════════════════════════════════════
                         H3 CHAIN — MiniMax H3 driven autoregressively. Two reference
                         images and a soundtrack become ONE continuous take of arbitrary
                         length: the MiniMaxH3Chain* nodes loop inside ComfyUI, carrying
                         the tail of each segment into the head of the next, and assemble
                         and mux the whole thing themselves. One queue item = one video.
                         ═══════════════════════════════════════════════════════════════ -->
                    <TabItem Header="🎵♾️ H3 Chain">
                        <Grid DataContext="{Binding H3ChainVM}" Style="{StaticResource TabPageStyle}">
                            <Grid.Resources>
                                <SolidColorBrush x:Key="TabAccentBrush" Color="{StaticResource AccentIndigoColor}"/>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ═══ LEFT PANEL ═══════════════════════════════════════════════ -->
                            <Border Grid.Column="0" Style="{StaticResource TabSideRailStyle}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="12">

                                        <!-- References -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="REFERENCES" Note="  · held for the whole take" Margin="0,0,0,10"/>

                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Reference 1 — face -->
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Face · &lt;Picture 1&gt;" FontSize="10"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                                                Background="{StaticResource SurfaceAltBrush}" Height="118" Margin="0,0,0,6">
                                                            <Grid>
                                                                <TextBlock Text="Required"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextMutedBrush}" FontSize="10">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Reference1Preview}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <Image Source="{Binding Reference1Preview}" Stretch="Uniform"/>
                                                            </Grid>
                                                        </Border>
                                                        <Button Content="Browse…" Command="{Binding SelectReference1Command}"
                                                                Height="26" Padding="8,0" FontSize="11"
                                                                Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                        <TextBlock Text="{Binding Reference1Info}" FontSize="9" Margin="0,4,0,0"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <!-- Reference 2 — body / wardrobe -->
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Body · &lt;Picture 2&gt;" FontSize="10"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                                                Background="{StaticResource SurfaceAltBrush}" Height="118" Margin="0,0,0,6">
                                                            <Grid>
                                                                <TextBlock Text="Optional"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextMutedBrush}" FontSize="10">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Reference2Preview}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <Image Source="{Binding Reference2Preview}" Stretch="Uniform"/>
                                                            </Grid>
                                                        </Border>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button Grid.Column="0" Content="Browse…" Command="{Binding SelectReference2Command}"
                                                                    Height="26" Padding="8,0" FontSize="11" Margin="0,0,4,0"
                                                                    Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                            <Button Grid.Column="1" Content="✕" Command="{Binding ClearReference2Command}"
                                                                    IsEnabled="{Binding HasReference2}"
                                                                    Height="26" Width="26" FontSize="11"
                                                                    ToolTip="Drop the second reference. The chain then runs on &lt;Picture 1&gt; alone and the loader is removed from the graph."
                                                                    Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Reference2Info}" FontSize="9" Margin="0,4,0,0"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="{Binding ReferenceSummary}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Soundtrack -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="SOUNDTRACK" Note="  · &lt;Audio 1&gt;, sliced per segment" Margin="0,0,0,10"/>

                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding AudioInfo}"
                                                               FontSize="11" FontFamily="Consolas"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <Button Grid.Column="1" Content="♪ Browse…"
                                                            Command="{Binding SelectAudioCommand}"
                                                            Height="28" Padding="10,0" FontSize="11"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                </Grid>

                                                <CheckBox Content="Loop the track to cover the video"
                                                          IsChecked="{Binding LoopAudio}"
                                                          FontSize="11" Margin="0,0,0,6"
                                                          ToolTip="Loops (and trims) the soundtrack with FFmpeg so it covers the whole running time. Off, a track shorter than the video leaves the rest of the take running against silence."/>

                                                <TextBlock Text="{Binding AudioCoverageSummary}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap" Margin="0,0,0,8"/>

                                                <TextBlock Text="Audio conditioning" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding AudioModeOptions}"
                                                          DisplayMemberPath="Label"
                                                          SelectedValuePath="Value"
                                                          SelectedValue="{Binding AudioMode}"
                                                          Height="30" FontSize="11"
                                                          ToolTip="How the chain feeds audio to H3. Song only slices the track per segment. Song + generated tail additionally carries H3's own generated audio across the seam, which smooths the join at the cost of a little drift."/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Length planner -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="LENGTH" Note="  · how far the chain runs" Margin="0,0,0,10"/>

                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Total running time" FontSize="10"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                        <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                                BorderThickness="1" CornerRadius="4" Padding="0,5" Margin="0,0,0,6">
                                                            <TextBlock Text="{Binding TotalSecondsDisplay}"
                                                                       HorizontalAlignment="Center" FontFamily="Consolas"
                                                                       FontSize="15" FontWeight="Bold"
                                                                       Foreground="{DynamicResource TabAccentBrush}"/>
                                                        </Border>
                                                        <Slider Value="{Binding TotalSeconds}"
                                                                Minimum="15" Maximum="1800"
                                                                TickFrequency="5" IsSnapToTickEnabled="True"
                                                                SmallChange="5" LargeChange="30"
                                                                Foreground="{DynamicResource TabAccentBrush}"
                                                                ToolTip="How long the finished take runs, from 15 seconds to 30 minutes. There is no per-clip ceiling here: the chain keeps going for as many segments as this needs."/>
                                                        <Button Content="♪ Match the song"
                                                                Command="{Binding MatchSongLengthCommand}"
                                                                Height="26" Padding="8,0" FontSize="11" Margin="0,6,0,0"
                                                                Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                                ToolTip="Sets the running time to the loaded track's own length, so the take ends when the song does."/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Segment length" FontSize="10"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                        <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                                BorderThickness="1" CornerRadius="4" Padding="0,5" Margin="0,0,0,6">
                                                            <TextBlock Text="{Binding SegmentSeconds, StringFormat={}{0:0} s}"
                                                                       HorizontalAlignment="Center" FontFamily="Consolas"
                                                                       FontSize="15" FontWeight="Bold"
                                                                       Foreground="{DynamicResource TabAccentBrush}"/>
                                                        </Border>
                                                        <Slider Value="{Binding SegmentSeconds}"
                                                                Minimum="4" Maximum="15"
                                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                                Foreground="{DynamicResource TabAccentBrush}"
                                                                ToolTip="How much video one H3 pass produces — the model's own limit. Shorter segments mean more of them, and one more seam to carry motion across each time."/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="{Binding PlanSummary}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Story + lyrics -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="WHAT THE TAKE SHOWS" Margin="0,0,0,10"/>

                                                <TextBlock Text="Story (optional)" FontSize="10"
                                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding StoryGuidance, UpdateSourceTrigger=PropertyChanged}"
                                                         TextWrapping="Wrap" AcceptsReturn="True"
                                                         Height="76" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"
                                                         BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                         FontSize="11" Padding="6"
                                                         ToolTip="What happens across the whole take, beginning to end. Left empty, Analyze invents a performance that suits the references."/>

                                                <TextBlock Text="Lyrics (optional)" FontSize="10"
                                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding Lyrics, UpdateSourceTrigger=PropertyChanged}"
                                                         TextWrapping="Wrap" AcceptsReturn="True"
                                                         Height="96" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6"
                                                         BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                         FontSize="11" Padding="6"
                                                         ToolTip="Paste the song's words here. The llama-server cannot hear the track, so this is the only way it can write real lyrics into the &lt;d&gt;[English] …&lt;/d&gt; tags and hand them out across the segments in order. Left empty, the segments describe the performance and quote nothing."/>

                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="🔍 Analyze → Chain Plan"
                                                            Command="{Binding AnalyzeCommand}"
                                                            IsEnabled="{Binding CanAnalyze}"
                                                            Height="32" Padding="14,0" FontSize="11"
                                                            Style="{StaticResource AccentButtonStyle}"
                                                            ToolTip="Sends both reference images, the story and the lyrics to the llama-server with h3chain.md, and writes one H3 plan per segment — subject_definitions, summary, retention_analysis, detailed_description, soundscape and score — split by &quot;=== SEGMENT n of N ===&quot; headers. Unlike the other MiniMax tabs the model IS shown the references here, because the plan format has to spell the wardrobe out in words."/>
                                                    <TextBlock FontStyle="Italic" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"
                                                               Text="Analyzing…" Foreground="{DynamicResource TabAccentBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAnalyzing}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Chain plan text -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="CHAIN PLAN" Note="  · one plan per segment"/>
                                                <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                                                         TextWrapping="Wrap" AcceptsReturn="True"
                                                         Height="260" VerticalScrollBarVisibility="Auto"
                                                         BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                         FontSize="11" Padding="8"/>

                                                <TextBlock Text="{Binding PromptSegmentSummary}"
                                                           FontSize="10" FontWeight="SemiBold" Margin="0,6,0,0"
                                                           Foreground="{DynamicResource TabAccentBrush}" TextWrapping="Wrap"/>

                                                <TextBlock Text="This box is what gets submitted. Split on its &quot;=== SEGMENT n of N ===&quot; headers, one entry per segment goes into a single chain plan — so deleting a segment or adding a header here changes the video, not just the preview."
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Settings -->
                                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="14">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="SETTINGS" Margin="0,0,0,10"/>

                                                <TextBlock Text="Aspect ratio" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding AspectRatioOptions}"
                                                          SelectedItem="{Binding SelectedAspectRatio}"
                                                          Height="30" FontSize="11" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding ResolvedAspectRatio, StringFormat=→ {0}}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic" Margin="0,0,0,10"/>

                                                <TextBlock Text="Canvas size" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding MegapixelOptions}"
                                                          DisplayMemberPath="Label"
                                                          SelectedValuePath="Value"
                                                          SelectedValue="{Binding Megapixels}"
                                                          Height="30" FontSize="11" Margin="0,0,0,4"
                                                          ToolTip="A chain multiplies its canvas cost by the segment count, so the default is the workflow's own 960×544 rather than the single-clip tabs' 1.0 MP."/>
                                                <TextBlock Text="{Binding CanvasSummary}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                                                <TextBlock Text="Motion carried across each seam" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding ContextLengthOptions}"
                                                          DisplayMemberPath="Label"
                                                          SelectedValuePath="Value"
                                                          SelectedValue="{Binding ContextLength}"
                                                          Height="30" FontSize="11" Margin="0,0,0,10"
                                                          ToolTip="How many frames of the previous segment are regenerated at the head of the next one so motion continues through the join. They are trimmed back off afterwards, so this costs render time rather than running time. 22 is the tested default."/>

                                                <TextBlock Text="Steps per segment" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <Slider Value="{Binding Steps}"
                                                        Minimum="1" Maximum="40"
                                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                                        Foreground="{DynamicResource TabAccentBrush}" Margin="0,0,0,2"
                                                        ToolTip="The workflow ships the 4-step lightx2v turbo LoRA, so 5 is the intended figure. Raising it costs render time on every segment of the chain."/>
                                                <TextBlock Text="{Binding Steps, StringFormat={}{0} steps · turbo LoRA is loaded}"
                                                           FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,0,0,10"/>

                                                <TextBlock Text="Base seed (-1 = random)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0"
                                                             Text="{Binding BaseSeed, UpdateSourceTrigger=PropertyChanged}"
                                                             Height="30" Padding="6,0" VerticalContentAlignment="Center"
                                                             BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                             FontSize="12" FontFamily="Consolas" Margin="0,0,6,0"
                                                             ToolTip="Every segment's own seed is derived from this, so the same base always renders the same chain — which is also what lets a resumed chain pick up the sequence it was already rendering."/>
                                                    <Button Grid.Column="1" Content="🎲"
                                                            Command="{Binding RandomSeedCommand}"
                                                            Height="30" Width="36" FontSize="14"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- ═══ RIGHT PANEL ══════════════════════════════════════════════ -->
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="240"/>  <!-- Reference strip -->
                                    <RowDefinition Height="3"/>    <!-- Progress bar -->
                                    <RowDefinition Height="Auto"/> <!-- Status row -->
                                    <RowDefinition Height="Auto"/> <!-- Action buttons -->
                                    <RowDefinition Height="Auto"/> <!-- Queue -->
                                    <RowDefinition Height="Auto"/> <!-- Result output -->
                                    <RowDefinition Height="Auto"/> <!-- Log -->
                                </Grid.RowDefinitions>

                                <!-- ─── Reference strip ──────────────────────────────────────── -->
                                <Border Grid.Row="0" Background="{StaticResource PlayerSurfaceBrush}">
                                    <Grid>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasReference1}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Border Width="64" Height="64" CornerRadius="14" Background="{StaticResource PlayerSurfaceRaisedBrush}"
                                                    BorderBrush="{StaticResource TextSecondaryBrush}" BorderThickness="1"
                                                    HorizontalAlignment="Center" Margin="0,0,0,10">
                                                <TextBlock Text="🎵" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="MiniMax H3 · Autoregressive Chain" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PlayerTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="Two references + a song → one continuous take, as long as you ask for"
                                                       FontSize="11" Foreground="{StaticResource PlayerTextBrush}" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <Grid Visibility="{Binding HasReference1, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              Margin="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <Image Source="{Binding Reference1Preview}" Stretch="Uniform" Height="176"/>
                                                <TextBlock Text="Face · &lt;Picture 1&gt;" HorizontalAlignment="Center" Margin="0,6,0,0"
                                                           FontSize="10" Foreground="{StaticResource PlayerTextBrush}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="6,0"
                                                        Visibility="{Binding HasReference2, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Image Source="{Binding Reference2Preview}" Stretch="Uniform" Height="176"/>
                                                <TextBlock Text="Body · &lt;Picture 2&gt;" HorizontalAlignment="Center" Margin="0,6,0,0"
                                                           FontSize="10" Foreground="{StaticResource PlayerTextBrush}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding HasAudio, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="♪" FontSize="52" HorizontalAlignment="Center"
                                                           Foreground="{StaticResource PlayerTextBrush}"/>
                                                <TextBlock Text="{Binding AudioInfo}" HorizontalAlignment="Center" Margin="0,6,0,0"
                                                           FontSize="11" FontFamily="Consolas" Foreground="{StaticResource PlayerTextBrush}"/>
                                                <TextBlock Text="{Binding PlanSummary}" HorizontalAlignment="Center" Margin="6,6,6,0"
                                                           TextAlignment="Center" TextWrapping="Wrap"
                                                           FontSize="10" Foreground="{StaticResource PlayerTextBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- ─── Progress bar ──────────────────────────────────────── -->
                                <ProgressBar Grid.Row="1"
                                             Value="{Binding ProcessingProgress, Mode=OneWay}"
                                             Foreground="{DynamicResource TabAccentBrush}" BorderThickness="0"
                                             Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <!-- ─── Status row ────────────────────────────────────────── -->
                                <Border Grid.Row="2" Style="{StaticResource ToolStripStyle}"
                                        BorderThickness="0,1,0,0" Padding="12,5">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,7,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource TextPrimaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource TabAccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding ProcessingStatus}"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Text="{Binding ProgressPercentage, Mode=OneWay}"
                                                   FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TabAccentBrush}"
                                                   FontFamily="Consolas"
                                                   Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>

                                <!-- ─── Action Buttons ────────────────────────────────────── -->
                                <Border Grid.Row="3" Style="{StaticResource ToolStripStyle}"
                                        BorderThickness="0,1,0,0" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Margin="0,0,8,0" Height="40"
                                                Command="{Binding GenerateCommand}"
                                                IsEnabled="{Binding CanGenerate}"
                                                Style="{StaticResource AccentOutlineButtonStyle}"
                                                FontSize="12" FontWeight="Bold"
                                                ToolTip="Snapshots the references, the soundtrack and every segment plan into ONE queue item. Nothing renders until ▶ Generate is pressed. The whole chain is a single ComfyUI submission — it renders every segment, carries motion across each seam, and assembles and muxes the finished take itself.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="♾️ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Queue Chain" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="1" Height="40" Width="118" Margin="0,0,8,0"
                                                Command="{Binding StartQueueCommand}"
                                                Style="{StaticResource AccentButtonStyle}"
                                                FontSize="12" FontWeight="Bold"
                                                ToolTip="Starts rendering everything pending in the queue. Add to Queue only stages a job — nothing reaches the GPU until this is pressed, so several prompts can be queued and then rendered in one run. Greyed out while the queue is already running, and when nothing is pending.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="▶ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Generate" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="2" Height="40" Width="82"
                                                Command="{Binding CancelCommand}"
                                                IsEnabled="{Binding IsProcessingQueue}"
                                                Style="{StaticResource DangerButtonStyle}"
                                                FontSize="11"
                                                ToolTip="Stops the chain currently on the GPU. Segments already rendered stay checkpointed — ⏩ Resume picks the chain back up from the first one missing.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✕ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- ─── Queue ─────────────────────────────────────────────────
                                     One row is one whole video, not one clip of it. -->
                                <Border Grid.Row="4" Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8"
                                        Visibility="{Binding HasQueueItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="♾️ Chain Queue"
                                                       FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TabAccentBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding QueueStatus}"
                                                       FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="2" Content="▶ Generate"
                                                    Command="{Binding StartQueueCommand}"
                                                    Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    ToolTip="Starts rendering the pending chains — the same command as the ▶ Generate button above."/>
                                            <Button Grid.Column="3" Content="🔄 Retry"
                                                    Command="{Binding ReprocessAllFailedCommand}"
                                                    Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    ToolTip="Put every failed chain back to Pending and run it again from the top. To keep the segments it already rendered, use ⏩ Resume on the row instead."/>
                                            <Button Grid.Column="4" Content="⏹ Stop"
                                                    Command="{Binding StopQueueCommand}"
                                                    Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                                    Style="{StaticResource AccentButtonStyle}"/>
                                            <Button Grid.Column="5" Content="🗑️ Clear"
                                                    Command="{Binding ClearQueueCommand}"
                                                    Height="26" Padding="8,0" FontSize="11"
                                                    Style="{StaticResource AccentButtonStyle}"/>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Queue}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                                            Padding="8,5" Margin="0,0,0,3" Background="White">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" CornerRadius="3" Padding="6,2" Margin="0,0,8,0"
                                                                    VerticalAlignment="Center"
                                                                    Background="{Binding StatusColor}">
                                                                <TextBlock Text="{Binding StatusDisplay}" FontSize="10"
                                                                           FontWeight="SemiBold" Foreground="White"/>
                                                            </Border>
                                                            <Image Grid.Column="1" Source="{Binding QueueThumbnail}"
                                                                   Height="34" Stretch="Uniform" Margin="0,0,8,0"/>
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold" FontSize="11"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding PromptPreview}" FontSize="10"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding ErrorMessage}" FontSize="10"
                                                                           Foreground="{StaticResource DangerBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="3" Content="⏩"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Command="{Binding DataContext.ResumeQueueItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    VerticalAlignment="Center" Margin="0,0,4,0"
                                                                    Width="26" Height="26" Padding="0" FontSize="10"
                                                                    ToolTip="Resume this chain. Counts the segments already checkpointed on disk and restarts it at the first one missing, instead of re-rendering the whole take."/>
                                                            <Button Grid.Column="4" Content="✕"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Command="{Binding DataContext.RemoveQueueItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    VerticalAlignment="Center"
                                                                    Width="26" Height="26" Padding="0" FontSize="10"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- ─── Result Output ──────────────────────────────────────── -->
                                <Border Grid.Row="5" Background="White" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,1,0,0" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="🎥 Assembled Take" FontWeight="Bold" FontSize="13"
                                                   Foreground="{DynamicResource TabAccentBrush}" Margin="0,0,0,8"/>

                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource PlayerSurfaceBrush}"
                                                Height="200" CornerRadius="6" Margin="0,0,0,8">
                                            <Grid>
                                                <TextBlock Text="The joined take appears here once the last segment lands"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{StaticResource PlayerTextBrush}" FontStyle="Italic">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasResult}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <MediaElement x:Name="H3ChainVideoPlayer"
                                                              Source="{Binding ResultVideoPath}"
                                                              LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                              Stretch="Uniform"
                                                              Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Button Content="▶ Play" Style="{StaticResource PrimaryButtonStyle}"
                                                    Command="{Binding PlayVideoCommand}"
                                                    IsEnabled="{Binding HasResult}" Margin="0,0,8,0"/>
                                            <Button Content="📁 Open Folder" Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding OpenResultFolderCommand}"
                                                    IsEnabled="{Binding HasResult}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ResultVideoInfo}"
                                                   FontStyle="Italic" Foreground="#666" FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <!-- ─── Log ───────────────────────────────────────────────── -->
                                <ctrl:ProcessingLogPanel Grid.Row="6" LogText="{Binding LogOutput}" MaxLogHeight="130"/>

                            </Grid>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

        </TabControl>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Height="28">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusBarMessage}" FontSize="11"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ComfyUI: " FontSize="11" Foreground="#666"/>
                    <TextBlock Text="{Binding ComfyUIServer}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text=":" FontSize="11"/>
                    <TextBlock Text="{Binding ComfyUIPort}" FontSize="11" FontWeight="Bold"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>
