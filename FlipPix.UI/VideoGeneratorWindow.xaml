<Window x:Class="FlipPix.UI.VideoGeneratorWindow"
        Icon="flippix.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:FlipPix.UI.Converters"
        xmlns:ctrl="clr-namespace:FlipPix.UI.Controls"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="FlipPix - Video Generator" Height="750" Width="950"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        WindowStyle="SingleBorderWindow"
        MinHeight="650" MinWidth="850"
        ResizeMode="CanResize">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- A cast card's thumbnail. 92px is enough to tell which picture is loaded and not enough to
             judge a face, so clicking one hands the file to the shell and it opens at full size in
             whatever the user has set as their image viewer. Tag carries the path — SourcePath on the
             photo, SheetPath on the built sheet — and an empty Tag is an empty frame: no hand cursor,
             no tooltip, and the handler does nothing. -->
        <Style x:Key="CastThumbnailStyle" TargetType="Border">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Click to open this picture at full size in your image viewer."/>
            <EventSetter Event="MouseLeftButtonUp" Handler="CastThumbnail_MouseLeftButtonUp"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="">
                    <Setter Property="Cursor" Value="Arrow"/>
                    <Setter Property="ToolTip" Value="{x:Null}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
            <Border.Background>
                <SolidColorBrush Color="{StaticResource BrandColor}"/>
            </Border.Background>
            <StackPanel Margin="20,8" Orientation="Horizontal">
                <TextBlock Text="🎬 Video Generator"
                          FontSize="18" FontWeight="Bold"
                          Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text="Generate videos from images using AI — upload an image and describe the motion"
                          FontSize="11" Foreground="#E6FFFFFF"
                          VerticalAlignment="Center" Margin="14,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Navigation Bar -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1" Padding="15,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Navigate:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                <Button Content="Image Generator" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateToImageGeneratorCommand}"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="2" Margin="15,10,15,10" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

                    <!-- Tab: Scail 2 (unified Klein char-swap → SCAIL II motion transfer) -->
                    <TabItem Header="🎭 Scail 2">
                        <Grid DataContext="{Binding Scail2VM}" Style="{StaticResource TabPageStyle}">
                            <Grid.Resources>
                                <SolidColorBrush x:Key="TabAccentBrush" Color="{StaticResource AccentIndigoColor}"/>
                            </Grid.Resources>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="14" MaxWidth="640" HorizontalAlignment="Center">

                                    <!-- ═══ 1) Base scene (video) ═══════════════════════════ -->
                                    <Border Style="{StaticResource SectionCardStyle}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource TabAccentBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="BASE SCENE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding InputVideoInfo}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontStyle="Italic" VerticalAlignment="Center" Margin="10,0,0,0"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Upload video…"
                                                        Command="{Binding SelectVideoCommand}"
                                                        Height="30" Padding="12,0" FontSize="11"
                                                        Style="{StaticResource SuccessButtonStyle}" Cursor="Hand"/>
                                            </Grid>

                                            <!-- Reference video preview (Source assigned in code-behind) -->
                                            <Border Background="{StaticResource PlayerSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    CornerRadius="6" Height="200">
                                                <Grid>
                                                    <TextBlock Text="Upload a base scene video, then scrub to a frame showing both people"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{StaticResource PlayerTextBrush}" FontSize="12" TextAlignment="Center"
                                                               TextWrapping="Wrap" MaxWidth="320">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasInputVideo}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <MediaElement x:Name="Scail2RefVideoPlayer"
                                                                  LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                                  ScrubbingEnabled="True"
                                                                  MediaOpened="Scail2RefPlayer_MediaOpened"
                                                                  MediaEnded="Scail2RefPlayer_MediaEnded"
                                                                  Stretch="Uniform"
                                                                  Visibility="{Binding HasInputVideo, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>

                                            <!-- Scrub + In/Out trim track (playhead = Klein frame; markers = SCAIL II range) -->
                                            <Grid x:Name="Scail2TrimTrack" Height="30" Margin="2,10,2,0"
                                                  Background="Transparent" ClipToBounds="False"
                                                  SizeChanged="Scail2TrimTrack_SizeChanged"
                                                  Visibility="{Binding HasInputVideo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Border Height="8" VerticalAlignment="Center" CornerRadius="4" Background="{StaticResource BorderStrongBrush}"/>
                                                <Border x:Name="Scail2TrimRegion" Height="8" Width="0"
                                                        VerticalAlignment="Center" HorizontalAlignment="Left"
                                                        CornerRadius="4" Background="{DynamicResource TabAccentBrush}" IsHitTestVisible="False"/>
                                                <Border x:Name="Scail2TrimPlayhead" Width="2" Height="24"
                                                        VerticalAlignment="Center" HorizontalAlignment="Left"
                                                        Background="{StaticResource TextMutedBrush}" IsHitTestVisible="False"/>
                                                <Thumb x:Name="Scail2InThumb" Width="14" Height="24"
                                                       HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="SizeWE"
                                                       DragDelta="Scail2InThumb_DragDelta"
                                                       ToolTip="Drag to set the start (in) point">
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="{StaticResource SuccessBrush}" CornerRadius="3" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1"/>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                                <Thumb x:Name="Scail2OutThumb" Width="14" Height="24"
                                                       HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="SizeWE"
                                                       DragDelta="Scail2OutThumb_DragDelta"
                                                       ToolTip="Drag to set the end (out) point">
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="{StaticResource DangerBrush}" CornerRadius="3" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"/>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Grid>

                                            <Grid Margin="0,8,0,0"
                                                  Visibility="{Binding HasInputVideo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="▶" Click="Scail2Play_Click"
                                                            Width="30" Height="26" FontSize="11" Margin="0,0,4,0"
                                                            Style="{StaticResource SecondaryButtonStyle}" Cursor="Hand"/>
                                                    <Button Content="⏸" Click="Scail2Pause_Click"
                                                            Width="30" Height="26" FontSize="11" Margin="0,0,10,0"
                                                            Style="{StaticResource SecondaryButtonStyle}" Cursor="Hand"/>
                                                    <Button Content="⟦ In" Command="{Binding MarkInCommand}"
                                                            Height="26" Padding="8,0" FontSize="11" FontWeight="Bold" Margin="0,0,4,0"
                                                            Style="{StaticResource SuccessButtonStyle}" Cursor="Hand"/>
                                                    <Button Content="Out ⟧" Command="{Binding MarkOutCommand}"
                                                            Height="26" Padding="8,0" FontSize="11" FontWeight="Bold" Margin="0,0,4,0"
                                                            Style="{StaticResource DangerButtonStyle}" Cursor="Hand"/>
                                                    <Button Content="Reset" Command="{Binding ResetTrimCommand}"
                                                            Height="26" Padding="8,0" FontSize="11" Margin="0,0,10,0"
                                                            Style="{StaticResource SecondaryButtonStyle}" Cursor="Hand"/>
                                                    <Button Content="📌 Use this frame" Command="{Binding UsePoseFrameCommand}"
                                                            Height="26" Padding="8,0" FontSize="11" FontWeight="Bold"
                                                            Style="{StaticResource AccentButtonStyle}" Cursor="Hand"
                                                            ToolTip="Pins the frame under the playhead as the pose source, like the Image Generator ▸ Advanced ▸ Control tab's 'Use This Frame'. Analyze and every Generate then work from this exact still, so re-runs keep the same pose."/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="ETA" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{Binding EstimatedTime}" FontSize="13" FontWeight="Bold"
                                                               FontFamily="Consolas" Foreground="{DynamicResource TabAccentBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{Binding TrimInfo}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                                       FontFamily="Consolas" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasInputVideo, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                            <!-- Pinned pose frame (the Control tab's "Use This Frame" still) -->
                                            <Grid Margin="0,8,0,0"
                                                  Visibility="{Binding HasInputVideo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="112" Height="64" CornerRadius="4"
                                                        Background="{StaticResource PlayerSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <TextBlock Text="🕴️" FontSize="20" Foreground="{StaticResource PlayerTextBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Visibility="{Binding NoPoseFrame, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <Image Source="{Binding PoseFrameSource}" Stretch="Uniform"/>
                                                        <Border Background="{StaticResource ScrimBrush}"
                                                                Visibility="{Binding IsGrabbingPoseFrame, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="⏳" Foreground="White" FontSize="14"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PoseFrameInfo}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap"/>
                                                    <Button Content="Unpin" Command="{Binding ClearPoseFrameCommand}"
                                                            HorizontalAlignment="Left" Height="22" Padding="8,0" FontSize="10"
                                                            Margin="0,5,0,0" Style="{StaticResource SecondaryButtonStyle}"
                                                            BorderThickness="0" Cursor="Hand"
                                                            ToolTip="Drop the pinned frame and go back to using whatever frame the playhead is on"
                                                            Visibility="{Binding HasPoseFrame, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- ═══ 2) Characters → Character image (Klein char-swap) ═══ -->
                                    <Border Style="{StaticResource SectionCardStyle}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource TabAccentBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="CHARACTERS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="Replace method" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <ComboBox SelectedIndex="{Binding CharReplaceMethodIndex, Mode=TwoWay}"
                                                              Width="190" Height="26" FontSize="10" VerticalContentAlignment="Center"
                                                              ToolTip="Which workflow the single-character 'Replace this one only' button runs. Klein Flux2 Control (default) holds the subject's likeness more accurately; Character Replacer is the legacy path; Krea2 Edit (two ref) keeps the base scene composition while swapping the subject in. 'Replace Both' always uses the 2-character replacer.">
                                                        <ComboBoxItem Content="🟢 Klein Flux2 Control"/>
                                                        <ComboBoxItem Content="⚪ Character Replacer (legacy)"/>
                                                        <ComboBoxItem Content="🔵 Krea2 Edit (two ref)"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Krea2 Edit (two ref) instruction prompt — only for that method -->
                                            <StackPanel Margin="0,0,0,10"
                                                        Visibility="{Binding IsKrea2EditSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="Edit instruction (Krea2 Edit)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding Krea2EditPrompt, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="10" MinHeight="46" TextWrapping="Wrap" AcceptsReturn="True"
                                                         VerticalScrollBarVisibility="Auto"
                                                         Padding="6"
                                                         ToolTip="Instruction written into the Krea2 Edit grounded-encode node. 'image a' is the base scene frame (person to replace); 'image b' is Character 1. Edit for either sex or extra guidance."/>
                                            </StackPanel>

                                            <!-- Klein Flux2 Control — the Image Generator ▸ Advanced ▸ Control flow:
                                                 Step 1 Analyze (QwenVL subject + pose) → Step 2 edit prompt → Step 3 Generate (repeatable) -->
                                            <StackPanel Margin="0,0,0,10"
                                                        Visibility="{Binding IsKleinControlSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock Text="Step 1 — Analyze pose + subject" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <Button Content="🔍 Analyze"
                                                            Command="{Binding AnalyzeKleinPromptCommand}"
                                                            HorizontalAlignment="Right" Height="24" Padding="14,0" FontSize="10"
                                                            Style="{StaticResource SuccessButtonStyle}"
                                                            ToolTip="Runs the Klein Flux2 Control workflow's QwenVL pass on Character 1 (appearance) and the pinned pose frame, then fills the box below with the combined prompt so you can edit it. The generated image is also adopted as the character image."/>
                                                </Grid>
                                                <TextBlock Text="Step 2 — Edit prompt" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,4"/>
                                                <TextBox Text="{Binding KleinControlPrompt, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="10" MinHeight="80" MaxHeight="180" TextWrapping="Wrap" AcceptsReturn="True"
                                                         VerticalScrollBarVisibility="Auto"
                                                         Padding="6"
                                                         ToolTip="Positive prompt for the Klein Flux2 Control generation. Leave empty to let the workflow write it from QwenVL (subject appearance + pose frame); anything here is used instead."/>
                                                <TextBlock Text="Leave empty to let QwenVL write the prompt during Generate."
                                                           FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,6"/>
                                                <Grid>
                                                    <TextBlock Text="Step 3 — Generate (press again for another take)"
                                                               FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                    <Button Content="🚀 Generate image"
                                                            Command="{Binding GenerateKleinImageCommand}"
                                                            HorizontalAlignment="Right" Height="24" Padding="14,0" FontSize="10"
                                                            Style="{StaticResource AccentButtonStyle}"
                                                            ToolTip="Sends the edited prompt to ComfyUI with Character 1 and the pinned pose frame, reseeding each run. Press it again if the first image isn't good enough — the result becomes the character image."/>
                                                </Grid>
                                                <ProgressBar Value="{Binding KleinProgress, Mode=OneWay}" Maximum="100" Height="4"
                                                             Margin="0,6,0,0" Foreground="{DynamicResource TabAccentBrush}"
                                                             BorderThickness="0"/>
                                            </StackPanel>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="1.4*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Character 1 -->
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <Border Height="110" CornerRadius="6" Background="{StaticResource PlayerSurfaceBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Cursor="Hand">
                                                        <Grid>
                                                            <TextBlock Text="＋ Character 1 (LEFT)" Foreground="{StaticResource PlayerTextBrush}" FontSize="11"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Visibility="{Binding NoChar1Image, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            <Image Source="{Binding Char1ImageSource}" Stretch="UniformToFill"/>
                                                            <Button Content="✕" Command="{Binding RemoveChar1Command}"
                                                                    Width="20" Height="20" Margin="0,3,3,0" Padding="0" FontSize="11"
                                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                    Background="{StaticResource ScrimBrush}" Foreground="White" BorderThickness="0"
                                                                    Cursor="Hand" ToolTip="Remove Character 1"
                                                                    Visibility="{Binding HasChar1Image, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        </Grid>
                                                    </Border>
                                                    <Button Content="Browse…" Command="{Binding BrowseChar1Command}"
                                                            Height="26" FontSize="10" Margin="0,5,0,0"
                                                            Style="{StaticResource SecondaryButtonStyle}" Cursor="Hand"/>
                                                    <Button Content="Replace this one only"
                                                            Command="{Binding SwapChar1OnlyCommand}"
                                                            Height="26" FontSize="10" Margin="0,4,0,0"
                                                            Style="{StaticResource AccentButtonStyle}"
                                                            ToolTip="Replace just one person in the pose frame with Character 1 (works for a man or a woman), then use the result as the character image. In Klein Flux2 Control mode this is the same as Step 3 — Generate image."/>
                                                </StackPanel>

                                                <!-- Character 2 -->
                                                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                                    <Border Height="110" CornerRadius="6" Background="{StaticResource PlayerSurfaceBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Cursor="Hand">
                                                        <Grid>
                                                            <TextBlock Text="＋ Character 2 (RIGHT)" Foreground="{StaticResource PlayerTextBrush}" FontSize="11"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Visibility="{Binding NoChar2Image, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            <Image Source="{Binding Char2ImageSource}" Stretch="UniformToFill"/>
                                                            <Button Content="✕" Command="{Binding RemoveChar2Command}"
                                                                    Width="20" Height="20" Margin="0,3,3,0" Padding="0" FontSize="11"
                                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                    Background="{StaticResource ScrimBrush}" Foreground="White" BorderThickness="0"
                                                                    Cursor="Hand" ToolTip="Remove Character 2"
                                                                    Visibility="{Binding HasChar2Image, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        </Grid>
                                                    </Border>
                                                    <Button Content="Browse…" Command="{Binding BrowseChar2Command}"
                                                            Height="26" FontSize="10" Margin="0,5,0,0"
                                                            Style="{StaticResource SecondaryButtonStyle}" Cursor="Hand"/>
                                                    <Button Content="Replace Both"
                                                            Command="{Binding SwapCharactersCommand}"
                                                            Height="26" FontSize="10" Margin="0,4,0,0"
                                                            Style="{StaticResource AccentButtonStyle}"
                                                            ToolTip="Replace both people in the current base frame with Character 1 (left) and Character 2 (right), then use the result as the character image"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="2" Text="→" FontSize="20" Foreground="{DynamicResource TabAccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                <!-- Character image (Klein composite) -->
                                                <StackPanel Grid.Column="3">
                                                    <Border Height="110" CornerRadius="6" Background="{StaticResource PlayerSurfaceBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                        <Grid>
                                                            <TextBlock Text="Character image"
                                                                       Foreground="{StaticResource PlayerTextBrush}" FontSize="11"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Visibility="{Binding NoCharSwapResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            <Image Source="{Binding CharSwapResultSource}" Stretch="Uniform"/>
                                                            <Border Background="{StaticResource ScrimBrush}"
                                                                    Visibility="{Binding IsCharSwapping, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBlock Text="⏳ working…" Foreground="White" FontSize="12"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <Button Content="Browse…" Command="{Binding BrowseFinalImageCommand}"
                                                            Height="26" FontSize="10" Margin="0,5,0,0"
                                                            Style="{StaticResource SecondaryButtonStyle}" Cursor="Hand"
                                                            ToolTip="Upload your own image to use as the final character image instead of running a swap"/>
                                                    <TextBlock Text="Built by Replace Both / Replace this one only, or upload your own" FontSize="9"
                                                               Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="{Binding CharSwapStatus}" FontSize="11" Foreground="{DynamicResource TabAccentBrush}"
                                                       TextWrapping="Wrap" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- ═══ 3) Generate progress / status ═══════════════════ -->
                                    <Border Style="{StaticResource SectionCardStyle}">
                                        <StackPanel>
                                            <ProgressBar Height="6" Margin="0,0,0,8"
                                                         Value="{Binding ProcessingProgress, Mode=OneWay}" Foreground="{DynamicResource TabAccentBrush}"
                                                         Visibility="{Binding IsProcessingQueue, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="Chunk size (VRAM)" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <ComboBox SelectedValue="{Binding VideoBatchSize, Mode=TwoWay}" SelectedValuePath="Tag"
                                                          Width="150" Height="24" FontSize="10" VerticalContentAlignment="Center"
                                                          ToolTip="Frames processed per internal chunk. The clip is generated in windows of this size (VRAM purged between them) then stitched into one video.&#10;&#10;Measured: lowering this does NOT prevent the crash seen at 1280 × 720 — a full-length clip died at both 40 and 17 frames, while 17 ran ~5× slower. Use the Resolution setting below to stay within memory; leave this at 40 unless you have a specific reason.">
                                                    <ComboBoxItem Content="24 — lowest VRAM"><ComboBoxItem.Tag><sys:Int32>24</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                                                    <ComboBoxItem Content="40 — recommended"><ComboBoxItem.Tag><sys:Int32>40</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                                                    <ComboBoxItem Content="60 — balanced"><ComboBoxItem.Tag><sys:Int32>60</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                                                    <ComboBoxItem Content="80 — most VRAM"><ComboBoxItem.Tag><sys:Int32>80</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="Resolution" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <ComboBox SelectedValue="{Binding OutputResolution, Mode=TwoWay}" SelectedValuePath="Tag"
                                                          Width="200" Height="24" FontSize="10" VerticalContentAlignment="Center"
                                                          ToolTip="Resolution the video is generated at.&#10;&#10;Auto keeps the source video's own aspect ratio at the same pixel budget as 960 × 544, so a portrait clip generates portrait and a landscape clip landscape. Leave it on Auto unless you deliberately want a different shape: a fixed preset crops the driving video to that aspect and crops the character image to match, and picking one that doesn't fit the source is what makes the output look stretched or cut off.&#10;&#10;Measured on a 24 GB card with a ~21s clip: the Auto/960 × 544 pixel budget completes in ~14 min; 1280 × 720 takes the ComfyUI server down mid-run (a hard process kill, not a recoverable error) on anything longer than a few seconds, at any chunk size. Memory use grows with clip LENGTH as well as resolution, so longer clips need a lower preset.">
                                                    <ComboBoxItem Content="Auto — match source video (recommended)" Tag="auto"/>
                                                    <ComboBoxItem Content="832 × 480 (landscape)" Tag="832x480"/>
                                                    <ComboBoxItem Content="768 × 768 (square)" Tag="768x768"/>
                                                    <ComboBoxItem Content="544 × 960 (portrait)" Tag="544x960"/>
                                                    <ComboBoxItem Content="1280 × 720 (720p — crashes on long clips)" Tag="1280x720"/>
                                                    <ComboBoxItem Content="720 × 1280 (720p portrait — crashes on long clips)" Tag="720x1280"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <CheckBox Content="Keep original background" IsChecked="{Binding KeepOriginalBackground, Mode=TwoWay}"
                                                      FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"
                                                      ToolTip="Replacement mode: composite the driving video's real background every frame and regenerate only the swapped character.&#10;&#10;Turn ON when the scene behind the person is real footage you want kept (e.g. a waterfall). Because the background is never generated, it can't colour-drift or soften across the internal chunks — the artefacts that appear ~20s into a long clip.&#10;&#10;Turn OFF (animation mode) to regenerate the whole frame, e.g. when re-lighting the character into a new environment."/>
                                            <CheckBox Content="Interpolate + RTX upscale (2× fps, 2× size)" IsChecked="{Binding InterpolateAndUpscale, Mode=TwoWay}"
                                                      FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"
                                                      ToolTip="Runs the workflow's post pass after generation: RIFE frame interpolation (2× the frame rate) followed by the RTX Video Super Resolution upscale (2× the resolution).&#10;&#10;A 960 × 544 clip at 16 fps comes out 1920 × 1088 at 32 fps. It adds a noticeable amount of time to every run and needs the RIFE VFI and NVIDIA RTX (nvidia-vfx) custom nodes installed on the server, so it's off by default — with it off the raw sampler output is saved instead."/>
                                            <Grid>
                                                <TextBlock Text="{Binding ProcessingStatus}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <Button Content="⚡ Generate video" HorizontalAlignment="Right"
                                                        Click="Scail2Process_Click" Height="30" Padding="14,0" FontSize="11"
                                                        FontWeight="Bold" Style="{StaticResource SuccessButtonStyle}"
                                                        BorderThickness="0" Cursor="Hand"
                                                        IsEnabled="{Binding CanAddToQueue}"
                                                        ToolTip="Analyzes the marked In/Out range and generates the SCAIL II video. Build the character image first."/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- ═══ 4) Result ═══════════════════════════════════════ -->
                                    <Border Style="{StaticResource SectionCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="🎥 RESULT" FontSize="12" FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                            <Border Background="{StaticResource PlayerSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    Height="200" CornerRadius="6" Margin="0,0,0,8">
                                                <Grid>
                                                    <TextBlock Text="The motion-transfer video will appear here"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{StaticResource PlayerTextBrush}" FontStyle="Italic">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasResult}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <MediaElement x:Name="Scail2VideoPlayer"
                                                                  Source="{Binding ResultVideoPath}"
                                                                  LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                                  Stretch="Uniform"
                                                                  Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="▶ Play" Command="{Binding PlayVideoCommand}"
                                                        IsEnabled="{Binding HasResult}" Height="30" Padding="14,0" FontSize="11"
                                                        Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0"/>
                                                <Button Content="📁 Open folder" Command="{Binding OpenResultFolderCommand}"
                                                        IsEnabled="{Binding HasResult}" Height="30" Padding="14,0" FontSize="11"
                                                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                                                <Button Content="📷 Send to Edit Camera" Command="{Binding SendToEditCameraCommand}"
                                                        IsEnabled="{Binding HasResult}" Height="30" Padding="14,0" FontSize="11"
                                                        Style="{StaticResource SecondaryButtonStyle}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ResultVideoInfo}" FontStyle="Italic"
                                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- ═══ Log ═════════════════════════════════════════════ -->
                                    <Expander Header="📝 Log" IsExpanded="False" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4">
                                        <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                                            <TextBox Text="{Binding LogOutput, Mode=OneWay}"
                                                     TextWrapping="Wrap" IsReadOnly="True"
                                                     FontFamily="Consolas" FontSize="10"
                                                     Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0" Padding="10"/>
                                        </ScrollViewer>
                                    </Expander>

                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

<!-- ═══════════════════════════════════════════════════════════════════════
                         H3 EROS — the H3 Experimental story flow (story in,
                         wardrobe locked, cast sheets split into panels, the
                         H3 Prompt Writer tool loop, the clip queue, the
                         FFmpeg join) rendered through the author's MiniMax
                         SEEDHUNTER v122 EROS-Hybrid graph, which makes every
                         clip a seed hunt.

                         One conditioning and one latent, sampled THREE times
                         at a small draft canvas. That runs for EVERY clip in
                         the queue back to back, without stopping, so a
                         twelve-clip story arrives as a board of thirty-six
                         takes rather than twelve interruptions.

                         Then you pick, and only the picked takes are finished:
                         each one's LATENT is lifted to the finished megapixels
                         by the MiniMax H3 3D latent upscaler, re-sampled by a
                         short fixed-sigma pass, interpolated by RIFE and muxed
                         — and the chain is FFmpeg-joined when its last clip
                         lands.

                         No GPU is held while the board is being looked at.
                         ═══════════════════════════════════════════════════════════════════════ -->

                    <TabItem Header="🌹🎯 H3 Eros">
                        <!-- Named so the per-character cards, whose DataContext is a CharacterSlot, can
                             still reach the tab's own commands. -->
                        <Grid x:Name="H3ErosRoot" DataContext="{Binding H3ErosVM}" Style="{StaticResource TabPageStyle}">
                            <Grid.Resources>
                                <SolidColorBrush x:Key="TabAccentBrush" Color="{StaticResource AccentRoseColor}"/>
                            </Grid.Resources>
                            <!-- The rail's column is Auto, not 340, so folding the Border away really
                                 gives its width to the board rather than leaving a 340px hole. -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ═══ LEFT PANEL ═══════════════════════════════════════════════ -->
                            <Border Grid.Column="0" Width="340" Style="{StaticResource TabSideRailStyle}"
                                    Visibility="{Binding IsSidePanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="12">

                                        <!-- Scene & story: two ways in, either one is enough.
                                             The image (never uploaded) carries setting, light and
                                             wardrobe; the story carries what happens. With no image
                                             the request goes to the llama-server as plain text. -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="SCENE &amp; STORY" Note="  · either one is enough — and the wardrobe comes from it" Margin="0,0,0,10"/>

                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="124"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Scene image -->
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Scene image" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                                                Background="{StaticResource SurfaceAltBrush}" Height="126" Margin="0,0,0,6">
                                                            <Grid>
                                                                <TextBlock Text="Optional"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextMutedBrush}" FontSize="10">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding SceneImagePreview}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <Image Source="{Binding SceneImagePreview}" Stretch="Uniform"/>
                                                            </Grid>
                                                        </Border>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button Grid.Column="0" Content="Browse…"
                                                                    Command="{Binding SelectSceneImageCommand}"
                                                                    Height="26" Padding="6,0" FontSize="11" Margin="0,0,4,0"
                                                                    Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                            <Button Grid.Column="1" Content="✕"
                                                                    Command="{Binding ClearSceneImageCommand}"
                                                                    IsEnabled="{Binding HasSceneImage}"
                                                                    Height="26" Width="26" FontSize="11"
                                                                    ToolTip="Drop the scene image and work from the story alone."
                                                                    Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding SceneImageInfo}" FontSize="9" Margin="0,4,0,0"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <!-- Story text -->
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Story" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                        <TextBox Text="{Binding StoryText, UpdateSourceTrigger=PropertyChanged}"
                                                                 TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="False"
                                                                 Height="126" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6"
                                                                 BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                                 FontSize="11" Padding="6"
                                                                 ToolTip="Type or paste the story the video tells. With a scene image it says what happens in it; on its own it is the whole brief — Analyze then works from the text alone and writes the setting, lighting and wardrobe out of the prose, casting &lt;Picture 1&gt; and &lt;Picture 2&gt; in the story's roles."/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button Grid.Column="0" Content="📄 Load .txt"
                                                                    Command="{Binding LoadStoryCommand}"
                                                                    Height="26" Padding="6,0" FontSize="11" Margin="0,0,4,0"
                                                                    Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                                    ToolTip="Read a story out of a .txt or .md file into the box."/>
                                                            <Button Grid.Column="1" Content="✕"
                                                                    Command="{Binding ClearStoryCommand}"
                                                                    Height="26" Width="26" FontSize="11"
                                                                    ToolTip="Empty the story box."
                                                                    Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="{Binding StorySourceSummary}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                                                <!-- Wardrobe. Decided once and written into every clip's
                                                     prompt verbatim: the clips are generated separately from
                                                     text written block by block, so an outfit left to the
                                                     prose is re-invented every few clips. -->
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Wardrobe — derived from the story"
                                                               FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <Button Grid.Column="1" Content="{Binding WardrobeLockButtonText}"
                                                            Command="{Binding ToggleWardrobeLockCommand}"
                                                            Height="24" Padding="8,0" FontSize="10" Margin="0,0,4,0"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            ToolTip="Locked, the wardrobe is the story's: it is rewritten whenever the story, the scene image or the cast changes, and cannot be typed over.&#x0a;&#x0a;Unlock to dress the cast yourself — your text then stands, and the story stops rewriting it until you lock it again."/>
                                                    <Button Grid.Column="2" Content="🎽 Derive"
                                                            Command="{Binding DeriveWardrobeCommand}"
                                                            Height="24" Padding="8,0" FontSize="10" Margin="0,0,4,0"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            ToolTip="Re-rolls the outfits now, without waiting for the story to change — off the scene image if there is one, otherwise out of the story.&#x0a;&#x0a;It always writes an outfit for BOTH characters, whether or not their photos have been picked yet: the wardrobe is a decision about the story, and a second character's line is simply left out of any clip they are not in. The sheets are built from whatever is in this box, so derive before you build them."/>
                                                    <Button Grid.Column="3" Content="✕"
                                                            Command="{Binding ClearWardrobeCommand}"
                                                            Height="24" Width="24" FontSize="10"
                                                            ToolTip="Empty the wardrobe box and let the story write a fresh one."
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                </Grid>
                                                <TextBox Text="{Binding CastWardrobe, UpdateSourceTrigger=PropertyChanged}"
                                                         IsReadOnly="{Binding IsWardrobeLocked}"
                                                         TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="False"
                                                         Height="64" VerticalScrollBarVisibility="Auto" Margin="0,0,0,4"
                                                         BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                         FontSize="11" Padding="6"
                                                         ToolTip="One line per character, naming every garment. It is written from the story a couple of seconds after you stop typing, and it is what the character sheets are generated in AND what every clip's prompt quotes — the picture and the words then agree, which is what stops the cast changing outfits between clips.&#x0a;&#x0a;Read-only while locked; press 🔒 to take it over."/>
                                                <TextBlock Text="{Binding WardrobeSummary}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Cast: photo in, sheet out -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="CAST" Note="  · one photo per character, dressed from the wardrobe above" Margin="0,0,0,10"/>

                                                <!-- Character 1 -->
                                                <StackPanel DataContext="{Binding Character1}" Margin="0,0,0,10">
                                                    <!-- The sex is a real input, not a label: it goes into the
                                                         wardrobe request, into the sheet builder's instruction
                                                         and into the reference line H3 reads. -->
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11" FontWeight="Bold"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        <ComboBox Grid.Column="1" ItemsSource="{Binding SexOptions}"
                                                                  SelectedItem="{Binding Sex, Mode=TwoWay}"
                                                                  Width="86" Height="24" FontSize="10"
                                                                  ToolTip="Male or female. The wardrobe pass dresses this character accordingly, the character sheet is generated as that person, and the prompt names them so H3 uses the right pronouns."/>
                                                    </Grid>
                                                    <!-- Part — who this character is in the story. Filled by the story's
                                                         automatic cast; see H3CastViewModel.Cast.cs. -->
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Part" FontSize="10" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                                                        <TextBox Grid.Column="1"
                                                                 Text="{Binding Role, UpdateSourceTrigger=LostFocus}"
                                                                 Height="24" FontSize="10" Padding="5,0"
                                                                 VerticalContentAlignment="Center"
                                                                 BorderBrush="{StaticResource BorderBrush}" Background="White"
                                                                 ToolTip="Who this character is in the story — &quot;the detective&quot;, &quot;her younger brother&quot;. A pasted or loaded story fills this in automatically; edit it freely — the tab never overwrites a card you have made your own. It reaches the wardrobe pass and the ✨ Generate button, so the photo and the outfit match the part."/>
                                                    </Grid>
                                                    <TextBlock Text="&lt;Picture 1&gt; · the first reference H3 receives"
                                                               FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="98"/>
                                                            <ColumnDefinition Width="6"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Source photo -->
                                                        <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                                CornerRadius="6" Background="{StaticResource SurfaceAltBrush}" Height="92"
                                                                Style="{StaticResource CastThumbnailStyle}" Tag="{Binding SourcePath}">
                                                            <Grid>
                                                                <TextBlock Text="Photo"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextMutedBrush}" FontSize="10">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding SourcePreview}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <Image Source="{Binding SourcePreview}" Stretch="Uniform"/>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Built sheet -->
                                                        <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                                CornerRadius="6" Background="{StaticResource SurfaceAltBrush}" Height="92"
                                                                Style="{StaticResource CastThumbnailStyle}" Tag="{Binding SheetPath}">
                                                            <Grid>
                                                                <TextBlock Text="Sheet → H3"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextMutedBrush}" FontSize="10">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding SheetPreview}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <Image Source="{Binding SheetPreview}" Stretch="Uniform"/>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>

                                                    <Button Content="Browse…"
                                                            Command="{Binding DataContext.SelectCharacter1Command, ElementName=H3ErosRoot}"
                                                            Height="26" Padding="8,0" FontSize="11" Margin="0,6,0,0"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                    <!-- ✨ Generate — this character's photo, rendered by one of the Image
                                                         Generator's base workflows instead of browsed for. -->
                                                    <Button Content="✨ Generate photo ▾" Margin="0,4,0,0"
                                                            Click="CastGenerateButton_Click"
                                                            Tag="{Binding DataContext, ElementName=H3ErosRoot}"
                                                            IsEnabled="{Binding CanGeneratePhoto}"
                                                            Height="26" Padding="8,0" FontSize="11"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            ToolTip="Generates this character's photo instead of browsing for one — their Part and the locked wardrobe become the prompt, and the result lands in this card as if it had been browsed. Z-Image, Z-Famegrid and Krea2 open into a LoRA list (the same folders the Image Generator reads); Krea2-Spicy's and Qwen 2.5.1.2's LoRAs are baked into their workflows.&#x0a;&#x0a;Needs the character to be described first: a Part on the card, or the story's automatic cast. The character sheet is not built until you press 🪪 Build Character Sheet, so you can re-generate or swap photos first.">
                                                        <!-- Tag carries the tab's ViewModel across the ContextMenu boundary;
                                                             the card's DataContext is the CharacterSlot each command takes. -->
                                                        <Button.ContextMenu>
                                                            <!-- The menu remembers whose card it opened on: the window sets
                                                                 CastPhotoMenuSlot as it opens. -->
                                                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                                                                         Opened="CastPhotoMenu_Opened">
                                                                <MenuItem Header="Z-Image ▸ pick the LoRA" ItemsSource="{Binding CastZimageLoraMenu}">
                                                                    <MenuItem.ItemContainerStyle>
                                                                        <Style TargetType="MenuItem">
                                                                            <Setter Property="Header" Value="{Binding Name}"/>
                                                                            <Setter Property="Command"
                                                                                    Value="{Binding DataContext.GenerateCastZimageLoraCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                                            <Setter Property="CommandParameter" Value="{Binding}"/>
                                                                        </Style>
                                                                    </MenuItem.ItemContainerStyle>
                                                                </MenuItem>
                                                                <MenuItem Header="Z-Famegrid ▸ pick the LoRA" ItemsSource="{Binding CastFamegridLoraMenu}">
                                                                    <MenuItem.ItemContainerStyle>
                                                                        <Style TargetType="MenuItem">
                                                                            <Setter Property="Header" Value="{Binding Name}"/>
                                                                            <Setter Property="Command"
                                                                                    Value="{Binding DataContext.GenerateCastFamegridLoraCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                                            <Setter Property="CommandParameter" Value="{Binding}"/>
                                                                        </Style>
                                                                    </MenuItem.ItemContainerStyle>
                                                                </MenuItem>
                                                                <MenuItem Header="Krea2 ▸ pick the LoRA" ItemsSource="{Binding CastKrea2LoraMenu}">
                                                                    <MenuItem.ItemContainerStyle>
                                                                        <Style TargetType="MenuItem">
                                                                            <Setter Property="Header" Value="{Binding Name}"/>
                                                                            <Setter Property="Command"
                                                                                    Value="{Binding DataContext.GenerateCastKrea2LoraCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                                            <Setter Property="CommandParameter" Value="{Binding}"/>
                                                                        </Style>
                                                                    </MenuItem.ItemContainerStyle>
                                                                </MenuItem>
                                                                <MenuItem Header="Krea2-Spicy — spicy mirror-selfie look"
                                                                          Command="{Binding GenerateCastKrea2SpicyCommand}"
                                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                                <MenuItem Header="Qwen 2.5.1.2 — detailed illustration"
                                                                          Command="{Binding GenerateCastQwenCommand}"
                                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                    </Button>
                                                    <TextBlock Text="{Binding PhotoPhase}" FontSize="9" Margin="0,3,0,0"
                                                               Foreground="{DynamicResource TabAccentBrush}" FontStyle="Italic"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <CheckBox Content="This image is already a character sheet"
                                                              IsChecked="{Binding UseSourceAsSheet}"
                                                              IsEnabled="{Binding HasSource}"
                                                              FontSize="10" Margin="0,6,0,0"
                                                              Foreground="{StaticResource TextSecondaryBrush}"
                                                              ToolTip="Skip the Qwen pass and send the loaded image to H3 as it is."/>
                                                    <Grid Margin="0,6,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Panels" FontSize="10" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                                                        <ComboBox Grid.Column="1" ItemsSource="{Binding PanelSplitOptions}"
                                                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                                                  SelectedValue="{Binding SelectedPanelSplit, Mode=TwoWay}"
                                                                  IsEnabled="{Binding HasSheet}" Height="24" FontSize="10"
                                                                  ToolTip="H3 conditions on each reference image as ONE subject, so a three-panel sheet handed over whole is a three-panel grid it will happily render into the video — the same person standing next to themselves against a studio wall.&#x0a;&#x0a;The sheet is therefore cut back into its separate views before it is sent, one reference per view. Auto looks for the background gaps between the figures; a number splits evenly; Whole sheet is the old single-collage behaviour, kept for comparison."/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding SheetStatus}" FontSize="9" Margin="0,4,0,0"
                                                               Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding PanelStatus}" FontSize="9" Margin="0,2,0,0"
                                                               Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                               TextWrapping="Wrap"/>
                                                    <!-- The outfit this character's sheet is (or will be) built in. -->
                                                    <TextBlock Text="{Binding ExpectedWardrobe, StringFormat=👗 {0}}"
                                                               Visibility="{Binding ExpectedWardrobe, Converter={StaticResource StringToVisibilityConverter}}"
                                                               FontSize="9" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource TabAccentBrush}" FontStyle="Italic"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <!-- Character 2 -->
                                                <StackPanel DataContext="{Binding Character2}" Margin="0,0,0,8">
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11" FontWeight="Bold"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        <ComboBox Grid.Column="1" ItemsSource="{Binding SexOptions}"
                                                                  SelectedItem="{Binding Sex, Mode=TwoWay}"
                                                                  Width="86" Height="24" FontSize="10"
                                                                  ToolTip="Male or female. The wardrobe pass dresses this character accordingly, the character sheet is generated as that person, and the prompt names them so H3 uses the right pronouns."/>
                                                    </Grid>
                                                    <!-- Part — who this character is in the story. Filled by the story's
                                                         automatic cast; see H3CastViewModel.Cast.cs. -->
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Part" FontSize="10" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                                                        <TextBox Grid.Column="1"
                                                                 Text="{Binding Role, UpdateSourceTrigger=LostFocus}"
                                                                 Height="24" FontSize="10" Padding="5,0"
                                                                 VerticalContentAlignment="Center"
                                                                 BorderBrush="{StaticResource BorderBrush}" Background="White"
                                                                 ToolTip="Who this character is in the story — &quot;the detective&quot;, &quot;her younger brother&quot;. A pasted or loaded story fills this in automatically; edit it freely — the tab never overwrites a card you have made your own. It reaches the wardrobe pass and the ✨ Generate button, so the photo and the outfit match the part."/>
                                                    </Grid>
                                                    <TextBlock Text="&lt;Picture 2&gt; · optional — leave empty for a one-character video"
                                                               FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="98"/>
                                                            <ColumnDefinition Width="6"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                                CornerRadius="6" Background="{StaticResource SurfaceAltBrush}" Height="92"
                                                                Style="{StaticResource CastThumbnailStyle}" Tag="{Binding SourcePath}">
                                                            <Grid>
                                                                <TextBlock Text="Photo"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextMutedBrush}" FontSize="10">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding SourcePreview}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <Image Source="{Binding SourcePreview}" Stretch="Uniform"/>
                                                            </Grid>
                                                        </Border>

                                                        <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                                CornerRadius="6" Background="{StaticResource SurfaceAltBrush}" Height="92"
                                                                Style="{StaticResource CastThumbnailStyle}" Tag="{Binding SheetPath}">
                                                            <Grid>
                                                                <TextBlock Text="Sheet → H3"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextMutedBrush}" FontSize="10">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding SheetPreview}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <Image Source="{Binding SheetPreview}" Stretch="Uniform"/>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>

                                                    <Grid Margin="0,6,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button Grid.Column="0" Content="Browse…"
                                                                Command="{Binding DataContext.SelectCharacter2Command, ElementName=H3ErosRoot}"
                                                                Height="26" Padding="8,0" FontSize="11" Margin="0,0,4,0"
                                                                Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                        <Button Grid.Column="1" Content="✕"
                                                                Command="{Binding DataContext.ClearCharacter2Command, ElementName=H3ErosRoot}"
                                                                IsEnabled="{Binding HasSource}"
                                                                Height="26" Width="26" FontSize="11"
                                                                ToolTip="Clear the second character and run as a single-reference scene."
                                                                Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                    </Grid>
                                                    <!-- ✨ Generate — this character's photo, rendered by one of the Image
                                                         Generator's base workflows instead of browsed for. -->
                                                    <Button Content="✨ Generate photo ▾" Margin="0,4,0,0"
                                                            Click="CastGenerateButton_Click"
                                                            Tag="{Binding DataContext, ElementName=H3ErosRoot}"
                                                            IsEnabled="{Binding CanGeneratePhoto}"
                                                            Height="26" Padding="8,0" FontSize="11"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            ToolTip="Generates this character's photo instead of browsing for one — their Part and the locked wardrobe become the prompt, and the result lands in this card as if it had been browsed. Z-Image, Z-Famegrid and Krea2 open into a LoRA list (the same folders the Image Generator reads); Krea2-Spicy's and Qwen 2.5.1.2's LoRAs are baked into their workflows.&#x0a;&#x0a;Needs the character to be described first: a Part on the card, or the story's automatic cast. The character sheet is not built until you press 🪪 Build Character Sheet, so you can re-generate or swap photos first.">
                                                        <!-- Tag carries the tab's ViewModel across the ContextMenu boundary;
                                                             the card's DataContext is the CharacterSlot each command takes. -->
                                                        <Button.ContextMenu>
                                                            <!-- The menu remembers whose card it opened on: the window sets
                                                                 CastPhotoMenuSlot as it opens. -->
                                                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                                                                         Opened="CastPhotoMenu_Opened">
                                                                <MenuItem Header="Z-Image ▸ pick the LoRA" ItemsSource="{Binding CastZimageLoraMenu}">
                                                                    <MenuItem.ItemContainerStyle>
                                                                        <Style TargetType="MenuItem">
                                                                            <Setter Property="Header" Value="{Binding Name}"/>
                                                                            <Setter Property="Command"
                                                                                    Value="{Binding DataContext.GenerateCastZimageLoraCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                                            <Setter Property="CommandParameter" Value="{Binding}"/>
                                                                        </Style>
                                                                    </MenuItem.ItemContainerStyle>
                                                                </MenuItem>
                                                                <MenuItem Header="Z-Famegrid ▸ pick the LoRA" ItemsSource="{Binding CastFamegridLoraMenu}">
                                                                    <MenuItem.ItemContainerStyle>
                                                                        <Style TargetType="MenuItem">
                                                                            <Setter Property="Header" Value="{Binding Name}"/>
                                                                            <Setter Property="Command"
                                                                                    Value="{Binding DataContext.GenerateCastFamegridLoraCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                                            <Setter Property="CommandParameter" Value="{Binding}"/>
                                                                        </Style>
                                                                    </MenuItem.ItemContainerStyle>
                                                                </MenuItem>
                                                                <MenuItem Header="Krea2 ▸ pick the LoRA" ItemsSource="{Binding CastKrea2LoraMenu}">
                                                                    <MenuItem.ItemContainerStyle>
                                                                        <Style TargetType="MenuItem">
                                                                            <Setter Property="Header" Value="{Binding Name}"/>
                                                                            <Setter Property="Command"
                                                                                    Value="{Binding DataContext.GenerateCastKrea2LoraCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                                            <Setter Property="CommandParameter" Value="{Binding}"/>
                                                                        </Style>
                                                                    </MenuItem.ItemContainerStyle>
                                                                </MenuItem>
                                                                <MenuItem Header="Krea2-Spicy — spicy mirror-selfie look"
                                                                          Command="{Binding GenerateCastKrea2SpicyCommand}"
                                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                                <MenuItem Header="Qwen 2.5.1.2 — detailed illustration"
                                                                          Command="{Binding GenerateCastQwenCommand}"
                                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                    </Button>
                                                    <TextBlock Text="{Binding PhotoPhase}" FontSize="9" Margin="0,3,0,0"
                                                               Foreground="{DynamicResource TabAccentBrush}" FontStyle="Italic"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <CheckBox Content="This image is already a character sheet"
                                                              IsChecked="{Binding UseSourceAsSheet}"
                                                              IsEnabled="{Binding HasSource}"
                                                              FontSize="10" Margin="0,6,0,0"
                                                              Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <Grid Margin="0,6,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Panels" FontSize="10" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                                                        <ComboBox Grid.Column="1" ItemsSource="{Binding PanelSplitOptions}"
                                                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                                                  SelectedValue="{Binding SelectedPanelSplit, Mode=TwoWay}"
                                                                  IsEnabled="{Binding HasSheet}" Height="24" FontSize="10"
                                                                  ToolTip="How this character's sheet is cut into separate reference images before it is sent to H3. Auto finds the gaps between the figures."/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding SheetStatus}" FontSize="9" Margin="0,4,0,0"
                                                               Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding PanelStatus}" FontSize="9" Margin="0,2,0,0"
                                                               Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                               TextWrapping="Wrap"/>
                                                    <!-- The outfit this character's sheet is (or will be) built in. -->
                                                    <TextBlock Text="{Binding ExpectedWardrobe, StringFormat=👗 {0}}"
                                                               Visibility="{Binding ExpectedWardrobe, Converter={StaticResource StringToVisibilityConverter}}"
                                                               FontSize="9" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource TabAccentBrush}" FontStyle="Italic"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <Button Content="{Binding BuildSheetsButtonText}"
                                                        Command="{Binding BuildSheetsCommand}"
                                                        IsEnabled="{Binding CanBuildSheets}"
                                                        Height="32" FontSize="11" Margin="0,0,0,6"
                                                        Style="{StaticResource AccentButtonStyle}"
                                                        ToolTip="Runs Qwen-Image-Edit-2511 (int8 convrot, 8-step Lightning) once per character and turns each photo into a three-panel reference sheet on a plain studio background: full-body front, full-body back, face close-up. That sheet — not the photo — is what MiniMax H3 receives, which is how one image can carry silhouette, hair from behind and facial identity at once.&#x0a;&#x0a;The sheet is generated with the character wearing the locked wardrobe, so the reference photographs and every clip's prompt describe the same clothes. Change the wardrobe and the sheets must be rebuilt — the cast card says so when they no longer match.&#x0a;&#x0a;Safe to press while a video is rendering: it waits for the GPU and runs as soon as that job lets go, so the next pair of characters can be prepared without stopping the queue."/>

                                                <!-- The builder's own status line: a render underneath owns
                                                     the tab's status bar and progress bar. -->
                                                <TextBlock Text="{Binding SheetPhase}"
                                                           Visibility="{Binding IsBuildingSheets, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                           FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"
                                                           Foreground="{DynamicResource TabAccentBrush}"
                                                           TextWrapping="Wrap"/>

                                                <TextBlock Text="{Binding CastSummary}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap"/>

                                                <!-- Which <Picture n> maps to whom once the sheets are split. -->
                                                <TextBlock Text="{Binding PanelPlanSummary}"
                                                           FontSize="10" Margin="0,6,0,0"
                                                           Foreground="{DynamicResource TabAccentBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap"/>

                                                <!-- The writer's own controls sit under the cast, which
                                                     is the order the tab is used in: story, wardrobe,
                                                     cast, sheets, then write the chain those sheets
                                                     will be rendered against.
                                                     Total video length: H3 tops out at ~15s per pass,
                                                     so anything longer is written as a chain of clips
                                                     and queued one job per clip, same sheets
                                                     throughout. -->
                                                <Grid Margin="0,14,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Video length" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            CornerRadius="4" Padding="10,2">
                                                        <TextBlock Text="{Binding StoryDurationSeconds, StringFormat={}{0:0} s}"
                                                                   FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TabAccentBrush}"/>
                                                    </Border>
                                                </Grid>
                                                <Slider Value="{Binding StoryDurationSeconds}"
                                                        Minimum="5" Maximum="120"
                                                        TickFrequency="5" IsSnapToTickEnabled="True"
                                                        SmallChange="5" LargeChange="15"
                                                        Foreground="{DynamicResource TabAccentBrush}" Margin="0,0,0,4"
                                                        ToolTip="Length of the finished video, in 5-second steps up to 2 minutes. MiniMax H3 renders at most ~15s per pass, so anything longer is written as a chain of consecutive clips — Analyze writes them all in one reply, Add to Queue enqueues one job per clip against the same character sheets, and they are joined into a single file when the last one lands."/>
                                                <TextBlock Text="{Binding ClipPlanSummary}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                                                <!-- The medium the writer works in. Left on Auto it
                                                     picks, and it used to pick gacha anime almost every
                                                     time whatever the story was. -->
                                                <TextBlock Text="Visual style" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding VisualStyleOptions}"
                                                          DisplayMemberPath="Name"
                                                          SelectedItem="{Binding VisualStyle, Mode=TwoWay}"
                                                          Height="30" FontSize="11" Margin="0,0,0,4"
                                                          ToolTip="The medium every clip is written in. The style words open [Shot 1], which is the only place MiniMax H3 reads the look of the video from &#x2014; so the choice here is handed to the prompt writer as settled fact and copied verbatim into every clip of a chain, exactly the way the wardrobe is.&#x0a;&#x0a;Auto leaves it to the writer, which is what this tab did before: it reads the medium off the scene image where there is one and off the story where there is not."/>
                                                <TextBlock Text="{Binding VisualStyleSummary}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="🔍 Analyze → H3 Prompt"
                                                            Command="{Binding AnalyzeCommand}"
                                                            IsEnabled="{Binding CanAnalyze}"
                                                            Height="32" Padding="14,0" FontSize="11"
                                                            Style="{StaticResource AccentButtonStyle}"
                                                            ToolTip="Sends whatever is loaded — the scene image, the story, or both — to the llama-server with texttovideoH3.md and writes a dense multi-shot H3 prompt in which the cast is named only as &lt;Picture 1&gt; / &lt;Picture 2&gt; and framed so faces stay readable. The locked wardrobe above is handed to it as settled fact, so no clip picks its own outfit."/>
                                                    <TextBlock FontStyle="Italic" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"
                                                               Text="{Binding AnalyzeBusyText}" Foreground="{DynamicResource TabAccentBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAnalyzing}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Prompt -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="H3 PROMPT" Note="  · draft idea, or the full prompt"/>
                                                <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                                                         TextWrapping="Wrap" AcceptsReturn="True"
                                                         Height="240" VerticalScrollBarVisibility="Auto"
                                                         BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                         FontSize="11" Padding="8"/>

                                                <!-- Prompt library: every chain the writer finishes, and
                                                     every chain that reaches the queue, is filed
                                                     automatically; this row is how they come back out —
                                                     re-cast for whoever is loaded then. -->
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0"
                                                            Content="{Binding ChainLibraryLabel}"
                                                            Command="{Binding OpenChainLibraryCommand}"
                                                            Height="28" Padding="10,0" FontSize="11" Margin="0,0,6,0"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            ToolTip="Browse the story chains this tab has saved and put one back in the prompt box, with the story it was written from and the clip plan it was written against.&#x0a;&#x0a;Chains are stored as clip bodies with no cast preamble, so a story written for one cast can be rendered later with another: the reference line and the wardrobe block are written fresh from the characters loaded at the time. The saved take's own cast and wardrobe are NOT restored.&#x0a;&#x0a;Entries can be renamed, edited and deleted in the picker."/>
                                                    <Button Grid.Column="1" Content="&#x1F4BE; Save"
                                                            Command="{Binding SaveChainCommand}"
                                                            Height="28" Width="76" FontSize="11"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            ToolTip="File the chain in the prompt box now. Analyzed and queued chains are saved automatically — this is for one you have edited here and do not intend to queue yet."/>
                                                </Grid>

                                                <!-- What Add to Queue will actually enqueue: the chain is
                                                     split on its headers, so hand-edits here are honoured. -->
                                                <TextBlock Text="{Binding PromptClipSummary}"
                                                           Visibility="{Binding HasPromptSequence, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                           FontSize="10" FontWeight="SemiBold" Margin="0,6,0,0"
                                                           Foreground="{DynamicResource TabAccentBrush}" TextWrapping="Wrap"/>

                                                <TextBlock Text="The sheet reference line is rewritten automatically to match how many characters are loaded, which sex each of them is, and whether their sheets were built in the locked wardrobe — when they were, it tells H3 to copy the clothing out of the references rather than ignore it. The studio background is discarded either way."
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic" Margin="0,6,0,0"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Settings -->
                                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="14">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="SETTINGS" Margin="0,0,0,10"/>

                                                <!-- Which H3 checkpoint the hunt and the finish sample
                                                     with. The list is whatever the connected ComfyUI
                                                     reports under diffusion_models/h3-minimax, so
                                                     dropping a model in and pressing the refresh button
                                                     is enough. The choice is saved, and it is frozen onto
                                                     every queue item, so a story queued on one model is
                                                     finished on that same model. -->
                                                <TextBlock Text="Model" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox Grid.Column="0"
                                                              ItemsSource="{Binding DiffusionModelOptions}"
                                                              DisplayMemberPath="Label"
                                                              SelectedValuePath="Value"
                                                              SelectedValue="{Binding SelectedDiffusionModel}"
                                                              Height="30" FontSize="11" Margin="0,0,6,0"
                                                              ToolTip="The diffusion model both sweeps load, from diffusion_models/h3-minimax on the ComfyUI server. Change it to run the same story through a different H3 checkpoint and compare the takes side by side; the choice is remembered across restarts.&#x0a;&#x0a;It is frozen onto each clip when you press Add to Queue — the finish re-samples the picked draft's own branch, so a queue hunted on one model is always finished on that same model even if you change this afterwards.&#x0a;&#x0a;This graph drives MiniMaxH3ReferenceToVideo. A checkpoint trained only for first/last-frame work (fl2va) may render noise through it — hunt a single clip before committing a story to one."/>
                                                    <Button Grid.Column="1" Content="&#x27F3;" Width="30" Height="30" FontSize="13"
                                                            Command="{Binding RefreshDiffusionModelsCommand}"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            ToolTip="Re-read diffusion_models/h3-minimax from ComfyUI — after dropping a new model into the folder, or after the server was restarted."/>
                                                </Grid>
                                                <TextBlock Text="{Binding DiffusionModelSummary}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                                                <TextBlock Text="Aspect ratio" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding AspectRatioOptions}"
                                                          SelectedItem="{Binding SelectedAspectRatio}"
                                                          Height="30" FontSize="11" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding ResolvedAspectRatio, StringFormat=→ {0}}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic" Margin="0,0,0,10"/>

                                                <TextBlock Text="Quality (canvas size)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding MegapixelOptions}"
                                                          DisplayMemberPath="Label"
                                                          SelectedValuePath="Value"
                                                          SelectedValue="{Binding Megapixels}"
                                                          Height="30" FontSize="11" Margin="0,0,0,8"/>

                                                <!-- The I2V graph scales references to the DRAFT canvas under
                                                     'match' — a quarter of the area picked. This is the lever
                                                     that stands in for the Cast tab's at-finished-canvas
                                                     panels: without it there is not enough face for identity
                                                     to survive against a competing reference. -->
                                                <CheckBox Content="Max-fidelity references (2048px)" IsChecked="{Binding MaxFidelityReferences}"
                                                          FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"
                                                          Foreground="{StaticResource TextPrimaryBrush}"
                                                          ToolTip="Encodes every cast panel at a 2048px short edge instead of scaling them to the sampled canvas.&#x0a;&#x0a;On this tab's pipeline the sampled canvas is the DRAFT — a quarter of the quality you picked — and the Cast tab's trick of holding its panels at the finished canvas does not exist in this graph. So this is on by default: holding a face is the whole point of a character sheet, and a 2048px reference is more face than even the finished canvas would carry.&#x0a;&#x0a;Reference tokens ride through every sampling step, so this is several times slower than 'match' — it buys identity fidelity, nothing else. Turn it off for speed when the cast is distinctive enough to survive."/>

                                                <!-- Shut by default. These are the dials you set once for a
                                                     run and then leave alone, and the board below is what the
                                                     tab is actually for. -->
                                                <Expander Header="⚙ Hunt &amp; finish options" IsExpanded="False"
                                                          FontSize="11" FontWeight="SemiBold">
                                                <StackPanel Margin="0,6,0,0">
                                                    <!-- ─── The hunt ────────────────────────────────────
                                                         The draft the three samples are compared at. It is
                                                         NOT a fraction of the finished size: this graph's
                                                         upscaler takes a megapixel target, not a factor, so
                                                         the hunt can be as cheap as it likes without
                                                         deciding what the picked take is finished at. -->
                                                    <TextBlock Text="Hunt quality (the 3 drafts)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                    <ComboBox ItemsSource="{Binding PreviewMegapixelOptions}"
                                                              DisplayMemberPath="Label"
                                                              SelectedValuePath="Value"
                                                              SelectedValue="{Binding PreviewMegapixels}"
                                                              Height="30" FontSize="11" Margin="0,0,0,8"
                                                              ToolTip="The canvas the seed previews are sampled at. Every clip in the queue costs three of these before anything is picked, so this is the number that decides how long the hunt sweep takes — and its only job is to let you tell three compositions apart. The picked one is upscaled to the Quality above, from its own latent, so a cheap hunt costs the finished clip nothing.&#x0a;&#x0a;Go higher only when the drafts are too coarse to judge — faces and hands at 0.15 MP are guesswork."/>

                                                    <TextBlock Text="Upscale pass steps (fixed sigmas)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                    <ComboBox ItemsSource="{Binding UpscaleStepOptions}"
                                                              SelectedItem="{Binding UpscaleSteps}"
                                                              Height="30" FontSize="11" Margin="0,0,0,8"
                                                              ToolTip="How many fixed sigmas the finishing pass runs over the upscaled latent. The graph ships one hand-written schedule per count and this picks which one is wired in.&#x0a;&#x0a;4 is what the workflow ships live. 3 is quicker and keeps more of the draft; 5 puts more detail on and drifts further from the sample you picked."/>

                                                    <CheckBox Content="RIFE interpolation (24 → 48 fps)" IsChecked="{Binding UseRife}"
                                                              FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10"
                                                              Foreground="{StaticResource TextPrimaryBrush}"
                                                              ToolTip="Doubles the finished clip's frame rate by generating the frames in between, rather than by rendering them. On is how the authored graph runs, and it is what makes the motion read as smooth at this clip length.&#x0a;&#x0a;Off muxes the H3 frames as they are, at 24 fps. Turn it off if the interpolation is inventing artefacts on fast action, or to keep every joined clip at the sampled rate."/>

                                                    <!-- Unattended mode. A twelve-clip story that has to be
                                                         watched clip by clip is not a queue; this makes it
                                                         one again, at the cost of the choosing. -->
                                                    <CheckBox Content="Auto-pick (render unattended)" IsChecked="{Binding AutoPickSample}"
                                                              FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"
                                                              Foreground="{StaticResource TextPrimaryBrush}"
                                                              ToolTip="Picks a take for every clip the moment its hunt lands, so one ▶ Generate runs the whole story — hunt, finish and join — without a human.&#x0a;&#x0a;Off by default: choosing between three takes is what this tab is for, and with it off the board simply waits, holding nothing on the GPU."/>
                                                    <ComboBox ItemsSource="{Binding AutoPickSlotOptions}"
                                                              SelectedItem="{Binding AutoPickSlot}"
                                                              IsEnabled="{Binding AutoPickSample}"
                                                              Height="28" FontSize="11" Margin="18,0,0,10"
                                                              ToolTip="Which of the three takes auto-pick chooses. If that one failed to render, the first sample that did is taken instead."/>

                                                    <TextBlock Text="{Binding HuntSummary}"
                                                               FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                               TextWrapping="Wrap" Margin="0,0,0,4"/>
                                                </StackPanel>
                                                </Expander>
                                                <!-- Turns red once the frame stack reaches the size that kills the server. -->
                                                <TextBlock Text="{Binding LoadSummary}"
                                                           FontSize="10" FontStyle="Italic"
                                                           TextWrapping="Wrap" Margin="0,0,0,10">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasLoadWarning}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Text="Clip length (seconds · 4–15)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <Slider Value="{Binding LengthSeconds}"
                                                        Minimum="4" Maximum="15"
                                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                                        Foreground="{DynamicResource TabAccentBrush}" Margin="0,0,0,2"
                                                        ToolTip="How long a single H3 pass is — the model's own limit. The Video length slider divides by this to decide how many clips the story is split into, and it is also what decides the peak frame stack above."/>
                                                <TextBlock Text="{Binding LengthSummary}"
                                                           FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,0,0,2"/>
                                                <TextBlock Text="{Binding ClipPlanSummary}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                                                <TextBlock Text="Seed (-1 = random)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0"
                                                             Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}"
                                                             Height="30" Padding="6,0" VerticalContentAlignment="Center"
                                                             BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                             FontSize="12" FontFamily="Consolas" Margin="0,0,6,0"/>
                                                    <Button Grid.Column="1" Content="🎲"
                                                            Command="{Binding RandomSeedCommand}"
                                                            Height="30" Width="36" FontSize="14"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- ═══ FOLD HANDLE ═════════════════════════════════════════════
                                 Never folds away itself — it is the only way back. -->
                            <Border Grid.Column="1" Width="16" Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                                <Button Command="{Binding ToggleSidePanelCommand}"
                                        Content="{Binding SidePanelToggleGlyph}"
                                        ToolTip="{Binding SidePanelToggleTip}"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        FontSize="9" Padding="0" Width="16"
                                        VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                        Foreground="{DynamicResource TabAccentBrush}"/>
                            </Border>

                            <!-- ═══ RIGHT PANEL ══════════════════════════════════════════════ -->
                            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Sheet strip — folds with the rail -->
                                    <RowDefinition Height="3"/>    <!-- Progress bar -->
                                    <RowDefinition Height="Auto"/> <!-- Status row -->
                                    <RowDefinition Height="Auto"/> <!-- Action buttons -->
                                    <RowDefinition Height="Auto"/> <!-- Queue -->
                                    <RowDefinition Height="Auto"/> <!-- Result output -->
                                    <RowDefinition Height="Auto"/> <!-- Log -->
                                </Grid.RowDefinitions>

                                <!-- ─── Sheet strip: what H3 will actually see ───────────────── -->
                                <!-- Height is on the Border, not the row, so folding this really returns
                                     its 240px to the board below. -->
                                <Border Grid.Row="0" Height="240" Background="{StaticResource PlayerSurfaceBrush}"
                                        Visibility="{Binding IsTopPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasCharacter1}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Border Width="64" Height="64" CornerRadius="14" Background="{StaticResource PlayerSurfaceRaisedBrush}"
                                                    BorderBrush="{StaticResource TextSecondaryBrush}" BorderThickness="1"
                                                    HorizontalAlignment="Center" Margin="0,0,0,10">
                                                <TextBlock Text="🪪" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="MiniMax H3 · Eros — the whole story hunted first, then you pick the good takes" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PlayerTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="Photo per character → Build Sheets → story → Analyze → Generate → hunt every clip → pick → finish → join"
                                                       FontSize="11" Foreground="{StaticResource PlayerTextBrush}" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <Grid Visibility="{Binding HasCharacter1, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              Margin="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Image Grid.Row="0" Grid.Column="0" Margin="0,0,6,0" Stretch="Uniform"
                                                   Source="{Binding Character1.SheetPreview}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Sheet 1 · &lt;Picture 1&gt;"
                                                       HorizontalAlignment="Center" Margin="0,6,0,0"
                                                       FontSize="10" Foreground="{StaticResource PlayerTextBrush}"/>

                                            <Image Grid.Row="0" Grid.Column="1" Margin="6,0" Stretch="Uniform"
                                                   Source="{Binding Character2.SheetPreview}"
                                                   Visibility="{Binding HasCharacter2, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Sheet 2 · &lt;Picture 2&gt;"
                                                       HorizontalAlignment="Center" Margin="0,6,0,0"
                                                       FontSize="10" Foreground="{StaticResource PlayerTextBrush}"
                                                       Visibility="{Binding HasCharacter2, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                            <Image Grid.Row="0" Grid.Column="2" Margin="6,0,0,0" Stretch="Uniform"
                                                   Source="{Binding SceneImagePreview}"
                                                   Visibility="{Binding HasSceneImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Scene · prompt only"
                                                       HorizontalAlignment="Center" Margin="0,6,0,0"
                                                       FontSize="10" Foreground="{StaticResource PlayerTextBrush}"
                                                       Visibility="{Binding HasSceneImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- ─── Progress bar ──────────────────────────────────────── -->
                                <ProgressBar Grid.Row="1"
                                             Value="{Binding ProcessingProgress, Mode=OneWay}"
                                             Foreground="{DynamicResource TabAccentBrush}" BorderThickness="0"
                                             Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <!-- ─── Status row ────────────────────────────────────────── -->
                                <Border Grid.Row="2" Style="{StaticResource ToolStripStyle}"
                                        BorderThickness="0,1,0,0" Padding="12,5">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,7,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource TextPrimaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource TabAccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding ProcessingStatus}"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Text="{Binding ProgressPercentage, Mode=OneWay}"
                                                   FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TabAccentBrush}"
                                                   FontFamily="Consolas"
                                                   Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>

                                <!-- ─── Action Buttons ────────────────────────────────────── -->
                                <Border Grid.Row="3" Style="{StaticResource ToolStripStyle}"
                                        BorderThickness="0,1,0,0" Padding="10,8">
                                    <StackPanel>
                                      <!-- Why Add to Queue is on or off, on a line of its own: the status row above
                                           belongs to whatever is rendering, so during a queue run it cannot say this —
                                           which is exactly when it needs saying. -->
                                      <TextBlock Text="{Binding QueueReadiness}" Margin="2,0,2,6"
                                                 FontSize="10" TextWrapping="Wrap"
                                                 Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Margin="0,0,8,0" Height="40"
                                                Command="{Binding GenerateCommand}"
                                                IsEnabled="{Binding CanGenerate}"
                                                Style="{StaticResource AccentOutlineButtonStyle}"
                                                FontSize="12" FontWeight="Bold"
                                                ToolTip="Snapshots the sheets, the prompt and the settings into the queue. Nothing renders until ▶ Generate is pressed. The render itself is the MiniMax I2V turbo pipeline. The sheets are already built, so nothing here waits on the GPU — load the next scene image and Analyze it while this one runs.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚡ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Add to Queue" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="1" Height="40" Width="118" Margin="0,0,8,0"
                                                Command="{Binding StartQueueCommand}"
                                                Style="{StaticResource AccentButtonStyle}"
                                                FontSize="12" FontWeight="Bold"
                                                ToolTip="Starts rendering everything pending in the queue. Add to Queue only stages a job — nothing reaches the GPU until this is pressed, so several prompts can be queued and then rendered in one run. Greyed out while the queue is already running, and when nothing is pending.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="▶ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Generate" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="2" Height="40" Width="82"
                                                Command="{Binding CancelCommand}"
                                                Style="{StaticResource DangerButtonStyle}"
                                                FontSize="11"
                                                ToolTip="Stops whatever is on the GPU — the sheet builder or the queue. Pending items stay queued.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✕ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Folds the sheet strip and the queue list away and gives their
                                         height to the board. Deliberately here rather than in the queue
                                         header: this row is always on screen, and a handle that vanishes
                                         with what it folds is a one-way door. -->
                                    <Button Command="{Binding ToggleTopPanelCommand}"
                                            Content="{Binding TopPanelToggleLabel}"
                                            ToolTip="{Binding TopPanelToggleTip}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Height="22" FontSize="10" Padding="0" Margin="0,8,0,0"
                                            HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Border>

                                <!-- ─── Queue ─────────────────────────────────────────────── -->
                                <Border Grid.Row="4" Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8"
                                        Visibility="{Binding HasQueueItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="🌹 Eros Queue"
                                                       FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TabAccentBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding QueueStatus}"
                                                       FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="2" Content="▶ Generate"
                                                    Command="{Binding StartQueueCommand}"
                                                    Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    ToolTip="Starts rendering the pending items — the same command as the ▶ Generate button above."/>
                                            <Button Grid.Column="3" Content="🔄 Retry"
                                                    Command="{Binding ReprocessAllFailedCommand}"
                                                    Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    ToolTip="Put every failed item back to Pending and run them again."/>
                                            <Button Grid.Column="4" Content="⏹ Stop"
                                                    Command="{Binding StopQueueCommand}"
                                                    Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                                    Style="{StaticResource AccentButtonStyle}"/>
                                            <Button Grid.Column="5" Content="🗑️ Clear"
                                                    Command="{Binding ClearQueueCommand}"
                                                    Height="26" Padding="8,0" FontSize="11"
                                                    Style="{StaticResource AccentButtonStyle}"/>
                                        </Grid>

                                        <!-- Twelve of these are taller than the tiles they push down. -->
                                        <ItemsControl ItemsSource="{Binding Queue}"
                                                      Visibility="{Binding IsTopPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                                            Padding="8,5" Margin="0,0,0,3" Background="White">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" CornerRadius="3" Padding="6,2" Margin="0,0,8,0"
                                                                    VerticalAlignment="Center"
                                                                    Background="{Binding StatusColor}">
                                                                <TextBlock Text="{Binding StatusDisplay}" FontSize="10"
                                                                           FontWeight="SemiBold" Foreground="White"/>
                                                            </Border>
                                                            <Image Grid.Column="1" Source="{Binding QueueThumbnail}"
                                                                   Height="34" Stretch="Uniform" Margin="0,0,8,0"/>
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold" FontSize="11"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Prompt}" FontSize="10"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding ErrorMessage}" FontSize="10"
                                                                           Foreground="{StaticResource DangerBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="3" Content="✕"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Command="{Binding DataContext.RemoveQueueItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    VerticalAlignment="Center"
                                                                    Width="26" Height="26" Padding="0" FontSize="10"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- ─── Result Output ──────────────────────────────────────── -->
                                <Border Grid.Row="5" Background="White" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,1,0,0" Padding="12,10">
                                    <StackPanel>
                                        <!-- ─── The hunt board ───────────────────────
                                             Every queued clip's drafts, all of them, at once. The hunt
                                             sweep fills this without stopping, so a twelve-clip story
                                             arrives as thirty-six takes to choose between rather than
                                             twelve interruptions to sit through.

                                             Still frames, not players: WPF renders several simultaneous
                                             MediaElements as solid black, and here it would be dozens.
                                             The tile you click plays in the single player below. -->
                                        <Border BorderBrush="{DynamicResource TabAccentBrush}" BorderThickness="1" CornerRadius="6"
                                                Background="{StaticResource SurfaceAltBrush}" Padding="10" Margin="0,0,0,10"
                                                Visibility="{Binding ShowBoard, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="🎯 Seed hunt board" FontWeight="Bold" FontSize="13"
                                                               Foreground="{DynamicResource TabAccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding HuntStatus}"
                                                               FontStyle="Italic" FontSize="11" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </Grid>

                                                <!-- The things that can be done to the whole board at once.
                                                     Finish picked is the one that spends GPU. -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Button Content="✨ Finish picked"
                                                            Command="{Binding FinishPickedCommand}"
                                                            Height="30" Padding="12,0" FontSize="11" Margin="0,0,6,0"
                                                            Style="{StaticResource AccentButtonStyle}"
                                                            ToolTip="Upscales every picked take to the finished canvas, in queue order, and joins the story when the last clip lands.&#x0a;&#x0a;With &apos;Finish automatically&apos; on this starts by itself once every clip has been picked — this button is for finishing part of a board early."/>
                                                    <Button Content="✓ Pick take 1 everywhere"
                                                            Command="{Binding PickFirstEverywhereCommand}"
                                                            Height="30" Padding="12,0" FontSize="11" Margin="0,0,6,0"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            ToolTip="Picks the first take that rendered on every clip that has not been chosen yet — the &apos;these are all fine&apos; button, and the way out of clicking down a long board."/>
                                                    <Button Content="✕ Clear picks"
                                                            Command="{Binding ClearPicksCommand}"
                                                            Height="30" Padding="12,0" FontSize="11" Margin="0,0,6,0"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            ToolTip="Un-picks every clip that has not been finished yet. The drafts stay on the board."/>
                                                    <Button Content="{Binding PromptsToggleLabel}"
                                                            Command="{Binding ToggleAllPromptsCommand}"
                                                            Height="30" Padding="12,0" FontSize="11" Margin="0,0,6,0"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            ToolTip="Opens every clip's prompt box at once, or shuts them all. They are shut by default because a dozen open boxes are taller than the takes they belong to — each row's own ✎ Prompt header opens just that one."/>
                                                    <CheckBox Content="Finish automatically" IsChecked="{Binding AutoFinishWhenPicked}"
                                                              VerticalAlignment="Center" FontSize="11" Margin="6,0,0,0"
                                                              Foreground="{StaticResource TextPrimaryBrush}"
                                                              ToolTip="Starts the finish sweep on its own the moment the last unpicked clip is chosen, so the final click on the board is what sets the upscales and the join going.&#x0a;&#x0a;It waits for all of them on purpose: finishing clip 1 the instant it is picked would put the GPU under the board while clip 2 is still being watched."/>
                                                </StackPanel>

                                                <!-- Capped so a long story does not push the player off the
                                                     page; the board scrolls inside its own frame. -->
                                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="760">
                                                    <ItemsControl ItemsSource="{Binding HuntBoard}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Margin="0,0,0,8" Padding="8" CornerRadius="6"
                                                                        Background="White" BorderThickness="1">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsFinished}" Value="True">
                                                                                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                                    <Setter Property="BorderBrush" Value="{DynamicResource TabAccentBrush}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <StackPanel>
                                                                        <!-- Row header: which clip, what it says, what it is doing. -->
                                                                        <Grid Margin="0,0,0,6">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="Bold" FontSize="12"
                                                                                       Foreground="{DynamicResource TabAccentBrush}"
                                                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="10"
                                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                            <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="10" FontStyle="Italic"
                                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                                       VerticalAlignment="Center" Margin="8,0,8,0"/>
                                                                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                                                <Button Content="▶"
                                                                                        Command="{Binding PlayResultCommand}"
                                                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                                                        Width="28" Height="26" Padding="0" FontSize="10" Margin="0,0,4,0"
                                                                                        ToolTip="Play this clip&apos;s finished video in the player below."/>
                                                                                <Button Content="🎲 Re-roll clip"
                                                                                        Command="{Binding RerollAllCommand}"
                                                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                                                        Height="26" Padding="8,0" FontSize="10"
                                                                                        ToolTip="Throws this clip&apos;s takes away and hunts three more on a fresh base seed. The prompt, the cast and the canvas are unchanged — only the noise is."/>
                                                                            </StackPanel>
                                                                        </Grid>

                                                                        <!-- The clip's takes. Clicking a tile watches it AND picks it. -->
                                                                        <ItemsControl ItemsSource="{Binding Drafts}">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <UniformGrid Columns="3"/>
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Border Margin="3" Padding="5" CornerRadius="6"
                                                                                            Background="{StaticResource SurfaceAltBrush}"
                                                                                            BorderThickness="2">
                                                                                        <Border.Style>
                                                                                            <Style TargetType="Border">
                                                                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding IsPicked}" Value="True">
                                                                                                        <Setter Property="BorderBrush" Value="{DynamicResource TabAccentBrush}"/>
                                                                                                        <Setter Property="Background" Value="White"/>
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </Border.Style>
                                                                                        <StackPanel>
                                                                                            <Button Background="Transparent" BorderThickness="0" Padding="0"
                                                                                                    Cursor="Hand"
                                                                                                    Command="{Binding PickCommand}"
                                                                                                    ToolTip="Play this take in the player below and make it the one this clip is finished from. Clicking another tile moves the pick.">
                                                                                                <Border Height="150" CornerRadius="4"
                                                                                                        Background="{StaticResource PlayerSurfaceBrush}">
                                                                                                    <Grid>
                                                                                                        <TextBlock Text="{Binding Status}" FontSize="10"
                                                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                                                   TextWrapping="Wrap" TextAlignment="Center" Margin="6,0"
                                                                                                                   Foreground="{StaticResource PlayerTextBrush}"/>
                                                                                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                                                                                        <!-- The pick badge. A readout, not a second step: the
                                                                                                             click that plays a take is the click that chooses it. -->
                                                                                                        <Border CornerRadius="3" Padding="4,1" Margin="4"
                                                                                                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                                                                Background="{DynamicResource TabAccentBrush}"
                                                                                                                Visibility="{Binding IsPicked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                                            <TextBlock Text="✓ picked" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                                                                        </Border>
                                                                                                    </Grid>
                                                                                                </Border>
                                                                                            </Button>
                                                                                            <Grid Margin="0,4,0,0">
                                                                                                <Grid.ColumnDefinitions>
                                                                                                    <ColumnDefinition Width="*"/>
                                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                                </Grid.ColumnDefinitions>
                                                                                                <TextBlock Grid.Column="0" Text="{Binding SeedText}" FontSize="9"
                                                                                                           FontFamily="Consolas" VerticalAlignment="Center"
                                                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                                                <Button Grid.Column="1" Content="🎲"
                                                                                                        Command="{Binding RerollCommand}"
                                                                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                                                                        Width="24" Height="22" Padding="0" FontSize="9" Margin="2,0,0,0"
                                                                                                        ToolTip="Hunts this one take again on a fresh seed and leaves the clip&apos;s other takes alone — a third of a hunt, not a whole one."/>
                                                                                                <Button Grid.Column="2" Content="✕"
                                                                                                        Command="{Binding DeleteCommand}"
                                                                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                                                                        Width="24" Height="22" Padding="0" FontSize="9" Margin="2,0,0,0"
                                                                                                        ToolTip="Throws this take away, tile and file. The empty slot can be re-rolled into something better."/>
                                                                                            </Grid>
                                                                                        </StackPanel>
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>

                                                                        <!-- The clip's own words. Commits on losing
                                                                             focus, and an edit stales the takes above
                                                                             — they are of the old wording, and the
                                                                             finish re-samples from the prompt.
                                                                             Reword, then 🎲.

                                                                             Shut by default: a dozen open boxes are taller than the takes
                                                                             they belong to. Open the one clip you have decided to rework.
                                                                             Only the description H3 renders motion from is here — the
                                                                             reference preamble and the wardrobe lock above it are written
                                                                             by the app, identical in every clip, and hand-editing those is
                                                                             how a cast stops being wired correctly. -->
                                                                        <Expander Header="✎ Prompt" IsExpanded="{Binding IsDescriptionOpen}"
                                                                                  FontSize="10" Margin="3,4,3,0">
                                                                            <TextBox Text="{Binding Description}"
                                                                                     AcceptsReturn="True" TextWrapping="Wrap"
                                                                                     VerticalScrollBarVisibility="Auto"
                                                                                     MinHeight="46" MaxHeight="120"
                                                                                     FontSize="11" Padding="6,4" Margin="3,0,3,2"
                                                                                     Background="White"
                                                                                     BorderBrush="{StaticResource BorderBrush}"
                                                                                     ToolTip="This clip's description, on its own. Edit it and the takes above go stale — they were rendered from the old wording, and finishing one would deliver a video you have never seen — so re-roll the clip (or a single take) to render what you have just written.&#x0a;&#x0a;The reference line and the wardrobe lock are not shown here on purpose: they are written by the app, identical in every clip, and are what keeps the cast wired to the right pictures."/>
                                                                        </Expander>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="🎥 Result Video" FontWeight="Bold" FontSize="13"
                                                   Foreground="{DynamicResource TabAccentBrush}" Margin="0,0,0,8"/>

                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource PlayerSurfaceBrush}"
                                                Height="200" CornerRadius="6" Margin="0,0,0,8">
                                            <Grid>
                                                <TextBlock Text="Click a take on the board to watch it here"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{StaticResource PlayerTextBrush}" FontStyle="Italic">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasActivePreview}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <!-- Source is set from code-behind (ApplyH3ErosSource) as an
                                                     ABSOLUTE Uri, and this element is never collapsed. A string
                                                     {Binding} silently fails to open Z:\output paths — no
                                                     MediaOpened, no MediaFailed, just a black frame — and a
                                                     collapsed MediaElement will not open media at all. Both
                                                     mistakes have been made on this app's other seed-hunt
                                                     players; do not regress to either. -->
                                                <MediaElement x:Name="H3ErosVideoPlayer"
                                                              LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                              Stretch="Uniform"
                                                              MediaOpened="H3ErosPlayer_MediaOpened"
                                                              MediaEnded="H3ErosPlayer_MediaEnded"
                                                              MediaFailed="H3ErosPlayer_MediaFailed"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Button Content="▶ Play" Style="{StaticResource PrimaryButtonStyle}"
                                                    Command="{Binding PlayVideoCommand}"
                                                    IsEnabled="{Binding HasResult}" Margin="0,0,8,0"/>
                                            <Button Content="📁 Open Folder" Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding OpenResultFolderCommand}"
                                                    IsEnabled="{Binding HasResult}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ResultVideoInfo}"
                                                   FontStyle="Italic" Foreground="#666" FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <!-- ─── Log ───────────────────────────────────────────────── -->
                                <ctrl:ProcessingLogPanel Grid.Row="6" LogText="{Binding LogOutput}" MaxLogHeight="130"/>

                            </Grid>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- ════════════════════════════════════════════════════════════════ -->
                    <!-- Tab: 10Eros ConvRot (face ref → 4 seeds → full-res upscale)        -->
                    <!-- ════════════════════════════════════════════════════════════════ -->
                    <TabItem Header="🎭 10Eros ConvRot">
                        <Grid DataContext="{Binding ErosConvRotVM}" Style="{StaticResource TabPageStyle}">
                            <Grid.Resources>
                                <SolidColorBrush x:Key="TabAccentBrush" Color="{StaticResource AccentRoseColor}"/>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ═══ LEFT PANEL · Inputs ════════════════════════════════════ -->
                            <Border Grid.Column="0" Style="{StaticResource TabSideRailStyle}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="12">

                                        <!-- Intro -->
                                        <Border Style="{StaticResource IntroBannerStyle}">
                                            <StackPanel>
                                                <TextBlock Text="🎭 10Eros ConvRot" Style="{StaticResource IntroTitleStyle}"/>
                                                <TextBlock Style="{StaticResource IntroBodyStyle}"
                                                           Text="Upload one photo → build a 4-panel character sheet with Krea 2 → type an action (Analyze to fold in the character's look) → generate 4 seed previews → Upscale the chosen seed(s) at full resolution. The character sheet is the reference the LTX FaceID model is trained on."/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Workflow selector -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="WORKFLOW"/>
                                                <ComboBox ItemsSource="{Binding WorkflowOptions}" SelectedItem="{Binding SelectedWorkflow, Mode=TwoWay}"
                                                          Height="30"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Source photo -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="SOURCE PHOTO"/>
                                                <Border Height="150" Style="{StaticResource PreviewFrameStyle}">
                                                    <Grid>
                                                        <TextBlock Text="none" Style="{StaticResource PlaceholderTextStyle}"
                                                                   Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                                        <Image Source="{Binding ImagePreview}" Stretch="Uniform" Margin="4"/>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{Binding ImageInfo}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                                <Button Content="📁 Choose Source Photo" Command="{Binding SelectImageCommand}"
                                                        Height="28" Style="{StaticResource AccentButtonStyle}"/>
                                                <CheckBox Content="This photo is already a character sheet (skip Krea 2)"
                                                          IsChecked="{Binding UseSourceAsSheet, Mode=TwoWay}"
                                                          Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Character sheet (Krea 2) -->
                                        <Border Style="{StaticResource SectionCardStyle}"
                                                Visibility="{Binding UseSourceAsSheet, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="CHARACTER SHEET"/>
                                                <Border Height="120" Style="{StaticResource PreviewFrameStyle}">
                                                    <Grid>
                                                        <TextBlock Text="not built yet" Style="{StaticResource PlaceholderTextStyle}"
                                                                   Visibility="{Binding HasSheet, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                                        <Image Source="{Binding SheetPreview}" Stretch="Uniform" Margin="4"/>
                                                    </Grid>
                                                </Border>
                                                <Button Content="🎨 Build Character Sheet (Krea 2)" Command="{Binding BuildSheetCommand}"
                                                        Height="30" Style="{StaticResource AccentButtonStyle}"
                                                        ToolTip="Turn the source photo into a 4-panel character reference sheet (close-up face + full-body front/side/back at 1536×1024) using the Krea 2 edit workflow — the reference the LTX FaceID checkpoint expects."/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Prompt -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="ACTION PROMPT"/>
                                                <TextBox Text="{Binding Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="90" MaxHeight="200"
                                                         VerticalScrollBarVisibility="Auto" Padding="6"
                                                         FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"
                                                         ToolTip="Describe the scene/action. The character's identity comes from the face reference (FaceID), so you only need the action."/>
                                                <Button Content="✨ Analyze — fold appearance into prompt" Command="{Binding AnalyzeCommand}"
                                                        Height="28" Margin="0,8,0,0" Style="{StaticResource AccentButtonStyle}"
                                                        ToolTip="Send the face image + your draft prompt to the LLM to merge the character's visible appearance into the caption."/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Settings -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="SETTINGS"/>
                                                <TextBlock Text="Duration (seconds)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding LengthSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="26" Padding="6,3"                                                         FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                                <TextBlock Text="Base seed (blank = random each run)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Text="{Binding BaseSeed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Height="26" Padding="6,3"                                                             FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <Button Grid.Column="1" Content="🎲" Command="{Binding RandomSeedCommand}"
                                                            Width="30" Height="26" Margin="6,0,0,0" Style="{StaticResource AccentButtonStyle}"
                                                            BorderThickness="0" ToolTip="New random base seed"/>
                                                </Grid>
                                                <TextBlock Text="Samples use base, base+1, base+2, base+3." FontSize="9"
                                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- ═══ RIGHT PANEL · Samples + player ═════════════════════════ -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Sample tiles -->
                                    <RowDefinition Height="*"/>    <!-- Player -->
                                    <RowDefinition Height="Auto"/> <!-- Results strip -->
                                    <RowDefinition Height="Auto"/> <!-- Progress -->
                                    <RowDefinition Height="Auto"/> <!-- Action bar -->
                                    <RowDefinition Height="Auto"/> <!-- Log -->
                                </Grid.RowDefinitions>

                                <!-- Sample tiles -->
                                <Border Grid.Row="0" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                                    <StackPanel>
                                        <TextBlock Text="SEED SAMPLES — click to preview, tick to queue for Upscale"
                                                   FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                        <ListBox ItemsSource="{Binding Samples}"
                                                 SelectedItem="{Binding SelectedSampleForPreview, Mode=TwoWay}"
                                                 Background="Transparent" BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" Columns="4"/>
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="3"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="tile" CornerRadius="6" BorderThickness="2"
                                                                        Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="tile" Property="BorderBrush" Value="{DynamicResource TabAccentBrush}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Height="96" Background="Transparent" ToolTip="Click to preview this sample">
                                                        <Image Source="{Binding ThumbnailImage}" Stretch="Uniform"/>
                                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"
                                                                   IsHitTestVisible="False"
                                                                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,4"
                                                                   Visibility="{Binding HasVideo, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                                        <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                ToolTip="Click to preview this sample"
                                                                Command="{Binding DataContext.PreviewSampleCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding HasVideo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="Transparent"/>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                        <CheckBox Content="Queue" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  Foreground="White" FontSize="10" FontWeight="Bold"
                                                                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6,4"
                                                                  Visibility="{Binding HasVideo, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9"
                                                                   IsHitTestVisible="False"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>

                                <!-- Shared player -->
                                <Border Grid.Row="1" Margin="12" CornerRadius="6"
                                        Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="Generate 4 samples, then click one to preview it here. The final upscaled video plays here after Upscale."
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                                   TextWrapping="Wrap" Margin="20,0" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                   Visibility="{Binding HasActivePreview, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                        <!-- Source is set from code-behind (ApplyErosConvRotSource) as an ABSOLUTE Uri;
                                             a string {Binding} to MediaElement.Source silently fails on Z:\ output paths. -->
                                        <MediaElement x:Name="ErosConvRotPlayer"
                                                      Stretch="Uniform" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                      MediaOpened="ErosConvRotPlayer_MediaOpened"
                                                      MediaEnded="ErosConvRotPlayer_MediaEnded"
                                                      MediaFailed="ErosConvRotPlayer_MediaFailed"/>
                                    </Grid>
                                </Border>

                                <!-- Results strip -->
                                <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,6"
                                        Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="FINISHED VIDEOS — click to replay" FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <ItemsControl ItemsSource="{Binding Results}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.PlayResultCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" Margin="0,0,8,0" Padding="10,4"
                                                            Style="{StaticResource AccentButtonStyle}" Cursor="Hand">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="11"/>
                                                            <TextBlock Text="{Binding Info}" FontSize="9" Foreground="#E6FFFFFF"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Progress -->
                                <Grid Grid.Row="3" Margin="12,6,12,6">
                                    <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding ProcessingProgress}"
                                                 Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}" BorderThickness="0"/>
                                </Grid>

                                <!-- Action bar -->
                                <Border Grid.Row="4" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="🎯 Generate 4 Samples" Command="{Binding HuntCommand}"
                                                Height="32" Padding="16,0" Margin="0,0,8,0" FontWeight="Bold"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Visibility="{Binding ShowReroll, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                                                ToolTip="Generate 4 seed previews from the face reference and prompt."/>
                                        <Button Content="🎲 Reroll — new 4 seeds" Command="{Binding HuntCommand}"
                                                Height="32" Padding="14,0" Margin="0,0,8,0" FontWeight="Bold"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Visibility="{Binding ShowReroll, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                ToolTip="Don't like these? Regenerate 4 fresh previews with a new random seed."/>
                                        <Button Content="{Binding FinishButtonText}" Command="{Binding FinishCommand}"
                                                Height="32" Padding="14,0" Margin="0,0,8,0" FontWeight="Bold"
                                                Style="{StaticResource SuccessButtonStyle}"/>
                                        <Button Content="✕ Cancel" Command="{Binding CancelCommand}"
                                                Height="32" Padding="12,0" Margin="0,0,8,0"
                                                Style="{StaticResource DangerButtonStyle}"/>
                                        <Button Content="📁 Open Folder" Command="{Binding OpenResultFolderCommand}"
                                                IsEnabled="{Binding HasResult}" Height="32" Padding="12,0" Margin="0,0,8,0"
                                                Style="{StaticResource AccentButtonStyle}"/>
                                        <TextBlock Text="{Binding ProcessingStatus}" VerticalAlignment="Center"
                                                   FontStyle="Italic" Foreground="{DynamicResource TabAccentBrush}" FontSize="11" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Log -->
                                <ctrl:ProcessingLogPanel Grid.Row="5" LogText="{Binding LogOutput}" MaxLogHeight="120"/>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- ════════════════════════════════════════════════════════════════ -->
                    <!-- Tab: MiniMax I2V (H3 Ref2VA — up to 4 reference pictures,          -->
                    <!--      optionally continued past the ~15s ceiling by 3 more passes)  -->
                    <!-- ════════════════════════════════════════════════════════════════ -->
                    <TabItem Header="🌀 MiniMax I2V">
                        <Grid DataContext="{Binding MiniMaxI2VVM}" Style="{StaticResource TabPageStyle}">
                            <Grid.Resources>
                                <SolidColorBrush x:Key="TabAccentBrush" Color="{StaticResource AccentAmberColor}"/>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ═══ LEFT PANEL ═══════════════════════════════════════════════ -->
                            <Border Grid.Column="0" Style="{StaticResource TabSideRailStyle}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="12">

                                        <!-- Reference pictures -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="REFERENCE PICTURES" Note="  · up to 4" Margin="0,0,0,4"/>
                                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                                           FontSize="10" FontStyle="Italic" Foreground="{StaticResource TextMutedBrush}"
                                                           Text="These are references, not the frame at 0.00s: they tell H3 how the subjects and the set look, and the prompt says what happens. Slot order is the &lt;Picture N&gt; numbering the prompt refers to."/>

                                                <ItemsControl ItemsSource="{Binding References}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="2"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,6,6" CornerRadius="6" BorderThickness="1"
                                                                    BorderBrush="{StaticResource BorderBrush}"
                                                                    Background="{StaticResource SurfaceAltBrush}">
                                                                <StackPanel>
                                                                    <Grid Height="84">
                                                                        <TextBlock Text="empty"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                   FontSize="10" Foreground="{StaticResource TextMutedBrush}">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        <Image Source="{Binding Preview}" Stretch="Uniform" Margin="3"/>
                                                                        <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                                                                                Margin="4" CornerRadius="3" Padding="5,1"
                                                                                Background="{StaticResource SurfaceBrush}"
                                                                                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
                                                                            <TextBlock Text="{Binding Label}" FontSize="9" FontWeight="SemiBold"
                                                                                       Foreground="{DynamicResource TabAccentBrush}"/>
                                                                        </Border>
                                                                    </Grid>
                                                                    <Grid Margin="4,0,4,4">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Button Grid.Column="0" Content="Browse…" Height="24" FontSize="10" Padding="6,0"
                                                                                Background="{StaticResource SurfaceBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                                                Command="{Binding DataContext.BrowseReferenceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                CommandParameter="{Binding}"/>
                                                                        <Button Grid.Column="1" Content="✕" Width="24" Height="24" FontSize="9" Padding="0" Margin="4,0,0,0"
                                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                                Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                Command="{Binding DataContext.ClearReferenceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                CommandParameter="{Binding}"/>
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <TextBlock Text="{Binding ReferenceSummary}" Margin="0,2,0,10"
                                                           FontSize="10" FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}"/>

                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="🔍 Analyze → Ref2VA"
                                                            Command="{Binding AnalyzeCommand}"
                                                            IsEnabled="{Binding CanAnalyze}"
                                                            Height="32" Padding="14,0" FontSize="11"
                                                            Style="{StaticResource AccentButtonStyle}"
                                                            ToolTip="Sends every filled reference picture — plus whatever is in the prompt box as a draft idea — to the llama-server and writes the six-field Ref2VA prompt: subject_definitions, summary, retention_analysis, detailed_description, overall_soundscape and non_diegetic_music.&#x0a;&#x0a;With continuations queued it writes one block per segment in the same reply and drops each into its own box, so the whole take is paced in one pass."/>
                                                    <TextBlock FontStyle="Italic" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"
                                                               Text="Analyzing…" Foreground="{DynamicResource TabAccentBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAnalyzing}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Segment 1 prompt -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="SEGMENT 1" Note="  · draft idea, or the full prompt"/>
                                                <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                                                         TextWrapping="Wrap" AcceptsReturn="True"
                                                         Height="190" VerticalScrollBarVisibility="Auto"
                                                         BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                         FontSize="11" Padding="8"/>

                                                <!-- Prompt library: analyzed and rendered takes are filed
                                                     automatically; this row is how they come back out. -->
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0"
                                                            Content="{Binding PromptLibraryLabel}"
                                                            Command="{Binding OpenPromptLibraryCommand}"
                                                            Height="28" Padding="10,0" FontSize="11" Margin="0,0,6,0"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            ToolTip="Browse the takes this tab has saved and put one back in the boxes — segment 1 and its continuations, at the length and aspect it was written for. The reference pictures are not restored."/>
                                                    <Button Grid.Column="1" Content="💾 Save"
                                                            Command="{Binding SavePromptCommand}"
                                                            Height="28" Width="76" FontSize="11"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            ToolTip="File the current segments in the prompt library. Analyzed and rendered takes are saved automatically — this is for hand-edited ones."/>
                                                </Grid>
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Length" VerticalAlignment="Center"
                                                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <Slider Grid.Column="1" Margin="8,0"
                                                            Minimum="5" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True"
                                                            Value="{Binding LengthSeconds}" VerticalAlignment="Center"
                                                            ToolTip="Seconds in the base pass. H3's trained range is roughly 124–362 frames at 24 fps, which is where 5–15 seconds comes from."/>
                                                    <TextBlock Grid.Column="2" Text="{Binding LengthSeconds, StringFormat={}{0}s}"
                                                               VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"
                                                               Foreground="{DynamicResource TabAccentBrush}" MinWidth="30" TextAlignment="Right"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Continuations -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="CONTINUATIONS" Note="  · up to 3" Margin="0,0,0,4"/>
                                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                                           FontSize="10" FontStyle="Italic" Foreground="{StaticResource TextMutedBrush}"
                                                           Text="H3 renders at most one ~15s pass, so a longer take is bought with continuations: each is a further pass inside the same submission, conditioned on the tail of the pass before it and blended back over the overlap."/>

                                                <ItemsControl ItemsSource="{Binding Continuations}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,0,6" Padding="8" CornerRadius="6" BorderThickness="1"
                                                                    BorderBrush="{StaticResource BorderBrush}"
                                                                    Background="{StaticResource SurfaceAltBrush}">
                                                                <StackPanel>
                                                                    <Grid Margin="0,0,0,6">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{Binding Title}" VerticalAlignment="Center"
                                                                                   FontSize="10" FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource TabAccentBrush}"/>
                                                                        <Slider Grid.Column="1" Margin="10,0,6,0"
                                                                                Minimum="5" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                                Value="{Binding Seconds}" VerticalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="2" Text="{Binding Seconds, StringFormat={}{0}s}"
                                                                                   VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"
                                                                                   MinWidth="30" TextAlignment="Right"
                                                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                        <Button Grid.Column="3" Content="✕" Width="22" Height="22" Padding="0" FontSize="9" Margin="6,0,0,0"
                                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                                Command="{Binding DataContext.RemoveContinuationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                CommandParameter="{Binding}"/>
                                                                    </Grid>
                                                                    <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                                                                             TextWrapping="Wrap" AcceptsReturn="True"
                                                                             Height="90" VerticalScrollBarVisibility="Auto"
                                                                             BorderBrush="{StaticResource BorderBrush}" Background="White"
                                                                             FontSize="11" Padding="6"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Button Content="＋ Add continuation"
                                                        Command="{Binding AddContinuationCommand}"
                                                        Height="28" FontSize="11" HorizontalAlignment="Left" Padding="12,0"
                                                        Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>

                                                <StackPanel Margin="0,10,0,0"
                                                            Visibility="{Binding HasContinuations, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="Join overlap" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                    <ComboBox ItemsSource="{Binding OverlapOptions}"
                                                              DisplayMemberPath="Label"
                                                              SelectedItem="{Binding Overlap}"
                                                              Height="30" FontSize="11"
                                                              ToolTip="Frames of the previous pass a continuation re-generates and blends over. The choices are H3's own valid clip lengths (17k + 5), because the overlap is handed to the model as a reference clip — more of it costs render time and buys a less visible join."/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Canvas -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="CANVAS" Margin="0,0,0,10"/>

                                                <TextBlock Text="Aspect ratio" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding AspectRatioOptions}"
                                                          SelectedItem="{Binding SelectedAspectRatio}"
                                                          Height="30" FontSize="11" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding ResolvedAspectRatio, StringFormat=→ {0}}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic" Margin="0,0,0,10"/>

                                                <TextBlock Text="Quality (canvas size)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding MegapixelOptions}"
                                                          DisplayMemberPath="Label"
                                                          SelectedValuePath="Value"
                                                          SelectedValue="{Binding Megapixels}"
                                                          Height="30" FontSize="11" Margin="0,0,0,10"
                                                          ToolTip="The size of the finished frames. With the latent upscale on, the draft is sampled at a quarter of this and doubled, so only the last three steps ever run at the full size."/>

                                                <TextBlock Text="Seed (-1 = random)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0"
                                                             Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}"
                                                             Height="30" Padding="6,0" VerticalContentAlignment="Center"
                                                             BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                             FontSize="12" FontFamily="Consolas" Margin="0,0,6,0"
                                                             ToolTip="The base pass uses this seed; each continuation uses it plus its own index, so a whole take reproduces from one number."/>
                                                    <Button Grid.Column="1" Content="🎲"
                                                            Command="{Binding RandomSeedCommand}"
                                                            Height="30" Width="36" FontSize="14"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Finishing -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="FINISHING" Margin="0,0,0,8"/>

                                                <CheckBox Content="SLA block-sparse attention" IsChecked="{Binding UseSla}"
                                                          FontSize="11" Margin="0,0,0,4"
                                                          ToolTip="Block-sparse attention for MiniMax H3: each query block is scored against every key block with one pooled matmul, and only the top slice is actually attended. Nothing is loaded and nothing is trained - the sparsity is decided at runtime from q and k.&#x0a;&#x0a;Long sequences benefit most, so the gain grows with duration and canvas size. Anything under the kernel&apos;s minimum sequence length falls back to dense on its own, which is why a short low-res clip may show no change at all."/>
                                                <ComboBox ItemsSource="{Binding SlaSparsityOptions}"
                                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                                          SelectedValue="{Binding SlaSparsity}"
                                                          IsEnabled="{Binding UseSla}"
                                                          Height="28" FontSize="11" Margin="18,0,0,8"
                                                          ToolTip="Fraction of key blocks skipped. Break-even is around 0.60 - below that the kernel is SLOWER than dense attention, so a low value is a loss, not a safe fallback."/>
                                                <CheckBox Content="Sol-Attn (legacy sparse attention)" IsChecked="{Binding UseSparseAttention}"
                                                          FontSize="11" Margin="0,0,0,7"
                                                          ToolTip="H3 denoises every frame of the clip in one pass, so attention cost grows with the square of frames × canvas area — a 10s clip costs far more than twice a 5s one. Sol-Attn replaces the dense attention with a sparse approximation over the video tokens.&#x0a;&#x0a;It engages only between 20% and 90% of the steps, and only once a pass exceeds 4096 tokens — the opening steps set the layout and the closing ones set the fine detail, and neither is worth approximating. Long or large clips are where it pays; short ones may not trip the threshold at all.&#x0a;&#x0a;It is an approximation, so turn it off if you are chasing the last of the detail."/>
                                                <CheckBox Content="Latent upscale (draft → 2× finish)" IsChecked="{Binding UseLatentUpscale}"
                                                          FontSize="11" Margin="0,0,0,7"
                                                          ToolTip="Renders each pass in three moves instead of one: four sampler steps at half the width and half the height to settle the composition, a 2× pass through the MiniMax H3 3D latent upscaler, then three fixed-sigma steps at the finished size to put the detail on.&#x0a;&#x0a;Only those last three steps ever see the full canvas, which is why this is both quicker and sharper than denoising the whole clip over eight steps. Turned off, the pass falls back to exactly that — one 8-step sampling at the full size, no upscaler involved."/>
                                                <CheckBox Content="Audio enhancement" IsChecked="{Binding UseAudioEnhancement}"
                                                          FontSize="11" Margin="0,0,0,7"
                                                          ToolTip="Runs the decoded soundtrack through the DSRE enhancer — harmonics, stereo width, noise reduction. With continuations it runs once on the joined audio, never per segment."/>
                                                <CheckBox Content="RTX 2× super-resolution" IsChecked="{Binding UseRtxUpscale}"
                                                          FontSize="11" Margin="0,0,0,7"
                                                          ToolTip="Doubles the finished frames through NVIDIA RTX Video Super Resolution. It is a driver-side upscale, not a sampling pass, so it adds no detail the model did not already draw — and it needs an RTX card with VSR available.&#x0a;&#x0a;It runs only on the final frames: applied to the base pass while continuing, it would feed the loop frames at the wrong size."/>
                                                <TextBlock Text="{Binding StereoSummary}" Margin="0,0,0,6"
                                                           FontSize="10" FontFamily="Consolas" TextWrapping="Wrap"
                                                           Foreground="{StaticResource AccentAmberBrush}" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPrimaryStereo}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="STEREO PROMPT ({LAYOUT} is substituted)" Margin="0,0,0,3"
                                                           FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBox Text="{Binding StereoPromptTemplate, UpdateSourceTrigger=LostFocus}"
                                                         Margin="0,0,0,8" Height="72" FontSize="10"
                                                         AcceptsReturn="True" TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Auto"
                                                         ToolTip="Filled in automatically when &lt;Picture 1&gt; turns out to be a stereoscopic pair packed into one frame, so the wording does not have to be pasted in every take.&#x0a;&#x0a;{LAYOUT} becomes &quot;side-by-side split-screen&quot; or &quot;over-under stacked&quot; to match what was detected. The wording is yours to change - &quot;wide-angle fisheye&quot; is right for VR180 footage and wrong for a stereo photograph, and the tab cannot tell which it is looking at. Clear the box to switch the auto-insert off.&#x0a;&#x0a;It is only ever prepended to the idea box, never to a Ref2VA prompt Analyze has already written - and Analyze is told the same facts separately, so the layout lands inside detailed_description where it binds."/>

                                                <CheckBox Content="Max-fidelity references (slow)" IsChecked="{Binding MaxFidelityReferences}"
                                                          FontSize="11" Margin="0,0,0,4"
                                                          ToolTip="Feeds each reference at a 2048px short edge instead of scaling it to the generation's pixel area. Reference tokens ride through every sampling step, so this can be several times slower — it buys identity fidelity and nothing else."/>
                                                <TextBlock Text="{Binding ReferenceScaleWarning}" Margin="18,0,0,8"
                                                           FontSize="10" FontFamily="Consolas" TextWrapping="Wrap"
                                                           ToolTip="Reference pictures are fed at 'match', which scales them to the SAMPLED canvas - and with the latent upscale on that is the draft, a quarter of the megapixels you picked. A 4K reference at 0.7 MP is read at 576x320.&#x0a;&#x0a;That is enough for a pose or a palette, but not for a face to hold identity against a competing reference, and not for fine structure - split-screen panels, text, patterns - to survive at all. Max-fidelity references above is the fix; raising the quality helps a little.">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasReferenceScaleInfo}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsReferenceScaleRisky}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Text="{Binding TotalLengthSummary}"
                                                           FontSize="11" FontWeight="SemiBold" FontFamily="Consolas"
                                                           Foreground="{DynamicResource TabAccentBrush}"/>
                                                <TextBlock Text="{Binding MemoryWarning}" Margin="0,4,0,0"
                                                           FontSize="10" FontFamily="Consolas" TextWrapping="Wrap"
                                                           ToolTip="Rough peak tensor size for a single pass: finished canvas area x frames. The finish sampler sets it - the draft runs at a quarter of the area and is never the peak. Continuations run one after another, so the peak is the largest single pass, not the total.&#x0a;&#x0a;Measured on this 24 GB card: 0.40 Gpx completed, 0.57 Gpx ran out of memory. Length is usually the lever - H3 denoises every frame of the clip jointly, so 15s costs about 1.5x what 10s does at the same canvas.">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMemoryRisky}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsMemoryOverLimit}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- ═══ RIGHT PANEL ══════════════════════════════════════════════ -->
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="240"/>  <!-- Reference strip -->
                                    <RowDefinition Height="3"/>    <!-- Progress bar -->
                                    <RowDefinition Height="Auto"/> <!-- Status row -->
                                    <RowDefinition Height="Auto"/> <!-- Action buttons -->
                                    <RowDefinition Height="Auto"/> <!-- Queue -->
                                    <RowDefinition Height="Auto"/> <!-- Result output -->
                                    <RowDefinition Height="Auto"/> <!-- Log -->
                                </Grid.RowDefinitions>

                                <!-- ─── Reference strip ───────────────────────────────────── -->
                                <Border Grid.Row="0" Background="{StaticResource PlayerSurfaceBrush}">
                                    <Grid>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasReference}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Border Width="64" Height="64" CornerRadius="14"
                                                    Background="{StaticResource PlayerSurfaceRaisedBrush}"
                                                    BorderBrush="{StaticResource TextSecondaryBrush}" BorderThickness="1"
                                                    HorizontalAlignment="Center" Margin="0,0,0,10">
                                                <TextBlock Text="🌀" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="MiniMax H3 · Reference to Video" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PlayerTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="Load 1–4 reference pictures → Analyze → Generate (video + synced audio)"
                                                       FontSize="11" Foreground="{StaticResource PlayerTextBrush}" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <ItemsControl ItemsSource="{Binding FilledReferences}" Margin="12"
                                                      VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      Visibility="{Binding HasReference, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="6,0">
                                                        <Border CornerRadius="6" BorderThickness="1" Padding="2"
                                                                BorderBrush="{StaticResource BorderStrongBrush}"
                                                                Background="{StaticResource PlayerSurfaceRaisedBrush}">
                                                            <Image Source="{Binding Preview}" Height="164" Stretch="Uniform"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,5,0,0"
                                                                   FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource PlayerTextBrush}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="10"
                                                CornerRadius="8" Padding="12,6"
                                                Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                                Visibility="{Binding HasReference, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}">
                                                <Run Text="{Binding ResolvedAspectRatio, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource TabAccentBrush}" FontFamily="Consolas"/>
                                                <Run Text="  ·  "/>
                                                <Run Text="{Binding TotalLengthSummary, Mode=OneWay}" FontFamily="Consolas"/>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- ─── Progress bar ──────────────────────────────────────── -->
                                <ProgressBar Grid.Row="1"
                                             Value="{Binding ProcessingProgress, Mode=OneWay}"
                                             Foreground="{DynamicResource TabAccentBrush}" BorderThickness="0"
                                             Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <!-- ─── Status row ────────────────────────────────────────── -->
                                <Border Grid.Row="2" Style="{StaticResource ToolStripStyle}"
                                        BorderThickness="0,1,0,0" Padding="12,5">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,7,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource TextPrimaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource TabAccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding ProcessingStatus}"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                            <!-- Elapsed and estimated remaining: on a render this long the
                                                 percentage on its own says nothing about when to come back. -->
                                            <TextBlock Text="{Binding GenerationTimer}" Margin="0,0,10,0"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontFamily="Consolas" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ProgressPercentage, Mode=OneWay}"
                                                       FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TabAccentBrush}"
                                                       FontFamily="Consolas" VerticalAlignment="Center"
                                                       Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- ─── Action Buttons ────────────────────────────────────── -->
                                <Border Grid.Row="3" Style="{StaticResource ToolStripStyle}"
                                        BorderThickness="0,1,0,0" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Button Grid.Column="0" Grid.Row="0" Margin="0,0,8,0" Height="40"
                                                Command="{Binding GenerateCommand}"
                                                IsEnabled="{Binding CanGenerate}"
                                                Style="{StaticResource AccentOutlineButtonStyle}"
                                                FontSize="12" FontWeight="Bold"
                                                ToolTip="Snapshots the references, prompt, continuations and every setting into the queue. Nothing renders until ▶ Generate is pressed. Each item is frozen at this moment — change the form afterwards and the queued job is unaffected.&#x0a;&#x0a;The tab stays free while jobs render: load the next picture and Analyze it, and add that too.&#x0a;&#x0a;Whichever half of the graph an item does not use — the continuation loop, or the base-only sink — is deleted before submitting rather than switched off, because a ComfyUI output node runs whether or not anything downstream wants it.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚡ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Add to Queue" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Grid.Column="0" Grid.Row="1" Margin="2,4,8,0"
                                                   Text="{Binding GenerateBlockedReason}"
                                                   FontSize="10" FontStyle="Italic" TextWrapping="Wrap"
                                                   Foreground="{StaticResource DangerBrush}"
                                                   Visibility="{Binding GenerateBlockedReason, Converter={StaticResource StringToVisibilityConverter}}"/>

                                        <Button Grid.Column="1" Grid.Row="0" Height="40" Width="118" Margin="0,0,8,0"
                                                Command="{Binding StartQueueCommand}"
                                                Style="{StaticResource AccentButtonStyle}"
                                                FontSize="12" FontWeight="Bold"
                                                ToolTip="Starts rendering everything pending in the queue. Add to Queue only stages a job — nothing reaches the GPU until this is pressed, so several prompts can be queued and then rendered in one run. Greyed out while the queue is already running, and when nothing is pending.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="▶ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Generate" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="2" Grid.Row="0" Height="40" Width="82"
                                                Command="{Binding CancelCommand}"
                                                Style="{StaticResource DangerButtonStyle}"
                                                FontSize="11">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✕ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- ─── Queue ──────────────────────────────────────────────── -->
                                <Border Grid.Row="4" Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                        Padding="12,8"
                                        Visibility="{Binding HasQueueItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="⚡ Render Queue"
                                                       FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TabAccentBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding QueueStatus}"
                                                       FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="2" Content="▶ Generate"
                                                    Command="{Binding StartQueueCommand}"
                                                    Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    ToolTip="Starts rendering the pending items — the same command as the ▶ Generate button above."/>
                                            <Button Grid.Column="3" Content="🔄 Retry"
                                                    Command="{Binding ReprocessAllFailedCommand}"
                                                    Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    ToolTip="Put every failed item back to Pending and run them again."/>
                                            <Button Grid.Column="4" Content="⏹ Stop"
                                                    Command="{Binding StopQueueCommand}"
                                                    Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    ToolTip="Stop after the current item; it goes back to Pending."/>
                                            <Button Grid.Column="5" Content="🗑️ Clear"
                                                    Command="{Binding ClearQueueCommand}"
                                                    Height="26" Padding="8,0" FontSize="11"
                                                    Style="{StaticResource AccentButtonStyle}"/>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Queue}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                                            Padding="8,5" Margin="0,0,0,3" Background="White">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" CornerRadius="3" Padding="6,2" Margin="0,0,8,0"
                                                                    VerticalAlignment="Center"
                                                                    Background="{Binding StatusColor}">
                                                                <TextBlock Text="{Binding StatusDisplay}" FontSize="10"
                                                                           FontWeight="SemiBold" Foreground="White"/>
                                                            </Border>
                                                            <Image Grid.Column="1" Source="{Binding QueueThumbnail}"
                                                                   Height="34" Stretch="Uniform" Margin="0,0,8,0"/>
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold" FontSize="11"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <!-- PromptPreview is already collapsed to one line: a six-field
                                                                     Ref2VA prompt carries its own newlines, and TextTrimming
                                                                     would ellipsize each of them separately while still
                                                                     rendering every line. Full text is on the tooltip. -->
                                                                <TextBlock Text="{Binding PromptPreview}" FontSize="10"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           ToolTipService.ShowDuration="60000"
                                                                           TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis">
                                                                    <TextBlock.ToolTip>
                                                                        <ToolTip MaxWidth="700">
                                                                            <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" FontSize="11"/>
                                                                        </ToolTip>
                                                                    </TextBlock.ToolTip>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding ErrorMessage}" FontSize="10"
                                                                           Foreground="{StaticResource DangerBrush}"
                                                                           TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="3" Content="✕"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Command="{Binding DataContext.RemoveQueueItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    VerticalAlignment="Center"
                                                                    Width="26" Height="26" Padding="0" FontSize="10"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- ─── Result Output ──────────────────────────────────────── -->
                                <Border Grid.Row="5" Background="White" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,1,0,0" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="🎥 Result Video" FontWeight="Bold" FontSize="13"
                                                   Foreground="{DynamicResource TabAccentBrush}" Margin="0,0,0,8"/>

                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource PlayerSurfaceBrush}"
                                                Height="200" CornerRadius="6" Margin="0,0,0,8">
                                            <Grid>
                                                <TextBlock Text="Video will appear here after generation"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{StaticResource PlayerTextBrush}" FontStyle="Italic">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasResult}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <MediaElement x:Name="MiniMaxI2VVideoPlayer"
                                                              Source="{Binding ResultVideoPath}"
                                                              LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                              Stretch="Uniform"
                                                              Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Button Content="▶ Play" Style="{StaticResource PrimaryButtonStyle}"
                                                    Command="{Binding PlayVideoCommand}"
                                                    IsEnabled="{Binding HasResult}" Margin="0,0,8,0"/>
                                            <Button Content="📁 Open Folder" Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding OpenResultFolderCommand}"
                                                    IsEnabled="{Binding HasResult}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ResultVideoInfo}"
                                                   FontStyle="Italic" Foreground="#666" FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <!-- ─── Log ───────────────────────────────────────────────── -->
                                <ctrl:ProcessingLogPanel Grid.Row="6" LogText="{Binding LogOutput}" MaxLogHeight="130"/>

                            </Grid>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>


                    <!-- ════════════════════════════════════════════════════════════════ -->
                    <!-- Tab: MiniMax FFLF (H3 FL2VA — a keyframe chain: an opening frame   -->
                    <!--      and up to 4 stills the take has to pass through)              -->
                    <!-- ════════════════════════════════════════════════════════════════ -->
                    <TabItem Header="🌀🎯 MiniMax FFLF">
                        <Grid x:Name="FflfRoot" DataContext="{Binding MiniMaxFflfVM}" Style="{StaticResource TabPageStyle}">
                            <Grid.Resources>
                                <SolidColorBrush x:Key="TabAccentBrush" Color="{StaticResource AccentCyanColor}"/>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ═══ LEFT PANEL ═══════════════════════════════════════════════ -->
                            <Border Grid.Column="0" Style="{StaticResource TabSideRailStyle}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="12">

                                        <!-- Opening frame -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="OPENING FRAME" Note="  · the frame at 0.00s" Margin="0,0,0,4"/>
                                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                                           FontSize="10" FontStyle="Italic" Foreground="{StaticResource TextMutedBrush}"
                                                           Text="FL2VA takes the two pictures literally: this one IS the first frame, and each clip's keyframe IS its last. The prompt only has to describe the path between them."/>

                                                <Border CornerRadius="6" BorderThickness="1"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        Background="{StaticResource SurfaceAltBrush}">
                                                    <StackPanel DataContext="{Binding OpeningFrame}">
                                                        <Grid Height="120">
                                                            <TextBlock Text="no opening frame"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       FontSize="10" Foreground="{StaticResource TextMutedBrush}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <Image Source="{Binding Preview}" Stretch="Uniform" Margin="4"/>
                                                            <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                                                                    Margin="5" CornerRadius="3" Padding="5,1"
                                                                    Background="{StaticResource SurfaceBrush}"
                                                                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
                                                                <TextBlock Text="{Binding Label}" FontSize="9" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TabAccentBrush}"/>
                                                            </Border>
                                                        </Grid>
                                                        <Grid Margin="5,0,5,5">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button Grid.Column="0" Content="Browse…" Height="26" FontSize="10" Padding="6,0"
                                                                    Background="{StaticResource SurfaceBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                                    Command="{Binding DataContext.BrowseFrameCommand, ElementName=FflfRoot}"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Grid.Column="1" Content="✕" Width="26" Height="26" FontSize="9" Padding="0" Margin="4,0,0,0"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                    Command="{Binding DataContext.ClearFrameCommand, ElementName=FflfRoot}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <TextBlock Text="{Binding ChainSummary}" Margin="0,6,0,0"
                                                           FontSize="10" FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}"/>

                                                <!-- Folder of keyframes: what a Story Image Q keyframe run leaves behind. -->
                                                <Button Content="📂 Load a folder of keyframes…"
                                                        Command="{Binding LoadFolderCommand}"
                                                        Height="28" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Stretch" Padding="10,0"
                                                        Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                        ToolTip="Lays a folder of stills straight onto the chain, ordered by creation time: the first image becomes the opening frame and every one after it becomes a keyframe a clip has to arrive at, so N images give N-1 clips.&#x0a;&#x0a;A chain holds five keyframes at most, so a longer folder — a ten-keyframe Story Image Q run, say — is walked as a series of takes. Each take starts on the keyframe the one before it ended on, which is what makes the takes join, and queueing a take moves the form on to the next one."/>

                                                <Grid Margin="0,6,0,0"
                                                      Visibility="{Binding HasFolder, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Content="◀" Width="24" Height="22" Padding="0" FontSize="9"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding PreviousTakeCommand}"
                                                            ToolTip="Back to the previous take."/>
                                                    <TextBlock Grid.Column="1" Text="{Binding FolderStatus}" Margin="6,0"
                                                               VerticalAlignment="Center" TextWrapping="Wrap"
                                                               FontSize="10" FontFamily="Consolas"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <Button Grid.Column="2" Content="▶" Width="24" Height="22" Padding="0" FontSize="9"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding NextTakeCommand}"
                                                            ToolTip="On to the next take — it opens on the keyframe this one ends with, so the two join."/>
                                                </Grid>

                                                <Grid Margin="0,6,0,0"
                                                      Visibility="{Binding HasFolder, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Clips per take" VerticalAlignment="Center"
                                                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ClipsPerTakeOptions}"
                                                              SelectedItem="{Binding ClipsPerTake}"
                                                              Width="56" Height="26" FontSize="11" Margin="8,0,0,0"
                                                              ToolTip="How much of the folder one submission covers. Four is the graph&apos;s limit and four does render — 40s at 0.4 MP took 15m27s — but every clip&apos;s frames stay in host RAM until the take is written out, and that same take killed ComfyUI on a server that already had 32 GB resident. Three is the default; raise it when the server is fresh.&#x0a;&#x0a;Fewer clips per take means more, shorter submissions. They still join: each take opens on the keyframe the last one ended with."/>
                                                </Grid>

                                                <Button Content="⚡ Analyze &amp; queue every take"
                                                        Command="{Binding QueueFolderCommand}"
                                                        Height="30" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Stretch" Padding="10,0"
                                                        Style="{StaticResource AccentButtonStyle}"
                                                        Visibility="{Binding HasFolder, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        ToolTip="Walks the rest of the folder without stopping: for each take it writes the prompts that are still missing, adds the take to the render queue, and moves on to the next one. A ten-keyframe folder goes in as three or four queued jobs.&#x0a;&#x0a;Prompts you have already written or analyzed are kept — only empty ones are filled in."/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Idea + Analyze -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="IDEA" Note="  · optional draft for the whole take"/>
                                                <TextBox Text="{Binding DraftIdea, UpdateSourceTrigger=PropertyChanged}"
                                                         TextWrapping="Wrap" AcceptsReturn="True"
                                                         Height="90" VerticalScrollBarVisibility="Auto"
                                                         BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                         FontSize="11" Padding="8" Margin="0,0,0,8"
                                                         ToolTip="What the take is about, in your own words. Analyze paces it across the chain — each clip gets the part of the idea that falls between its two keyframes.&#x0a;&#x0a;Leave it empty and each clip is written from nothing but the transformation its two pictures imply."/>

                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="🔍 Analyze → FL2VA"
                                                            Command="{Binding AnalyzeCommand}"
                                                            IsEnabled="{Binding CanAnalyze}"
                                                            Height="32" Padding="14,0" FontSize="11"
                                                            Style="{StaticResource AccentButtonStyle}"
                                                            ToolTip="Walks the chain pair by pair — (opening frame, keyframe 2), (keyframe 2, keyframe 3), … — and writes one FL2VA prompt per clip: the alignment line, the integrated multimodal description of the path between the two pictures, the soundscape and the score.&#x0a;&#x0a;One call per clip, because the FL2VA system prompt is written for exactly two images, and a pair is what each pass really gets. Each call is given the previous clip's prompt as context so the chain reads as one take."/>
                                                    <TextBlock FontStyle="Italic" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"
                                                               Text="Analyzing…" Foreground="{DynamicResource TabAccentBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAnalyzing}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Clips -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="CLIPS" Note="  · up to 4" Margin="0,0,0,4"/>
                                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                                           FontSize="10" FontStyle="Italic" Foreground="{StaticResource TextMutedBrush}"
                                                           Text="Clip 1 runs from the opening frame to its keyframe. Every clip after it is a further pass inside the same submission: it continues out of the tail of the clip before it and has to arrive at its own keyframe."/>

                                                <ItemsControl ItemsSource="{Binding Clips}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,0,8" Padding="8" CornerRadius="6" BorderThickness="1"
                                                                    BorderBrush="{StaticResource BorderBrush}"
                                                                    Background="{StaticResource SurfaceAltBrush}">
                                                                <StackPanel>
                                                                    <Grid Margin="0,0,0,6">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{Binding Title}" VerticalAlignment="Center"
                                                                                   FontSize="10" FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource TabAccentBrush}"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding Subtitle}" VerticalAlignment="Center"
                                                                                   Margin="8,0,0,0" FontSize="10" FontStyle="Italic"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                                                        <Button Grid.Column="2" Content="✕" Width="22" Height="22" Padding="0" FontSize="9"
                                                                                ToolTip="Remove this clip and the keyframe it ends on."
                                                                                Command="{Binding DataContext.RemoveClipCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                CommandParameter="{Binding}">
                                                                            <Button.Style>
                                                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                    <Style.Triggers>
                                                                                        <!-- Clip 1 is the base pass: the take cannot exist without it. -->
                                                                                        <DataTrigger Binding="{Binding Index}" Value="1">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Button.Style>
                                                                        </Button>
                                                                    </Grid>

                                                                    <Grid Margin="0,0,0,6">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="104"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <!-- End keyframe -->
                                                                        <StackPanel Grid.Column="0" DataContext="{Binding EndFrame}">
                                                                            <Border CornerRadius="4" BorderThickness="1" Height="72"
                                                                                    BorderBrush="{StaticResource BorderBrush}" Background="White">
                                                                                <Grid>
                                                                                    <TextBlock Text="no keyframe"
                                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                               FontSize="9" Foreground="{StaticResource TextMutedBrush}">
                                                                                        <TextBlock.Style>
                                                                                            <Style TargetType="TextBlock">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </TextBlock.Style>
                                                                                    </TextBlock>
                                                                                    <Image Source="{Binding Preview}" Stretch="Uniform" Margin="2"/>
                                                                                </Grid>
                                                                            </Border>
                                                                            <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,3,0,3"
                                                                                       FontSize="9" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                            <!-- ElementName cannot cross a DataTemplate's namescope, so the
                                                                                 command comes off the Clips ItemsControl, whose DataContext
                                                                                 is the tab's ViewModel. -->
                                                                            <Button Content="Browse…" Height="24" FontSize="10" Padding="4,0"
                                                                                    Background="{StaticResource SurfaceBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                                                    Command="{Binding DataContext.BrowseFrameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                    CommandParameter="{Binding}"/>
                                                                        </StackPanel>

                                                                        <!-- Prompt + length -->
                                                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                                            <Grid Margin="0,0,0,4">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Grid.Column="0" Text="Length" VerticalAlignment="Center"
                                                                                           FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                                <Slider Grid.Column="1" Margin="8,0,6,0"
                                                                                        Minimum="5" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                                        Value="{Binding Seconds}" VerticalAlignment="Center"
                                                                                        ToolTip="Seconds this clip runs. H3's trained range is roughly 124–362 frames at 24 fps, which is where 5–15 seconds comes from — and the last frame has to be reachable in that time."/>
                                                                                <TextBlock Grid.Column="2" Text="{Binding Seconds, StringFormat={}{0}s}"
                                                                                           VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"
                                                                                           MinWidth="30" TextAlignment="Right"
                                                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                            </Grid>
                                                                            <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                                                                                     TextWrapping="Wrap" AcceptsReturn="True"
                                                                                     Height="118" VerticalScrollBarVisibility="Auto"
                                                                                     BorderBrush="{StaticResource BorderBrush}" Background="White"
                                                                                     FontSize="11" Padding="6"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Button Content="＋ Add clip"
                                                        Command="{Binding AddClipCommand}"
                                                        Height="28" FontSize="11" HorizontalAlignment="Left" Padding="12,0"
                                                        Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                        ToolTip="Adds a keyframe to the end of the chain and a clip that has to reach it."/>

                                                <StackPanel Margin="0,10,0,0"
                                                            Visibility="{Binding HasExtensions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="Join overlap" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                    <ComboBox ItemsSource="{Binding OverlapOptions}"
                                                              DisplayMemberPath="Label"
                                                              SelectedItem="{Binding Overlap}"
                                                              Height="30" FontSize="11"
                                                              ToolTip="Frames of the previous clip a continuing clip re-generates and blends over. The choices are H3's own valid clip lengths (17k + 5), because the overlap is handed to the model as a reference clip — more of it costs render time and buys a less visible join."/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Canvas -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="CANVAS" Margin="0,0,0,10"/>

                                                <TextBlock Text="Aspect ratio" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding AspectRatioOptions}"
                                                          SelectedItem="{Binding SelectedAspectRatio}"
                                                          Height="30" FontSize="11" Margin="0,0,0,4"
                                                          ToolTip="Auto takes the opening frame's proportions. Worth getting right here: the keyframes are the literal first and last frames, so a canvas that does not match them squeezes the pictures the clip has to land on."/>
                                                <TextBlock Text="{Binding ResolvedAspectRatio, StringFormat=→ {0}}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic" Margin="0,0,0,10"/>

                                                <TextBlock Text="Quality (canvas size)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding MegapixelOptions}"
                                                          DisplayMemberPath="Label"
                                                          SelectedValuePath="Value"
                                                          SelectedValue="{Binding Megapixels}"
                                                          Height="30" FontSize="11" Margin="0,0,0,10"
                                                          ToolTip="The size of the finished frames. With the latent upscale on, the draft is sampled at a quarter of this and doubled, so only the last three steps ever run at the full size."/>

                                                <TextBlock Text="Seed (-1 = random)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0"
                                                             Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}"
                                                             Height="30" Padding="6,0" VerticalContentAlignment="Center"
                                                             BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                             FontSize="12" FontFamily="Consolas" Margin="0,0,6,0"
                                                             ToolTip="Clip 1 uses this seed; each continuing clip uses it plus its own index, so a whole chain reproduces from one number."/>
                                                    <Button Grid.Column="1" Content="🎲"
                                                            Command="{Binding RandomSeedCommand}"
                                                            Height="30" Width="36" FontSize="14"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Finishing -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="FINISHING" Margin="0,0,0,8"/>

                                                <CheckBox Content="Latent upscale (draft → 2× finish)" IsChecked="{Binding UseLatentUpscale}"
                                                          FontSize="11" Margin="0,0,0,7"
                                                          ToolTip="Renders each clip in three moves instead of one: four sampler steps at half the width and half the height to settle the composition, a 2× pass through the MiniMax H3 3D latent upscaler, then three fixed-sigma steps at the finished size to put the detail on.&#x0a;&#x0a;Only those last three steps ever see the full canvas, which is why this is both quicker and sharper than denoising the whole clip over eight steps. Turned off, the clip falls back to exactly that — one 8-step sampling at the full size, no upscaler involved."/>
                                                <CheckBox Content="Sol-Attn sparse attention" IsChecked="{Binding UseSparseAttention}"
                                                          FontSize="11" Margin="0,0,0,7"
                                                          ToolTip="H3 denoises every frame of the clip in one pass, so attention cost grows with the square of frames × canvas area — a 10s clip costs far more than twice a 5s one. Sol-Attn replaces the dense attention with a sparse approximation over the video tokens.&#x0a;&#x0a;It engages only between 20% and 90% of the steps, and only once a pass exceeds 4096 tokens — the opening steps set the layout and the closing ones set the fine detail, and neither is worth approximating.&#x0a;&#x0a;It is an approximation, so turn it off if you are chasing the last of the detail."/>
                                                <CheckBox Content="Audio enhancement" IsChecked="{Binding UseAudioEnhancement}"
                                                          FontSize="11" Margin="0,0,0,7"
                                                          ToolTip="Runs the decoded soundtrack through the DSRE enhancer — harmonics, stereo width, noise reduction. On a chain it runs once on the joined audio, never per clip."/>
                                                <CheckBox Content="RTX 2× super-resolution" IsChecked="{Binding UseRtxUpscale}"
                                                          FontSize="11" Margin="0,0,0,8"
                                                          ToolTip="Doubles the finished frames through NVIDIA RTX Video Super Resolution. It is a driver-side upscale, not a sampling pass, so it adds no detail the model did not already draw — and it needs an RTX card with VSR available.&#x0a;&#x0a;It runs only on the final frames: applied to clip 1 while the chain continues, it would feed the loop frames at the wrong size."/>

                                                <TextBlock Text="{Binding TotalLengthSummary}"
                                                           FontSize="11" FontWeight="SemiBold" FontFamily="Consolas"
                                                           Foreground="{DynamicResource TabAccentBrush}"/>
                                                <TextBlock Text="{Binding MemoryWarning}" Margin="0,4,0,0"
                                                           FontSize="10" FontFamily="Consolas" TextWrapping="Wrap"
                                                           ToolTip="Rough peak tensor size for a single clip: finished canvas area x frames. The finish sampler sets it - the draft runs at a quarter of the area and is never the peak. Clips run one after another, so the peak is the largest single clip, not the total.&#x0a;&#x0a;The second figure is the decoded frames the loop holds in system RAM at once, which grows with the whole chain's length — that is the limit that kills the server rather than the job.">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMemoryRisky}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsMemoryOverLimit}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- ═══ RIGHT PANEL ══════════════════════════════════════════════ -->
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="240"/>  <!-- Keyframe strip -->
                                    <RowDefinition Height="3"/>    <!-- Progress bar -->
                                    <RowDefinition Height="Auto"/> <!-- Status row -->
                                    <RowDefinition Height="Auto"/> <!-- Action buttons -->
                                    <RowDefinition Height="Auto"/> <!-- Queue -->
                                    <RowDefinition Height="Auto"/> <!-- Result output -->
                                    <RowDefinition Height="Auto"/> <!-- Log -->
                                </Grid.RowDefinitions>

                                <!-- ─── Keyframe strip ────────────────────────────────────── -->
                                <Border Grid.Row="0" Background="{StaticResource PlayerSurfaceBrush}">
                                    <Grid>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasOpeningFrame}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Border Width="64" Height="64" CornerRadius="14"
                                                    Background="{StaticResource PlayerSurfaceRaisedBrush}"
                                                    BorderBrush="{StaticResource TextSecondaryBrush}" BorderThickness="1"
                                                    HorizontalAlignment="Center" Margin="0,0,0,10">
                                                <TextBlock Text="🎯" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="MiniMax H3 · First and Last Frame" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PlayerTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="Set the opening frame and a keyframe per clip → Analyze → Generate (video + synced audio)"
                                                       FontSize="11" Foreground="{StaticResource PlayerTextBrush}" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <ItemsControl ItemsSource="{Binding ChainFrames}" Margin="12"
                                                      VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      Visibility="{Binding HasOpeningFrame, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="6,0">
                                                        <Border CornerRadius="6" BorderThickness="1" Padding="2" Height="168"
                                                                BorderBrush="{StaticResource BorderStrongBrush}"
                                                                Background="{StaticResource PlayerSurfaceRaisedBrush}">
                                                            <Grid>
                                                                <TextBlock Text="not set" Width="96" TextAlignment="Center"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           FontSize="10" Foreground="{StaticResource PlayerTextBrush}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <Image Source="{Binding Preview}" Stretch="Uniform"/>
                                                            </Grid>
                                                        </Border>
                                                        <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,5,0,0"
                                                                   FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource PlayerTextBrush}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="10"
                                                CornerRadius="8" Padding="12,6"
                                                Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                                Visibility="{Binding HasOpeningFrame, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}">
                                                <Run Text="{Binding ResolvedAspectRatio, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource TabAccentBrush}" FontFamily="Consolas"/>
                                                <Run Text="  ·  "/>
                                                <Run Text="{Binding TotalLengthSummary, Mode=OneWay}" FontFamily="Consolas"/>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- ─── Progress bar ──────────────────────────────────────── -->
                                <ProgressBar Grid.Row="1"
                                             Value="{Binding ProcessingProgress, Mode=OneWay}"
                                             Foreground="{DynamicResource TabAccentBrush}" BorderThickness="0"
                                             Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <!-- ─── Status row ────────────────────────────────────────── -->
                                <Border Grid.Row="2" Style="{StaticResource ToolStripStyle}"
                                        BorderThickness="0,1,0,0" Padding="12,5">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,7,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource TextPrimaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource TabAccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding ProcessingStatus}"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                            <TextBlock Text="{Binding GenerationTimer}" Margin="0,0,10,0"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontFamily="Consolas" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ProgressPercentage, Mode=OneWay}"
                                                       FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TabAccentBrush}"
                                                       FontFamily="Consolas" VerticalAlignment="Center"
                                                       Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- ─── Action Buttons ────────────────────────────────────── -->
                                <Border Grid.Row="3" Style="{StaticResource ToolStripStyle}"
                                        BorderThickness="0,1,0,0" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Button Grid.Column="0" Grid.Row="0" Margin="0,0,8,0" Height="40"
                                                Command="{Binding GenerateCommand}"
                                                IsEnabled="{Binding CanGenerate}"
                                                Style="{StaticResource AccentOutlineButtonStyle}"
                                                FontSize="12" FontWeight="Bold"
                                                ToolTip="Snapshots the keyframes, the prompts and every setting into the queue. Nothing renders until ▶ Generate is pressed. Each item is frozen at this moment — change the form afterwards and the queued job is unaffected.&#x0a;&#x0a;The tab stays free while jobs render: load the next chain and Analyze it, and add that too.&#x0a;&#x0a;Whichever half of the graph an item does not use — the continuation loop, or the single-clip sink — is deleted before submitting rather than switched off, because a ComfyUI output node runs whether or not anything downstream wants it.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚡ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Add to Queue" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Grid.Column="0" Grid.Row="1" Margin="2,4,8,0"
                                                   Text="{Binding GenerateBlockedReason}"
                                                   FontSize="10" FontStyle="Italic" TextWrapping="Wrap"
                                                   Foreground="{StaticResource DangerBrush}"
                                                   Visibility="{Binding GenerateBlockedReason, Converter={StaticResource StringToVisibilityConverter}}"/>

                                        <Button Grid.Column="1" Grid.Row="0" Height="40" Width="118" Margin="0,0,8,0"
                                                Command="{Binding StartQueueCommand}"
                                                Style="{StaticResource AccentButtonStyle}"
                                                FontSize="12" FontWeight="Bold"
                                                ToolTip="Starts rendering everything pending in the queue. Add to Queue only stages a job — nothing reaches the GPU until this is pressed, so several prompts can be queued and then rendered in one run. Greyed out while the queue is already running, and when nothing is pending.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="▶ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Generate" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="2" Grid.Row="0" Height="40" Width="82"
                                                Command="{Binding CancelCommand}"
                                                Style="{StaticResource DangerButtonStyle}"
                                                FontSize="11">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✕ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- ─── Queue ──────────────────────────────────────────────── -->
                                <Border Grid.Row="4" Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                        Padding="12,8"
                                        Visibility="{Binding HasQueueItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="⚡ Render Queue"
                                                       FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TabAccentBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding QueueStatus}"
                                                       FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="2" Content="▶ Generate"
                                                    Command="{Binding StartQueueCommand}"
                                                    Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    ToolTip="Starts rendering the pending items — the same command as the ▶ Generate button above."/>
                                            <Button Grid.Column="3" Content="🔄 Retry"
                                                    Command="{Binding ReprocessAllFailedCommand}"
                                                    Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    ToolTip="Put every failed item back to Pending and run them again."/>
                                            <Button Grid.Column="4" Content="⏹ Stop"
                                                    Command="{Binding StopQueueCommand}"
                                                    Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    ToolTip="Stop after the current item; it goes back to Pending."/>
                                            <Button Grid.Column="5" Content="🗑️ Clear"
                                                    Command="{Binding ClearQueueCommand}"
                                                    Height="26" Padding="8,0" FontSize="11"
                                                    Style="{StaticResource AccentButtonStyle}"/>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Queue}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                                            Padding="8,5" Margin="0,0,0,3" Background="White">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" CornerRadius="3" Padding="6,2" Margin="0,0,8,0"
                                                                    VerticalAlignment="Center"
                                                                    Background="{Binding StatusColor}">
                                                                <TextBlock Text="{Binding StatusDisplay}" FontSize="10"
                                                                           FontWeight="SemiBold" Foreground="White"/>
                                                            </Border>
                                                            <Image Grid.Column="1" Source="{Binding QueueThumbnail}"
                                                                   Height="34" Stretch="Uniform" Margin="0,0,8,0"/>
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold" FontSize="11"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <!-- PromptPreview is already collapsed to one line: an FL2VA prompt
                                                                     carries its own newlines, and TextTrimming would ellipsize each
                                                                     of them separately while still rendering every line. The whole
                                                                     chain's prompts are on the tooltip. -->
                                                                <TextBlock Text="{Binding PromptPreview}" FontSize="10"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           ToolTipService.ShowDuration="60000"
                                                                           TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis">
                                                                    <TextBlock.ToolTip>
                                                                        <ToolTip MaxWidth="700">
                                                                            <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" FontSize="11"/>
                                                                        </ToolTip>
                                                                    </TextBlock.ToolTip>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding ErrorMessage}" FontSize="10"
                                                                           Foreground="{StaticResource DangerBrush}"
                                                                           TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="3" Content="✕"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Command="{Binding DataContext.RemoveQueueItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    VerticalAlignment="Center"
                                                                    Width="26" Height="26" Padding="0" FontSize="10"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- ─── Result Output ──────────────────────────────────────── -->
                                <Border Grid.Row="5" Background="White" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,1,0,0" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="🎥 Result Video" FontWeight="Bold" FontSize="13"
                                                   Foreground="{DynamicResource TabAccentBrush}" Margin="0,0,0,8"/>

                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource PlayerSurfaceBrush}"
                                                Height="200" CornerRadius="6" Margin="0,0,0,8">
                                            <Grid>
                                                <TextBlock Text="Video will appear here after generation"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{StaticResource PlayerTextBrush}" FontStyle="Italic">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasResult}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <MediaElement x:Name="MiniMaxFflfVideoPlayer"
                                                              Source="{Binding ResultVideoPath}"
                                                              LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                              Stretch="Uniform"
                                                              Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Button Content="▶ Play" Style="{StaticResource PrimaryButtonStyle}"
                                                    Command="{Binding PlayVideoCommand}"
                                                    IsEnabled="{Binding HasResult}" Margin="0,0,8,0"/>
                                            <Button Content="📁 Open Folder" Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding OpenResultFolderCommand}"
                                                    IsEnabled="{Binding HasResult}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ResultVideoInfo}"
                                                   FontStyle="Italic" Foreground="#666" FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <!-- ─── Log ───────────────────────────────────────────────── -->
                                <ctrl:ProcessingLogPanel Grid.Row="6" LogText="{Binding LogOutput}" MaxLogHeight="130"/>

                            </Grid>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- ════════════════════════════════════════════════════════════════ -->
                    <!-- Tab: MiniMax Character (2 character refs + scene image → video)   -->
                    <!-- ════════════════════════════════════════════════════════════════ -->
                    <TabItem Header="🎭👥 MiniMax Character">
                        <Grid DataContext="{Binding MiniMaxCharacterVM}" Style="{StaticResource TabPageStyle}">
                            <Grid.Resources>
                                <SolidColorBrush x:Key="TabAccentBrush" Color="{StaticResource AccentVioletColor}"/>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ═══ LEFT PANEL ═══════════════════════════════════════════════ -->
                            <Border Grid.Column="0" Style="{StaticResource TabSideRailStyle}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="12">

                                        <!-- Character references -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="CHARACTERS" Note="  · reference frames sent to H3" Margin="0,0,0,10"/>

                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Character 1 -->
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Character 1 · &lt;Picture 1&gt;" FontSize="10"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                                                Background="{StaticResource SurfaceAltBrush}" Height="112" Margin="0,0,0,6">
                                                            <Grid>
                                                                <TextBlock Text="Required"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextMutedBrush}" FontSize="10">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Character1Preview}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <Image Source="{Binding Character1Preview}" Stretch="Uniform"/>
                                                            </Grid>
                                                        </Border>
                                                        <Button Content="Browse…" Command="{Binding SelectCharacter1Command}"
                                                                Height="26" Padding="8,0" FontSize="11"
                                                                Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                        <TextBlock Text="{Binding Character1Info}" FontSize="9" Margin="0,4,0,0"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <!-- Character 2 -->
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Character 2 · &lt;Picture 2&gt;" FontSize="10"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                                                Background="{StaticResource SurfaceAltBrush}" Height="112" Margin="0,0,0,6">
                                                            <Grid>
                                                                <TextBlock Text="Optional"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextMutedBrush}" FontSize="10">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Character2Preview}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <Image Source="{Binding Character2Preview}" Stretch="Uniform"/>
                                                            </Grid>
                                                        </Border>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button Grid.Column="0" Content="Browse…" Command="{Binding SelectCharacter2Command}"
                                                                    Height="26" Padding="8,0" FontSize="11" Margin="0,0,4,0"
                                                                    Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                            <Button Grid.Column="1" Content="✕" Command="{Binding ClearCharacter2Command}"
                                                                    IsEnabled="{Binding HasCharacter2}"
                                                                    Height="26" Width="26" FontSize="11"
                                                                    ToolTip="Clear the second character and run as a single-reference scene."
                                                                    Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Character2Info}" FontSize="9" Margin="0,4,0,0"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="{Binding CharacterSummary}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Scene image -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="SCENE IMAGE" Note="  · analyzed into the prompt only" Margin="0,0,0,10"/>

                                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                                        Background="{StaticResource SurfaceAltBrush}" Height="130" Margin="0,0,0,8">
                                                    <Grid>
                                                        <TextBlock Text="No scene image selected"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SceneImagePreview}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Image Source="{Binding SceneImagePreview}" Stretch="Uniform"/>
                                                    </Grid>
                                                </Border>

                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding SceneImageInfo}"
                                                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <Button Grid.Column="1" Content="Browse…"
                                                            Command="{Binding SelectSceneImageCommand}"
                                                            Height="28" Padding="10,0" FontSize="11"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                </Grid>

                                                <TextBlock Text="This image is never uploaded to ComfyUI — only the llama-server sees it. It sets the setting, lighting and art style the characters act in, and it is also where their clothing comes from: Analyze dresses the cast in what this image shows, not in what their character images are wearing."
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                                                <!-- Story guidance + total video duration.
                                                     H3 caps out at ~15s, so a longer target is written as a
                                                     chain of clips and queued one job per clip. -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="118"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Story (optional)" FontSize="10"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                        <TextBox Text="{Binding StoryGuidance, UpdateSourceTrigger=PropertyChanged}"
                                                                 TextWrapping="Wrap" AcceptsReturn="True"
                                                                 Height="86" VerticalScrollBarVisibility="Auto"
                                                                 BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                                 FontSize="11" Padding="6"
                                                                 ToolTip="What the video is about, from beginning to end. Left empty, Analyze invents a story that suits the scene image; filled, every clip is written against this."/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Video duration" FontSize="10"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                        <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                                BorderThickness="1" CornerRadius="4" Padding="0,5" Margin="0,0,0,6">
                                                            <TextBlock Text="{Binding StoryDurationSeconds, StringFormat={}{0:0} s}"
                                                                       HorizontalAlignment="Center" FontFamily="Consolas"
                                                                       FontSize="14" FontWeight="Bold"
                                                                       Foreground="{DynamicResource TabAccentBrush}"/>
                                                        </Border>
                                                        <Slider Value="{Binding StoryDurationSeconds}"
                                                                Minimum="5" Maximum="120"
                                                                TickFrequency="5" IsSnapToTickEnabled="True"
                                                                SmallChange="5" LargeChange="15"
                                                                Foreground="{DynamicResource TabAccentBrush}"
                                                                ToolTip="Length of the finished video, in 5-second steps up to 2 minutes. MiniMax H3 renders at most ~15s per pass, so anything longer is written as a chain of clips and queued one job per clip."/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="{Binding StorySummary}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                                                <!-- The medium the writer works in. Left on Auto it picks, and it
                                                     used to pick gacha anime almost every time whatever the story was. -->
                                                <TextBlock Text="Visual style" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding VisualStyleOptions}"
                                                          DisplayMemberPath="Name"
                                                          SelectedItem="{Binding VisualStyle, Mode=TwoWay}"
                                                          Height="30" FontSize="11" Margin="0,0,0,4"
                                                          ToolTip="The medium every clip is written in. The style words open [Shot 1], which is the only place MiniMax H3 reads the look of the video from &#x2014; so the choice here is handed to the prompt writer as settled fact and copied verbatim into every clip of a chain, exactly the way the wardrobe is.&#x0a;&#x0a;Auto leaves it to the writer, which is what this tab did before: it reads the medium off the scene image."/>
                                                <TextBlock Text="{Binding VisualStyleSummary}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="🔍 Analyze → Scene Prompt"
                                                            Command="{Binding AnalyzeCommand}"
                                                            IsEnabled="{Binding CanAnalyze}"
                                                            Height="32" Padding="14,0" FontSize="11"
                                                            Style="{StaticResource AccentButtonStyle}"
                                                            ToolTip="Sends the scene image, the story box and whatever is in the prompt box as a draft idea to the llama-server with texttovideoH3.md, and writes a dense multi-shot H3 prompt in which the characters are referred to as &lt;Picture 1&gt; / &lt;Picture 2&gt; and are dressed in the outfits read off the scene image (their own images supply the face, hair and build only). Past one clip's worth of duration it writes the whole chain in one reply — one complete prompt per clip, split by &quot;=== CLIP n of N ===&quot; headers."/>
                                                    <TextBlock FontStyle="Italic" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"
                                                               Text="Analyzing…" Foreground="{DynamicResource TabAccentBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAnalyzing}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Prompt -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="H3 PROMPT" Note="  · draft idea, or the full prompt"/>
                                                <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                                                         TextWrapping="Wrap" AcceptsReturn="True"
                                                         Height="240" VerticalScrollBarVisibility="Auto"
                                                         BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                         FontSize="11" Padding="8"/>

                                                <!-- What Generate will actually queue: the chain is split on
                                                     its headers, so hand-edits here are honoured. -->
                                                <TextBlock Text="{Binding PromptClipSummary}"
                                                           Visibility="{Binding HasPromptSequence, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                           FontSize="10" FontWeight="SemiBold" Margin="0,6,0,0"
                                                           Foreground="{DynamicResource TabAccentBrush}" TextWrapping="Wrap"/>

                                                <!-- Scene library: analyzed prompts are filed automatically;
                                                     this row is how they come back out. -->
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0"
                                                            Content="{Binding SceneLibraryLabel}"
                                                            Command="{Binding OpenSceneLibraryCommand}"
                                                            Height="28" Padding="10,0" FontSize="11" Margin="0,0,6,0"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            ToolTip="Browse the scenes this tab has saved and drop one into the prompt box. Handy for reusing a scene with a different pair of characters."/>
                                                    <Button Grid.Column="1" Content="💾 Save"
                                                            Command="{Binding SaveSceneCommand}"
                                                            Height="28" Width="76" FontSize="11"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            ToolTip="File the prompt box's current contents in the scene library. Analyzed and generated prompts are saved automatically — this is for hand-edited ones."/>
                                                </Grid>

                                                <TextBlock Text="The reference line is rewritten automatically to match how many character images are loaded."
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic" Margin="0,6,0,0"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Settings -->
                                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="14">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="SETTINGS" Margin="0,0,0,10"/>

                                                <TextBlock Text="Aspect ratio" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding AspectRatioOptions}"
                                                          SelectedItem="{Binding SelectedAspectRatio}"
                                                          Height="30" FontSize="11" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding ResolvedAspectRatio, StringFormat=→ {0}}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic" Margin="0,0,0,10"/>

                                                <TextBlock Text="Quality (canvas size)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding MegapixelOptions}"
                                                          DisplayMemberPath="Label"
                                                          SelectedValuePath="Value"
                                                          SelectedValue="{Binding Megapixels}"
                                                          Height="30" FontSize="11" Margin="0,0,0,10"/>

                                                <TextBlock Text="Refinement pass" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <TextBlock Text="RTX Video Super Resolution ×2 (ULTRA)"
                                                           FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"
                                                           ToolTip="Fixed. The H3 frames are upscaled ×2 on the way to the file — no second diffusion model, so it costs seconds rather than a second render. It replaced the old Wan 2.2 / LTX 2.3 branches, which are pruned out of the graph."/>
                                                <TextBlock Text="{Binding UpscaleSummary}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                                                <TextBlock Text="Clip length (seconds · 4–15)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <Slider Value="{Binding LengthSeconds}"
                                                        Minimum="4" Maximum="15"
                                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                                        Foreground="{DynamicResource TabAccentBrush}" Margin="0,0,0,2"
                                                        ToolTip="How long a single H3 pass is — the model's own limit. The Video duration slider divides by this to decide how many clips the story is split into."/>
                                                <TextBlock Text="{Binding LengthSummary}"
                                                           FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,0,0,2"/>
                                                <TextBlock Text="{Binding StorySummary}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                                                <TextBlock Text="Seed (-1 = random)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0"
                                                             Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}"
                                                             Height="30" Padding="6,0" VerticalContentAlignment="Center"
                                                             BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                             FontSize="12" FontFamily="Consolas" Margin="0,0,6,0"/>
                                                    <Button Grid.Column="1" Content="🎲"
                                                            Command="{Binding RandomSeedCommand}"
                                                            Height="30" Width="36" FontSize="14"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- ═══ RIGHT PANEL ══════════════════════════════════════════════ -->
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="240"/>  <!-- Cast strip -->
                                    <RowDefinition Height="3"/>    <!-- Progress bar -->
                                    <RowDefinition Height="Auto"/> <!-- Status row -->
                                    <RowDefinition Height="Auto"/> <!-- Action buttons -->
                                    <RowDefinition Height="Auto"/> <!-- Queue -->
                                    <RowDefinition Height="Auto"/> <!-- Result output -->
                                    <RowDefinition Height="Auto"/> <!-- Log -->
                                </Grid.RowDefinitions>

                                <!-- ─── Cast strip: the two references and the scene ─────────── -->
                                <Border Grid.Row="0" Background="{StaticResource PlayerSurfaceBrush}">
                                    <Grid>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasCharacter1}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Border Width="64" Height="64" CornerRadius="14" Background="{StaticResource PlayerSurfaceRaisedBrush}"
                                                    BorderBrush="{StaticResource TextSecondaryBrush}" BorderThickness="1"
                                                    HorizontalAlignment="Center" Margin="0,0,0,10">
                                                <TextBlock Text="🎭" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="MiniMax H3 · Character Reference" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PlayerTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="Load 1–2 character images + a scene image → Analyze → Generate"
                                                       FontSize="11" Foreground="{StaticResource PlayerTextBrush}" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <Grid Visibility="{Binding HasCharacter1, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              Margin="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <Image Source="{Binding Character1Preview}" Stretch="Uniform" Height="176"/>
                                                <TextBlock Text="Character 1 · &lt;Picture 1&gt;" HorizontalAlignment="Center" Margin="0,6,0,0"
                                                           FontSize="10" Foreground="{StaticResource PlayerTextBrush}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="6,0"
                                                        Visibility="{Binding HasCharacter2, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Image Source="{Binding Character2Preview}" Stretch="Uniform" Height="176"/>
                                                <TextBlock Text="Character 2 · &lt;Picture 2&gt;" HorizontalAlignment="Center" Margin="0,6,0,0"
                                                           FontSize="10" Foreground="{StaticResource PlayerTextBrush}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Margin="6,0,0,0"
                                                        Visibility="{Binding HasSceneImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Image Source="{Binding SceneImagePreview}" Stretch="Uniform" Height="176"/>
                                                <TextBlock Text="Scene · prompt only" HorizontalAlignment="Center" Margin="0,6,0,0"
                                                           FontSize="10" Foreground="{StaticResource PlayerTextBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- ─── Progress bar ──────────────────────────────────────── -->
                                <ProgressBar Grid.Row="1"
                                             Value="{Binding ProcessingProgress, Mode=OneWay}"
                                             Foreground="{DynamicResource TabAccentBrush}" BorderThickness="0"
                                             Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <!-- ─── Status row ────────────────────────────────────────── -->
                                <Border Grid.Row="2" Style="{StaticResource ToolStripStyle}"
                                        BorderThickness="0,1,0,0" Padding="12,5">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,7,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource TextPrimaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource TabAccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding ProcessingStatus}"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Text="{Binding ProgressPercentage, Mode=OneWay}"
                                                   FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TabAccentBrush}"
                                                   FontFamily="Consolas"
                                                   Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>

                                <!-- ─── Action Buttons ────────────────────────────────────── -->
                                <Border Grid.Row="3" Style="{StaticResource ToolStripStyle}"
                                        BorderThickness="0,1,0,0" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Margin="0,0,8,0" Height="40"
                                                Command="{Binding GenerateCommand}"
                                                IsEnabled="{Binding CanGenerate}"
                                                Style="{StaticResource AccentOutlineButtonStyle}"
                                                FontSize="12" FontWeight="Bold"
                                                ToolTip="Snapshots the characters, prompt and settings into the queue. Nothing renders until ▶ Generate is pressed. A multi-clip story is split on its &quot;=== CLIP n of N ===&quot; headers and queued as one job per clip, rendered in order. The tab stays free — load the next scene image and Analyze it while this one runs.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚡ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Add to Queue" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="1" Height="40" Width="118" Margin="0,0,8,0"
                                                Command="{Binding StartQueueCommand}"
                                                Style="{StaticResource AccentButtonStyle}"
                                                FontSize="12" FontWeight="Bold"
                                                ToolTip="Starts rendering everything pending in the queue. Add to Queue only stages a job — nothing reaches the GPU until this is pressed, so several prompts can be queued and then rendered in one run. Greyed out while the queue is already running, and when nothing is pending.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="▶ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Generate" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- A story queued in this session joins itself when its last clip
                                             lands; this is for clips already sitting on disk. -->
                                        <Button Grid.Column="2" Height="40" Width="92" Margin="0,0,8,0"
                                                Command="{Binding JoinClipsCommand}"
                                                Style="{StaticResource AccentButtonStyle}"
                                                FontSize="11"
                                                ToolTip="Joins clips that are already on disk — for stories rendered in an earlier session, which the queue no longer knows about. Pick any ONE clip of a story and its siblings are collected automatically, in clip order; pick several files and exactly those are joined, in file-name order. Never overwrites an existing joined file.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔗 " VerticalAlignment="Center"/>
                                                <TextBlock Text="Join" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="3" Height="40" Width="82"
                                                Command="{Binding CancelCommand}"
                                                IsEnabled="{Binding IsProcessingQueue}"
                                                Style="{StaticResource DangerButtonStyle}"
                                                FontSize="11"
                                                ToolTip="Stops the queue after cancelling the item currently on the GPU. Pending items stay queued.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✕ " VerticalAlignment="Center"/>
                                                <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- ─── Queue ─────────────────────────────────────────────────
                                     Each row is a frozen snapshot of the whole form, so new scene
                                     images can be loaded and analyzed while earlier jobs render. -->
                                <Border Grid.Row="4" Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8"
                                        Visibility="{Binding HasQueueItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="🎭 Character Queue"
                                                       FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TabAccentBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding QueueStatus}"
                                                       FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="2" Content="▶ Generate"
                                                    Command="{Binding StartQueueCommand}"
                                                    Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    ToolTip="Starts rendering the pending items — the same command as the ▶ Generate button above."/>
                                            <Button Grid.Column="3" Content="🔄 Retry"
                                                    Command="{Binding ReprocessAllFailedCommand}"
                                                    Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    ToolTip="Put every failed item back to Pending and run them again."/>
                                            <Button Grid.Column="4" Content="⏹ Stop"
                                                    Command="{Binding StopQueueCommand}"
                                                    Height="26" Padding="8,0" FontSize="11" Margin="0,0,5,0"
                                                    Style="{StaticResource AccentButtonStyle}"/>
                                            <Button Grid.Column="5" Content="🗑️ Clear"
                                                    Command="{Binding ClearQueueCommand}"
                                                    Height="26" Padding="8,0" FontSize="11"
                                                    Style="{StaticResource AccentButtonStyle}"/>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Queue}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                                            Padding="8,5" Margin="0,0,0,3" Background="White">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" CornerRadius="3" Padding="6,2" Margin="0,0,8,0"
                                                                    VerticalAlignment="Center"
                                                                    Background="{Binding StatusColor}">
                                                                <TextBlock Text="{Binding StatusDisplay}" FontSize="10"
                                                                           FontWeight="SemiBold" Foreground="White"/>
                                                            </Border>
                                                            <Image Grid.Column="1" Source="{Binding QueueThumbnail}"
                                                                   Height="34" Stretch="Uniform" Margin="0,0,8,0"/>
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold" FontSize="11"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Prompt}" FontSize="10"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding ErrorMessage}" FontSize="10"
                                                                           Foreground="{StaticResource DangerBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="3" Content="✕"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Command="{Binding DataContext.RemoveQueueItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    VerticalAlignment="Center"
                                                                    Width="26" Height="26" Padding="0" FontSize="10"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- ─── Result Output ──────────────────────────────────────── -->
                                <Border Grid.Row="5" Background="White" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,1,0,0" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="🎥 Result Video" FontWeight="Bold" FontSize="13"
                                                   Foreground="{DynamicResource TabAccentBrush}" Margin="0,0,0,8"/>

                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource PlayerSurfaceBrush}"
                                                Height="200" CornerRadius="6" Margin="0,0,0,8">
                                            <Grid>
                                                <TextBlock Text="Video will appear here after generation"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{StaticResource PlayerTextBrush}" FontStyle="Italic">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasResult}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <MediaElement x:Name="MiniMaxCharacterVideoPlayer"
                                                              Source="{Binding ResultVideoPath}"
                                                              LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                              Stretch="Uniform"
                                                              Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Button Content="▶ Play" Style="{StaticResource PrimaryButtonStyle}"
                                                    Command="{Binding PlayVideoCommand}"
                                                    IsEnabled="{Binding HasResult}" Margin="0,0,8,0"/>
                                            <Button Content="📁 Open Folder" Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding OpenResultFolderCommand}"
                                                    IsEnabled="{Binding HasResult}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ResultVideoInfo}"
                                                   FontStyle="Italic" Foreground="#666" FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <!-- ─── Log ───────────────────────────────────────────────── -->
                                <ctrl:ProcessingLogPanel Grid.Row="6" LogText="{Binding LogOutput}" MaxLogHeight="130"/>

                            </Grid>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- ═══════════════════════════════════════════════════════════════
                         H3 DUO — the H3 Cast flow on the MiniMax I2V turbo
                         pipeline. Everything the 🪪👥 H3 Cast tab does — story →
                         locked wardrobe → two characters' sheets (photo in, ✨
                         generate, panel split) → chain of clip prompts → queue →
                         FFmpeg join — but each clip renders through the graph the
                         🌀 MiniMax I2V tab runs: a 4-step draft at a quarter of
                         the canvas, a 2× pass through the MiniMax H3 3D latent
                         upscaler, then 3 fixed-sigma steps at the finished size.

                         Quicker and sharper than the Cast tab's own graph; the
                         trade is there is no face-refine pass here — identity is
                         held by the references themselves, encoded at a 2048px
                         short edge by default (the checkbox in Settings).
                         ═══════════════════════════════════════════════════════════════ -->
                    <TabItem Header="🪪🌀 H3 Duo">
                        <!-- Named so the per-character cards, whose DataContext is a CharacterSlot, can
                             still reach the tab's own commands. -->
                        <Grid x:Name="H3DuoRoot" DataContext="{Binding H3DuoVM}" Style="{StaticResource TabPageStyle}">
                            <Grid.Resources>
                                <SolidColorBrush x:Key="TabAccentBrush" Color="{StaticResource AccentAmberColor}"/>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ═══ LEFT PANEL ═══════════════════════════════════════════════ -->
                            <Border Grid.Column="0" Style="{StaticResource TabSideRailStyle}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="12">

                                        <!-- Scene & story: two ways in, either one is enough.
                                             The image (never uploaded) carries setting, light and
                                             wardrobe; the story carries what happens. With no image
                                             the request goes to the llama-server as plain text. -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="SCENE &amp; STORY" Note="  · either one is enough — and the wardrobe comes from it" Margin="0,0,0,10"/>

                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="124"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Scene image -->
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Scene image" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                                                Background="{StaticResource SurfaceAltBrush}" Height="126" Margin="0,0,0,6">
                                                            <Grid>
                                                                <TextBlock Text="Optional"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextMutedBrush}" FontSize="10">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding SceneImagePreview}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <Image Source="{Binding SceneImagePreview}" Stretch="Uniform"/>
                                                            </Grid>
                                                        </Border>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button Grid.Column="0" Content="Browse…"
                                                                    Command="{Binding SelectSceneImageCommand}"
                                                                    Height="26" Padding="6,0" FontSize="11" Margin="0,0,4,0"
                                                                    Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                            <Button Grid.Column="1" Content="✕"
                                                                    Command="{Binding ClearSceneImageCommand}"
                                                                    IsEnabled="{Binding HasSceneImage}"
                                                                    Height="26" Width="26" FontSize="11"
                                                                    ToolTip="Drop the scene image and work from the story alone."
                                                                    Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding SceneImageInfo}" FontSize="9" Margin="0,4,0,0"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <!-- Story text -->
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Story" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                        <TextBox Text="{Binding StoryText, UpdateSourceTrigger=PropertyChanged}"
                                                                 TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="False"
                                                                 Height="126" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6"
                                                                 BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                                 FontSize="11" Padding="6"
                                                                 ToolTip="Type or paste the story the video tells. With a scene image it says what happens in it; on its own it is the whole brief — Analyze then works from the text alone and writes the setting, lighting and wardrobe out of the prose, casting &lt;Picture 1&gt; and &lt;Picture 2&gt; in the story's roles."/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button Grid.Column="0" Content="📄 Load .txt"
                                                                    Command="{Binding LoadStoryCommand}"
                                                                    Height="26" Padding="6,0" FontSize="11" Margin="0,0,4,0"
                                                                    Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                                    ToolTip="Read a story out of a .txt or .md file into the box."/>
                                                            <Button Grid.Column="1" Content="✕"
                                                                    Command="{Binding ClearStoryCommand}"
                                                                    Height="26" Width="26" FontSize="11"
                                                                    ToolTip="Empty the story box."
                                                                    Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="{Binding StorySourceSummary}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                                                <!-- Wardrobe. Decided once and written into every clip's
                                                     prompt verbatim: the clips are generated separately from
                                                     text written block by block, so an outfit left to the
                                                     prose is re-invented every few clips. -->
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Wardrobe — derived from the story"
                                                               FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <Button Grid.Column="1" Content="{Binding WardrobeLockButtonText}"
                                                            Command="{Binding ToggleWardrobeLockCommand}"
                                                            Height="24" Padding="8,0" FontSize="10" Margin="0,0,4,0"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            ToolTip="Locked, the wardrobe is the story's: it is rewritten whenever the story, the scene image or the cast changes, and cannot be typed over.&#x0a;&#x0a;Unlock to dress the cast yourself — your text then stands, and the story stops rewriting it until you lock it again."/>
                                                    <Button Grid.Column="2" Content="🎽 Derive"
                                                            Command="{Binding DeriveWardrobeCommand}"
                                                            Height="24" Padding="8,0" FontSize="10" Margin="0,0,4,0"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            ToolTip="Re-rolls the outfits now, without waiting for the story to change — off the scene image if there is one, otherwise out of the story.&#x0a;&#x0a;It always writes an outfit for BOTH characters, whether or not their photos have been picked yet: the wardrobe is a decision about the story, and a second character's line is simply left out of any clip they are not in. The sheets are built from whatever is in this box, so derive before you build them."/>
                                                    <Button Grid.Column="3" Content="✕"
                                                            Command="{Binding ClearWardrobeCommand}"
                                                            Height="24" Width="24" FontSize="10"
                                                            ToolTip="Empty the wardrobe box and let the story write a fresh one."
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                </Grid>
                                                <TextBox Text="{Binding CastWardrobe, UpdateSourceTrigger=PropertyChanged}"
                                                         IsReadOnly="{Binding IsWardrobeLocked}"
                                                         TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="False"
                                                         Height="64" VerticalScrollBarVisibility="Auto" Margin="0,0,0,4"
                                                         BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                         FontSize="11" Padding="6"
                                                         ToolTip="One line per character, naming every garment. It is written from the story a couple of seconds after you stop typing, and it is what the character sheets are generated in AND what every clip's prompt quotes — the picture and the words then agree, which is what stops the cast changing outfits between clips.&#x0a;&#x0a;Read-only while locked; press 🔒 to take it over."/>
                                                <TextBlock Text="{Binding WardrobeSummary}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                                                <!-- Total video length. H3 tops out at ~15s per pass, so
                                                     anything longer is written as a chain of clips and
                                                     queued one job per clip, same sheets throughout. -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Video length" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            CornerRadius="4" Padding="10,2">
                                                        <TextBlock Text="{Binding StoryDurationSeconds, StringFormat={}{0:0} s}"
                                                                   FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TabAccentBrush}"/>
                                                    </Border>
                                                </Grid>
                                                <Slider Value="{Binding StoryDurationSeconds}"
                                                        Minimum="5" Maximum="120"
                                                        TickFrequency="5" IsSnapToTickEnabled="True"
                                                        SmallChange="5" LargeChange="15"
                                                        Foreground="{DynamicResource TabAccentBrush}" Margin="0,0,0,4"
                                                        ToolTip="Length of the finished video, in 5-second steps up to 2 minutes. MiniMax H3 renders at most ~15s per pass, so anything longer is written as a chain of consecutive clips — Analyze writes them all in one reply, Add to Queue enqueues one job per clip against the same character sheets, and they are joined into a single file when the last one lands."/>
                                                <TextBlock Text="{Binding ClipPlanSummary}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                                                <!-- The medium the writer works in. Left on Auto it
                                                     picks, and it used to pick gacha anime almost every
                                                     time whatever the story was. -->
                                                <TextBlock Text="Visual style" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding VisualStyleOptions}"
                                                          DisplayMemberPath="Name"
                                                          SelectedItem="{Binding VisualStyle, Mode=TwoWay}"
                                                          Height="30" FontSize="11" Margin="0,0,0,4"
                                                          ToolTip="The medium every clip is written in. The style words open [Shot 1], which is the only place MiniMax H3 reads the look of the video from &#x2014; so the choice here is handed to the prompt writer as settled fact and copied verbatim into every clip of a chain, exactly the way the wardrobe is.&#x0a;&#x0a;Auto leaves it to the writer, which is what this tab did before: it reads the medium off the scene image where there is one and off the story where there is not."/>
                                                <TextBlock Text="{Binding VisualStyleSummary}"
                                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="🔍 Analyze → H3 Prompt"
                                                            Command="{Binding AnalyzeCommand}"
                                                            IsEnabled="{Binding CanAnalyze}"
                                                            Height="32" Padding="14,0" FontSize="11"
                                                            Style="{StaticResource AccentButtonStyle}"
                                                            ToolTip="Sends whatever is loaded — the scene image, the story, or both — to the llama-server with texttovideoH3.md and writes a dense multi-shot H3 prompt in which the cast is named only as &lt;Picture 1&gt; / &lt;Picture 2&gt; and framed so faces stay readable. The locked wardrobe above is handed to it as settled fact, so no clip picks its own outfit."/>
                                                    <TextBlock FontStyle="Italic" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"
                                                               Text="{Binding AnalyzeBusyText}" Foreground="{DynamicResource TabAccentBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAnalyzing}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Cast: photo in, sheet out -->
                                        <Border Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <ctrl:SectionHeader Title="CAST" Note="  · one photo per character, dressed from the wardrobe above" Margin="0,0,0,10"/>

                                                <!-- Character 1 -->
                                                <StackPanel DataContext="{Binding Character1}" Margin="0,0,0,10">
                                                    <!-- The sex is a real input, not a label: it goes into the
                                                         wardrobe request, into the sheet builder's instruction
                                                         and into the reference line H3 reads. -->
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11" FontWeight="Bold"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        <ComboBox Grid.Column="1" ItemsSource="{Binding SexOptions}"
                                                                  SelectedItem="{Binding Sex, Mode=TwoWay}"
                                                                  Width="86" Height="24" FontSize="10"
                                                                  ToolTip="Male or female. The wardrobe pass dresses this character accordingly, the character sheet is generated as that person, and the prompt names them so H3 uses the right pronouns."/>
                                                    </Grid>
                                                    <!-- Part — who this character is in the story. Filled by the story's
                                                         automatic cast; see H3CastViewModel.Cast.cs. -->
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Part" FontSize="10" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                                                        <TextBox Grid.Column="1"
                                                                 Text="{Binding Role, UpdateSourceTrigger=LostFocus}"
                                                                 Height="24" FontSize="10" Padding="5,0"
                                                                 VerticalContentAlignment="Center"
                                                                 BorderBrush="{StaticResource BorderBrush}" Background="White"
                                                                 ToolTip="Who this character is in the story — &quot;the detective&quot;, &quot;her younger brother&quot;. A pasted or loaded story fills this in automatically; edit it freely — the tab never overwrites a card you have made your own. It reaches the wardrobe pass and the ✨ Generate button, so the photo and the outfit match the part."/>
                                                    </Grid>
                                                    <TextBlock Text="&lt;Picture 1&gt; · the first reference H3 receives"
                                                               FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="98"/>
                                                            <ColumnDefinition Width="6"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Source photo -->
                                                        <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                                CornerRadius="6" Background="{StaticResource SurfaceAltBrush}" Height="92"
                                                                Style="{StaticResource CastThumbnailStyle}" Tag="{Binding SourcePath}">
                                                            <Grid>
                                                                <TextBlock Text="Photo"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextMutedBrush}" FontSize="10">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding SourcePreview}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <Image Source="{Binding SourcePreview}" Stretch="Uniform"/>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Built sheet -->
                                                        <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                                CornerRadius="6" Background="{StaticResource SurfaceAltBrush}" Height="92"
                                                                Style="{StaticResource CastThumbnailStyle}" Tag="{Binding SheetPath}">
                                                            <Grid>
                                                                <TextBlock Text="Sheet → H3"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextMutedBrush}" FontSize="10">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding SheetPreview}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <Image Source="{Binding SheetPreview}" Stretch="Uniform"/>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>

                                                    <Button Content="Browse…"
                                                            Command="{Binding DataContext.SelectCharacter1Command, ElementName=H3DuoRoot}"
                                                            Height="26" Padding="8,0" FontSize="11" Margin="0,6,0,0"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                    <!-- ✨ Generate — this character's photo, rendered by one of the Image
                                                         Generator's base workflows instead of browsed for. -->
                                                    <Button Content="✨ Generate photo ▾" Margin="0,4,0,0"
                                                            Click="CastGenerateButton_Click"
                                                            Tag="{Binding DataContext, ElementName=H3DuoRoot}"
                                                            IsEnabled="{Binding CanGeneratePhoto}"
                                                            Height="26" Padding="8,0" FontSize="11"
                                                            Background="{StaticResource SurfaceAltBrush}" Foreground="{DynamicResource TabAccentBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            ToolTip="Generates this character's photo instead of browsing for one — their Part and the locked wardrobe become the prompt, and the result lands in this card as if it had been browsed. Z-Image, Z-Famegrid and Krea2 open into a LoRA list (the same folders the Image Generator reads); Krea2-Spicy's and Qwen 2.5.1.2's LoRAs are baked into their workflows.&#x0a;&#x0a;Needs the character to be described first: a Part on the card, or the story's automatic cast. The character sheet is not built until you press 🪪 Build Character Sheet, so you can re-generate or swap photos first.">
                                                        <!-- Tag carries the tab's ViewModel across the ContextMenu boundary;
                                                             the card's DataContext is the CharacterSlot each command takes. -->
                                                        <Button.ContextMenu>
